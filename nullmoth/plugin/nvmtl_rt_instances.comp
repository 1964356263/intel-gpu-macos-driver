#version 460
// Metal instance descriptors -> VkAccelerationStructureInstanceKHR, on the GPU (nvmtl_vk_cmd_convert_instances).
// Recorded in the command buffer right before the instance acceleration structure build, so it reads the Metal
// descriptors when the build runs (private, managed, shared or GPU-written buffers alike) and, with a count address,
// the instance count Metal's indirect instance descriptor keeps in a buffer.
//   glslangValidator -V --target-env vulkan1.2 nvmtl_rt_instances.comp -o nvmtl_rt_instances.spv
// Per instance i < max_count:
//   i >= count (count read from count_addr when set, clamped to max_count): an inactive instance (all zero: reference 0
//   and mask 0, both inactive in Vulkan) and user ID 0.
//   else, as nvmtl_vk_convert_instances on the CPU (rtopt1), word for word:
//     transform: Metal MTLPackedFloat4x3 (4 columns of 3 floats, column-major) -> Vulkan 3x4 row-major; flags bit 0
//                (MTLMatrixLayoutRowMajor) means the 12 floats already are 3 rows of 4
//     custom index = user ID & 0xFFFFFF, mask & 0xFF, flags = options & 0xF
//     SBT offset = intersection function table offset + the instanced structure's base (table word 2, bit 23 kept as
//                  the per-geometry marker); past 0x7FFFFF the offset alone
//     reference = table[accelerationStructureIndex] (0 past n_as), or the 64-bit MTLResourceID of the Indirect type
//                 (rtopt4: the Metal structure's address, its header; the Vulkan structure is NVMTL_AS_HEADER after it;
//                 rtopt5: + wrap, the bottom-level structure after its one-instance top-level wrapper)
//   rtopt4: rec (16 B per instance, nvmtl_inst_rec): the instanced structure's Metal address, the 32-bit user ID and
//           the instance's intersection function table offset (all 0 for an inactive instance)
// Metal layouts (words): Default 0-11 matrix, 12 options, 13 mask, 14 IFT offset, 15 structure index;
//   UserID: + 16 user ID; Indirect (type 3): 14 IFT offset, 15 user ID, 16-17 structure resource ID.
// table: per accelerationStructureIndex 8 words: Vulkan address low, high, IFT base, 0, Metal address low, high, 0, 0.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer OutWords { uint w[]; };
layout(push_constant) uniform Args {
    uint64_t src;        // first Metal descriptor
    uint64_t dst;        // first VkAccelerationStructureInstanceKHR (64 B each)
    uint64_t uid;        // user ID side table (one word per instance), 0 = none
    uint64_t table;      // instanced structures, 16 B each
    uint64_t count_addr; // uint32 instance count, 0 = max_count
    uint64_t rec;        // instance records (nvmtl_inst_rec, 16 B each), 0 = none
    uint stride;         // bytes between Metal descriptors (multiple of 4)
    uint max_count;
    uint type;           // 0 Default, 1 UserID, 3 Indirect
    uint n_as;
    uint flags;          // bit 0: row-major transforms
    uint wrap;           // rtopt5: NVMTL_AS_WRAP when primitive structures carry their top-level wrapper (0: rtopt4 layout)
} a;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= a.max_count) return;
    uint count = a.max_count;
    if (a.count_addr != 0ul) count = min(Words(a.count_addr).w[0], a.max_count);
    OutWords d = OutWords(a.dst + uint64_t(i) * 64ul);
    if (i >= count) {
        for (uint k = 0u; k < 16u; k++) d.w[k] = 0u;
        if (a.uid != 0ul) OutWords(a.uid).w[i] = 0u;
        if (a.rec != 0ul) { OutWords r = OutWords(a.rec + uint64_t(i) * 16ul); r.w[0] = 0u; r.w[1] = 0u; r.w[2] = 0u; r.w[3] = 0u; }
        return;
    }
    Words s = Words(a.src + uint64_t(i) * uint64_t(a.stride));
    for (uint r = 0u; r < 3u; r++)
        for (uint c = 0u; c < 4u; c++)
            d.w[r * 4u + c] = (a.flags & 1u) != 0u ? s.w[r * 4u + c] : s.w[c * 3u + r];
    const uint options = s.w[12], mask = s.w[13], ift = s.w[14], as_index = s.w[15];
    const uint user = a.type == 1u ? s.w[16] : a.type == 3u ? s.w[15] : 0u;
    uint add = 0u;
    uint lo = 0u, hi = 0u, mlo = 0u, mhi = 0u;
    if (a.type == 3u) {
        mlo = s.w[16]; mhi = s.w[17];
        // NVMTL_AS_HEADER (+ NVMTL_AS_WRAP, rtopt5: the bottom-level structure after the primitive structure's wrapper)
        const uint64_t m = packUint2x32(uvec2(mlo, mhi)), v = m != 0ul ? m + 256ul + uint64_t(a.wrap) : 0ul;
        const uvec2 vv = unpackUint2x32(v); lo = vv.x; hi = vv.y;
    } else if (as_index < a.n_as) {
        Words t = Words(a.table + uint64_t(as_index) * 32ul);
        lo = t.w[0]; hi = t.w[1]; add = t.w[2]; mlo = t.w[4]; mhi = t.w[5];
    }
    uint slot = ift + (add & 0x7FFFFFu);
    if (slot < ift || slot > 0x7FFFFFu) slot = ift & 0x7FFFFFu;   // (slot < ift: the 32-bit sum wrapped)
    d.w[12] = (user & 0xFFFFFFu) | ((mask & 0xFFu) << 24);
    d.w[13] = slot | (add & 0x800000u) | ((options & 0xFu) << 24);
    d.w[14] = lo;
    d.w[15] = hi;
    if (a.uid != 0ul) OutWords(a.uid).w[i] = user;
    if (a.rec != 0ul) {
        OutWords r = OutWords(a.rec + uint64_t(i) * 16ul);
        r.w[0] = (lo | hi) != 0u ? mlo : 0u; r.w[1] = (lo | hi) != 0u ? mhi : 0u; r.w[2] = user; r.w[3] = ift;
    }
}
