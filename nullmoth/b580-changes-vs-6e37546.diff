+thread_local! {
+    static FC_VALUES_UNKNOWN: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Runs `f` with the module's function constants taken as unknown: an `undef` function-constant initializer
+/// (`section "air.fc_initializer"`) is not read as 0, so nothing the static initializer derives from a function
+/// constant is folded into the functions, and the module computes it when it runs. For a translation whose function
+/// constants become specialization constants (nvmtl_translate_fc_spec): folding them as 0 made every variant behave as
+/// the one with all constants 0.
+pub fn with_function_constants_unknown<R>(f: impl FnOnce() -> R) -> R {
+    let was = FC_VALUES_UNKNOWN.with(|c| c.replace(true));
+    let r = f();
+    FC_VALUES_UNKNOWN.with(|c| c.set(was));
+    r
+}
+
+fn fc_values_unknown() -> bool {
+    FC_VALUES_UNKNOWN.with(|c| c.get())
+}
