+static IOReturn nmxNewB580Client(IOService *accel, IOService *pci, task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+    IOService *b = nmxB580();
+    if (!b || (pci && b->getProvider() != pci)) return kIOReturnNotAttached;   // B580 drives another GPU (or none)
+    B580NewClient r = { 1, type, owningTask, securityID, accel, nullptr };
+    IOReturn ret = nmxB580Call("b580NewClient", &r);
+    if (ret != kIOReturnSuccess || !r.client) {
+        NMXLOG("xe client for the B580: B580.kext refused (0x%x)", ret);
+        return ret != kIOReturnSuccess ? ret : kIOReturnNoResources;
+    }
+    *handler = r.client;
+    return kIOReturnSuccess;
+}
