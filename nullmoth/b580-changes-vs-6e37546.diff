@@ -0,0 +1,670 @@
+/*
+ * nvmtl_dbuf.c - the descriptor-buffer model (DESCRIPTOR-MODEL.md, stage 2), included by nvmtl_vk.c.
+ *
+ * NVMTL_DESC_MODEL=buffer on a device with VK_EXT_descriptor_buffer (descriptorBuffer): descriptors are bytes the plugin
+ * writes into GPU-visible memory itself, and a draw or dispatch points each set at them with
+ * vkCmdSetDescriptorBufferOffsetsEXT. No VkDescriptorPool, VkDescriptorSet, vkUpdateDescriptorSets or
+ * vkCmdBindDescriptorSets is used in that mode, by any pipeline: ANV on Xe2 emits a CS stall + STATE_BASE_ADDRESS
+ * whenever a command buffer switches between classic sets and descriptor buffers (genX_cmd_buffer.c, binding modes), so
+ * every layout the plugin creates is a descriptor-buffer layout or has no sets (visibility sum).
+ *
+ *   - Per pipeline and stage, a compact set layout: only the bindings the stage's SPIR-V reads (the masks the classic
+ *     model already computes), with their binding numbers, so the SPIR-V is unchanged. Layouts are shared through a
+ *     cache keyed by the binding set (nvmtl_db_plan).
+ *   - Per command buffer, a ring of descriptor memory (256 KiB pages, kept and reused exactly like the address-table
+ *     pages, witness-guarded). A draw whose stage has new bindings (or a new plan) gets a fresh region for that stage:
+ *     the plan's descriptors are copied from a host-side shadow (one 64-byte descriptor per slot, regenerated with
+ *     vkGetDescriptorEXT only for slots that changed), never read back from the GPU-visible memory.
+ *   - The address table (binding 640) is a plain UNIFORM_BUFFER (or STORAGE_BUFFER) descriptor: descriptor-buffer
+ *     layouts have no dynamic descriptors. A new table is written with every new region of the stage.
+ *   - The bindless heap (set 2) is one process-wide descriptor buffer written by nvmtl_vk_bindless_put/_sampler_slot.
+ *   - Framebuffer fetch (set 3) is a small region per fetch draw.
+ *
+ * Descriptor contents match the classic model's writes (same views, layouts, ranges, null descriptors and dummies), so
+ * images rendered under either model are identical.
+ */
+
+enum { NVMTL_DBT_SSBO, NVMTL_DBT_UBO, NVMTL_DBT_TEX, NVMTL_DBT_TEXBUF, NVMTL_DBT_SAMP, NVMTL_DBT_STEX, NVMTL_DBT_STEXBUF,
+       NVMTL_DBT_INPUT, NVMTL_DBT_N };
+static const VkDescriptorType g_dbt_vk[NVMTL_DBT_N] = {
+    VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE,
+    VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, VK_DESCRIPTOR_TYPE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+    VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER, VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT };
+#define NVMTL_DB_MAXDESC 64u
+static uint32_t g_dbt_size[NVMTL_DBT_N];
+static uint32_t g_db_align = 64;
+static PFN_vkGetDescriptorSetLayoutSizeEXT          pvkGetDescriptorSetLayoutSizeEXT;
+static PFN_vkGetDescriptorSetLayoutBindingOffsetEXT pvkGetDescriptorSetLayoutBindingOffsetEXT;
+static PFN_vkGetDescriptorEXT                       pvkGetDescriptorEXT;
+static PFN_vkCmdBindDescriptorBuffersEXT            pvkCmdBindDescriptorBuffersEXT;
+static PFN_vkCmdSetDescriptorBufferOffsetsEXT       pvkCmdSetDescriptorBufferOffsetsEXT;
+static _Atomic unsigned long long g_db_regions, g_db_reuse, g_db_gen, g_db_pages, g_db_bigpages;
+static void nvmtl_db_census(void);
+
+/* ---- device setup --------------------------------------------------------------------------------------------------- */
+
+/* Before vkCreateDevice: is the buffer model wanted (NVMTL_DESC_MODEL=buffer) and possible? Fills the feature struct to
+   chain into vkCreateDevice. The extension is enabled only then: with it enabled ANV starts every command buffer in
+   descriptor-buffer mode, which classic sets would leave again (an SBA and a stall per command buffer). */
+/* Which model this process asked for, read once when the device is made:
+     NVMTL_DESC_MODEL=buffer | classic        decides, when set
+     /tmp/nvmtl-desc-buffer-<process name>     buffer for that process only (e.g. /tmp/nvmtl-desc-buffer-java)
+     /tmp/nvmtl-desc-buffer                    buffer for every process that starts while it exists, except WindowServer
+                                               (which needs its own named file)
+   The files follow the other diagnostic flags (nvmtl_diag_flag: a regular file owned by root or this user, never a
+   symlink). A process keeps its model for its lifetime. */
+static int nvmtl_db_wanted(const char **why)
+{
+    const char *e = getenv("NVMTL_DESC_MODEL");
+    if (e && *e) { *why = !strcmp(e, "buffer") ? "NVMTL_DESC_MODEL=buffer" : "NVMTL_DESC_MODEL"; return !strcmp(e, "buffer"); }
+    static char name[96];
+    snprintf(name, sizeof name, "desc-buffer-%s", getprogname());
+    if (nvmtl_diag_flag(name)) { *why = "/tmp/nvmtl-desc-buffer-<process>"; return 1; }
+    if (strcmp(getprogname(), "WindowServer") && nvmtl_diag_flag("desc-buffer")) { *why = "/tmp/nvmtl-desc-buffer"; return 1; }
+    *why = "default";
+    return 0;
+}
+static int nvmtl_db_probe(VkPhysicalDeviceDescriptorBufferFeaturesEXT *feat)
+{
+    const char *why = NULL;
+    const int want = nvmtl_db_wanted(&why);
+    if (!want) { nvlog("vk: descriptor model CLASSIC (descriptor sets; %s)", why); return 0; }
+    nvlog("vk: descriptor model BUFFER asked by %s", why);
+    uint32_t na = 0; int have = 0;
+    if (pvkEnumerateDeviceExtensionProperties && pvkEnumerateDeviceExtensionProperties(g_pdev, NULL, &na, NULL) == VK_SUCCESS && na) {
+        VkExtensionProperties *props = calloc(na, sizeof *props);
+        if (props && pvkEnumerateDeviceExtensionProperties(g_pdev, NULL, &na, props) == VK_SUCCESS)
+            for (uint32_t i = 0; i < na && !have; i++) have = !strcmp(props[i].extensionName, VK_EXT_DESCRIPTOR_BUFFER_EXTENSION_NAME);
+        free(props);
+    }
+    PFN_vkGetPhysicalDeviceFeatures2 gpf = (PFN_vkGetPhysicalDeviceFeatures2)pvkGetInstanceProcAddr(g_inst, "vkGetPhysicalDeviceFeatures2");
+    VkPhysicalDeviceDescriptorBufferFeaturesEXT q = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_BUFFER_FEATURES_EXT };
+    VkPhysicalDeviceFeatures2 f2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, &q };
+    if (have && gpf) gpf(g_pdev, &f2);
+    g_dbp = (VkPhysicalDeviceDescriptorBufferPropertiesEXT){ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_BUFFER_PROPERTIES_EXT };
+    VkPhysicalDeviceProperties2 p2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &g_dbp };
+    if (have && q.descriptorBuffer && pvkGetPhysicalDeviceProperties2) pvkGetPhysicalDeviceProperties2(g_pdev, &p2);
+    const int ok = have && q.descriptorBuffer && g_dbp.descriptorBufferOffsetAlignment && g_dbp.maxResourceDescriptorBufferBindings >= 2 &&
+                   g_dbp.maxSamplerDescriptorBufferBindings >= 2 && g_dbp.maxDescriptorBufferBindings >= 2;
+    if (!ok) { nvlog("vk: descriptor model CLASSIC - NVMTL_DESC_MODEL=buffer asked, but VK_EXT_descriptor_buffer is %s",
+                     !have ? "absent" : !q.descriptorBuffer ? "without descriptorBuffer" : "too limited (bindings/alignment)"); return 0; }
+    *feat = (VkPhysicalDeviceDescriptorBufferFeaturesEXT){ VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DESCRIPTOR_BUFFER_FEATURES_EXT, NULL, VK_TRUE };
+    return 1;
+}
+/* After vkCreateDevice: the entry points and descriptor sizes. 0 = the model stays on; -1 = it cannot (logged). */
+static int nvmtl_db_device_ready(int robust)
+{
+    pvkGetDescriptorSetLayoutSizeEXT = (PFN_vkGetDescriptorSetLayoutSizeEXT)pvkGetDeviceProcAddr(g_dev, "vkGetDescriptorSetLayoutSizeEXT");
+    pvkGetDescriptorSetLayoutBindingOffsetEXT = (PFN_vkGetDescriptorSetLayoutBindingOffsetEXT)pvkGetDeviceProcAddr(g_dev, "vkGetDescriptorSetLayoutBindingOffsetEXT");
+    pvkGetDescriptorEXT = (PFN_vkGetDescriptorEXT)pvkGetDeviceProcAddr(g_dev, "vkGetDescriptorEXT");
+    pvkCmdBindDescriptorBuffersEXT = (PFN_vkCmdBindDescriptorBuffersEXT)pvkGetDeviceProcAddr(g_dev, "vkCmdBindDescriptorBuffersEXT");
+    pvkCmdSetDescriptorBufferOffsetsEXT = (PFN_vkCmdSetDescriptorBufferOffsetsEXT)pvkGetDeviceProcAddr(g_dev, "vkCmdSetDescriptorBufferOffsetsEXT");
+    if (!pvkGetDescriptorSetLayoutSizeEXT || !pvkGetDescriptorSetLayoutBindingOffsetEXT || !pvkGetDescriptorEXT ||
+        !pvkCmdBindDescriptorBuffersEXT || !pvkCmdSetDescriptorBufferOffsetsEXT) {
+        nvlog("vk: descriptor model: VK_EXT_descriptor_buffer entry points MISSING - classic sets (with the extension enabled)");
+        return -1;
+    }
+    /* robustBufferAccess on: buffer descriptors take the robust sizes */
+    g_dbt_size[NVMTL_DBT_SSBO]    = (uint32_t)(robust ? g_dbp.robustStorageBufferDescriptorSize : g_dbp.storageBufferDescriptorSize);
+    g_dbt_size[NVMTL_DBT_UBO]     = (uint32_t)(robust ? g_dbp.robustUniformBufferDescriptorSize : g_dbp.uniformBufferDescriptorSize);
+    g_dbt_size[NVMTL_DBT_TEX]     = (uint32_t)g_dbp.sampledImageDescriptorSize;
+    g_dbt_size[NVMTL_DBT_TEXBUF]  = (uint32_t)(robust ? g_dbp.robustUniformTexelBufferDescriptorSize : g_dbp.uniformTexelBufferDescriptorSize);
+    g_dbt_size[NVMTL_DBT_SAMP]    = (uint32_t)g_dbp.samplerDescriptorSize;
+    g_dbt_size[NVMTL_DBT_STEX]    = (uint32_t)g_dbp.storageImageDescriptorSize;
+    g_dbt_size[NVMTL_DBT_STEXBUF] = (uint32_t)(robust ? g_dbp.robustStorageTexelBufferDescriptorSize : g_dbp.storageTexelBufferDescriptorSize);
+    g_dbt_size[NVMTL_DBT_INPUT]   = (uint32_t)g_dbp.inputAttachmentDescriptorSize;
+    for (int k = 0; k < NVMTL_DBT_N; k++)
+        if (!g_dbt_size[k] || g_dbt_size[k] > NVMTL_DB_MAXDESC) {
+            nvlog("vk: descriptor model: descriptor type %d is %u bytes (shadow holds %u) - classic sets", k, g_dbt_size[k], NVMTL_DB_MAXDESC);
+            return -1;
+        }
+    g_db_align = (uint32_t)g_dbp.descriptorBufferOffsetAlignment;
+    nvlog("vk: descriptor model BUFFER (VK_EXT_descriptor_buffer): sizes ssbo %u ubo %u image %u texel %u "
+          "sampler %u storage %u/%u input %u, offset alignment %u, %u buffer bindings",
+          g_dbt_size[0], g_dbt_size[1], g_dbt_size[2], g_dbt_size[3], g_dbt_size[4], g_dbt_size[5], g_dbt_size[6], g_dbt_size[7],
+          g_db_align, g_dbp.maxDescriptorBufferBindings);
+    return 0;
+}
+/* VK_PIPELINE_CREATE_DESCRIPTOR_BUFFER_BIT_EXT for every pipeline in buffer mode (also those with no sets) */
+static VkPipelineCreateFlags nvmtl_db_pipeline_flags(void) { return g_dbuf ? VK_PIPELINE_CREATE_DESCRIPTOR_BUFFER_BIT_EXT : 0; }
+static VkDescriptorSetLayoutCreateFlags nvmtl_db_layout_flags(void) { return g_dbuf ? VK_DESCRIPTOR_SET_LAYOUT_CREATE_DESCRIPTOR_BUFFER_BIT_EXT : 0; }
+
+/* ---- descriptor memory ---------------------------------------------------------------------------------------------- */
+
+typedef struct { VkBuffer buf; VkDeviceMemory mem; uint8_t *map; uint64_t addr; size_t size; } nvmtl_dbmem;
+/* A buffer descriptors can be read from: ANV puts it in its dynamic-visible address range (the memory types its
+   descriptor-buffer usage allows). Host-visible, coherent and mapped for the process; device-local when the BAR offers it. */
+static int nvmtl_db_mem_create(size_t size, nvmtl_dbmem *m)
+{
+    memset(m, 0, sizeof *m);
+    VkBufferCreateInfo bci = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, NULL, 0, size,
+        VK_BUFFER_USAGE_RESOURCE_DESCRIPTOR_BUFFER_BIT_EXT | VK_BUFFER_USAGE_SAMPLER_DESCRIPTOR_BUFFER_BIT_EXT |
+        VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT, VK_SHARING_MODE_EXCLUSIVE, 0, NULL };
+    if (pvkCreateBuffer(g_dev, &bci, NULL, &m->buf) != VK_SUCCESS) { m->buf = VK_NULL_HANDLE; return -1; }
+    VkMemoryRequirements mr; pvkGetBufferMemoryRequirements(g_dev, m->buf, &mr);
+    const VkMemoryPropertyFlags hv = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    int mt = -1;
+    for (uint32_t i = 0; i < g_memp.memoryTypeCount && mt < 0; i++)
+        if ((mr.memoryTypeBits & (1u << i)) && (g_memp.memoryTypes[i].propertyFlags & (hv | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) == (hv | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) mt = (int)i;
+    for (uint32_t i = 0; i < g_memp.memoryTypeCount && mt < 0; i++)
+        if ((mr.memoryTypeBits & (1u << i)) && (g_memp.memoryTypes[i].propertyFlags & hv) == hv) mt = (int)i;
+    if (mt < 0) { pvkDestroyBuffer(g_dev, m->buf, NULL); m->buf = VK_NULL_HANDLE; nvlog("vk: descriptor buffer: no host-visible memory type (bits 0x%x)", mr.memoryTypeBits); return -1; }
+    VkMemoryAllocateFlagsInfo fi = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO, NULL, VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT, 0 };
+    VkMemoryAllocateInfo mai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &fi, mr.size, (uint32_t)mt };
+    void *map = NULL;
+    if (pvkAllocateMemory(g_dev, &mai, NULL, &m->mem) != VK_SUCCESS) { m->mem = VK_NULL_HANDLE; goto fail; }
+    if (pvkBindBufferMemory(g_dev, m->buf, m->mem, 0) != VK_SUCCESS) goto fail;
+    if (pvkMapMemory(g_dev, m->mem, 0, VK_WHOLE_SIZE, 0, &map) != VK_SUCCESS || !map) goto fail;
+    VkBufferDeviceAddressInfo ai = { VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO, NULL, m->buf };
+    m->addr = pvkGetBufferDeviceAddress(g_dev, &ai);
+    if (!m->addr) goto fail;
+    m->map = (uint8_t *)map; m->size = size;
+    return 0;
+fail:
+    nvlog("vk: descriptor buffer of %zu bytes NOT made (memory type %d)", size, mt);
+    if (m->mem) pvkFreeMemory(g_dev, m->mem, NULL);
+    pvkDestroyBuffer(g_dev, m->buf, NULL);
+    memset(m, 0, sizeof *m);
+    return -1;
+}
+static void nvmtl_db_mem_destroy(nvmtl_dbmem *m)
+{
+    if (m->mem) pvkFreeMemory(g_dev, m->mem, NULL);   // unmapped by the free
+    if (m->buf) pvkDestroyBuffer(g_dev, m->buf, NULL);
+    memset(m, 0, sizeof *m);
+}
+
+/* ---- descriptor bytes ----------------------------------------------------------------------------------------------- */
+
+/* Texel buffer views: a descriptor is made from the address, range and format, not from the VkBufferView, so each view
+   nvmtl_vk_texel_view_create makes is recorded here until nvmtl_vk_texel_view_destroy. */
+#define NVMTL_TV_CAP (1u << 16)
+typedef struct { const void *view; uint64_t addr, range; uint32_t fmt; } nvmtl_tvinfo;
+static nvmtl_tvinfo *g_tv; static uint32_t g_tv_n; static pthread_mutex_t g_tv_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint32_t nvmtl_tv_hash(const void *p) { uint64_t x = (uint64_t)(uintptr_t)p; x ^= x >> 33; x *= 0xff51afd7ed558ccdull; x ^= x >> 33; return (uint32_t)x & (NVMTL_TV_CAP - 1); }
+static void nvmtl_db_texel_note(const void *view, uint64_t addr, uint64_t range, uint32_t fmt)
+{
+    if (!g_dbuf || !view) return;
+    pthread_mutex_lock(&g_tv_lock);
+    if (!g_tv) g_tv = (nvmtl_tvinfo *)calloc(NVMTL_TV_CAP, sizeof *g_tv);
+    if (g_tv && g_tv_n < NVMTL_TV_CAP / 2) {
+        uint32_t h = nvmtl_tv_hash(view);
+        while (g_tv[h].view && g_tv[h].view != view) h = (h + 1) & (NVMTL_TV_CAP - 1);
+        if (!g_tv[h].view) g_tv_n++;
+        g_tv[h] = (nvmtl_tvinfo){ view, addr, range, fmt };
+    } else { static int said; if (!said++) nvlog("vk: descriptor buffer: texel view table FULL - a texel buffer reads as null"); }
+    pthread_mutex_unlock(&g_tv_lock);
+}
+static void nvmtl_db_texel_forget(const void *view)
+{
+    if (!view) return;
+    pthread_mutex_lock(&g_tv_lock);
+    if (!g_tv) { pthread_mutex_unlock(&g_tv_lock); return; }
+    uint32_t i = nvmtl_tv_hash(view);
+    while (g_tv[i].view && g_tv[i].view != view) i = (i + 1) & (NVMTL_TV_CAP - 1);
+    if (g_tv[i].view) {
+        g_tv[i].view = NULL; g_tv_n--;
+        for (uint32_t j = i;;) {   // backward-shift deletion (open addressing, linear probing)
+            j = (j + 1) & (NVMTL_TV_CAP - 1);
+            if (!g_tv[j].view) break;
+            uint32_t k = nvmtl_tv_hash(g_tv[j].view);
+            if ((j > i && (k <= i || k > j)) || (j < i && (k <= i && k > j))) { g_tv[i] = g_tv[j]; g_tv[j].view = NULL; i = j; }
+        }
+    }
+    pthread_mutex_unlock(&g_tv_lock);
+}
+static int nvmtl_db_texel_find(const void *view, VkDescriptorAddressInfoEXT *out)
+{
+    int found = 0;
+    pthread_mutex_lock(&g_tv_lock);
+    if (g_tv && view) {
+        uint32_t h = nvmtl_tv_hash(view);
+        while (g_tv[h].view && g_tv[h].view != view) h = (h + 1) & (NVMTL_TV_CAP - 1);
+        if (g_tv[h].view) { *out = (VkDescriptorAddressInfoEXT){ VK_STRUCTURE_TYPE_DESCRIPTOR_ADDRESS_INFO_EXT, NULL, g_tv[h].addr, g_tv[h].range, (VkFormat)g_tv[h].fmt }; found = 1; }
+    }
+    pthread_mutex_unlock(&g_tv_lock);
+    return found;
+}
+
+static void nvmtl_db_get_image(int type, const void *view, VkImageLayout layout, uint8_t *out)
+{
+    VkDescriptorImageInfo ii = { VK_NULL_HANDLE, (VkImageView)view, layout };
+    VkDescriptorGetInfoEXT gi = { VK_STRUCTURE_TYPE_DESCRIPTOR_GET_INFO_EXT, NULL, g_dbt_vk[type], { 0 } };
+    if (type == NVMTL_DBT_STEX) gi.data.pStorageImage = view ? &ii : NULL;
+    else if (type == NVMTL_DBT_INPUT) gi.data.pInputAttachmentImage = view ? &ii : NULL;
+    else gi.data.pSampledImage = view ? &ii : NULL;
+    pvkGetDescriptorEXT(g_dev, &gi, g_dbt_size[type], out);
+}
+static void nvmtl_db_get_sampler(const void *s, uint8_t *out)
+{
+    VkSampler h = (VkSampler)s;
+    VkDescriptorGetInfoEXT gi = { VK_STRUCTURE_TYPE_DESCRIPTOR_GET_INFO_EXT, NULL, VK_DESCRIPTOR_TYPE_SAMPLER, { 0 } };
+    gi.data.pSampler = &h;
+    pvkGetDescriptorEXT(g_dev, &gi, g_dbt_size[NVMTL_DBT_SAMP], out);
+}
+static void nvmtl_db_get_buffer(int type, uint64_t addr, uint64_t range, uint8_t *out)
+{
+    VkDescriptorAddressInfoEXT ai = { VK_STRUCTURE_TYPE_DESCRIPTOR_ADDRESS_INFO_EXT, NULL, addr, range, VK_FORMAT_UNDEFINED };
+    VkDescriptorGetInfoEXT gi = { VK_STRUCTURE_TYPE_DESCRIPTOR_GET_INFO_EXT, NULL, g_dbt_vk[type], { 0 } };
+    if (type == NVMTL_DBT_UBO) gi.data.pUniformBuffer = addr ? &ai : NULL; else gi.data.pStorageBuffer = addr ? &ai : NULL;
+    pvkGetDescriptorEXT(g_dev, &gi, g_dbt_size[type], out);
+}
+static void nvmtl_db_get_texel(int type, const void *view, uint8_t *out)
+{
+    VkDescriptorAddressInfoEXT ai; const int have = view && nvmtl_db_texel_find(view, &ai);
+    VkDescriptorGetInfoEXT gi = { VK_STRUCTURE_TYPE_DESCRIPTOR_GET_INFO_EXT, NULL, g_dbt_vk[type], { 0 } };
+    if (type == NVMTL_DBT_STEXBUF) gi.data.pStorageTexelBuffer = have ? &ai : NULL; else gi.data.pUniformTexelBuffer = have ? &ai : NULL;
+    pvkGetDescriptorEXT(g_dev, &gi, g_dbt_size[type], out);
+}
+static uint64_t nvmtl_db_dummy_addr(void)
+{
+    static uint64_t a;
+    uint64_t v = __atomic_load_n(&a, __ATOMIC_RELAXED);
+    if (!v) { v = nvmtl_vk_buffer_address(&g_dummyBuf); __atomic_store_n(&a, v, __ATOMIC_RELAXED); }
+    return v;
+}
+/* Slot i of stage `which` as a descriptor of `type`: what nvmtl_snapshot_set_md writes for it in the classic model. */
+static void nvmtl_db_gen(const nvmtl_slot *sl, uint32_t which, uint32_t i, int type, uint8_t *out)
+{
+    sl = nvmtl_slot_checked(sl, which, i);
+    switch (type) {
+    case NVMTL_DBT_SSBO:
+        if (sl && sl->kind == NVMTL_SLOT_BUF) {
+            const size_t at = sl->off & ~(size_t)(NVMTL_SSBO_ALIGN - 1);   // the shader adds the remainder (classic model)
+            const size_t whole = sl->size + sl->vextra;                      // VK_WHOLE_SIZE of the VkBuffer
+            nvmtl_db_get_buffer(type, sl->address + at, whole > at ? whole - at : 0, out);
+        } else if (g_null_desc) nvmtl_db_get_buffer(type, 0, 0, out);
+        else nvmtl_db_get_buffer(type, nvmtl_db_dummy_addr(), g_dummyBuf.vksize ? g_dummyBuf.vksize : g_dummyBuf.size, out);
+        return;
+    case NVMTL_DBT_TEX:
+        nvmtl_db_get_image(type, (sl && sl->kind == NVMTL_SLOT_TEX && sl->h) ? sl->h : g_null_desc ? NULL : g_dummyImg.view,
+                           VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, out);
+        return;
+    case NVMTL_DBT_TEXBUF: case NVMTL_DBT_STEXBUF:
+        nvmtl_db_get_texel(type, (sl && sl->kind == NVMTL_SLOT_TEXBUF && sl->h) ? sl->h : g_null_desc ? NULL : g_dummyTexView, out);
+        return;
+    case NVMTL_DBT_SAMP:
+        nvmtl_db_get_sampler((sl && sl->kind == NVMTL_SLOT_SAMP && sl->h) ? sl->h : (const void *)g_dummySampler, out);
+        return;
+    case NVMTL_DBT_STEX: {
+        const int bound = sl && sl->kind == NVMTL_SLOT_TEX && sl->h;
+        const void *view = bound ? sl->h : g_null_desc ? NULL : g_dummyStex.view;
+        if (!view && !g_null_desc) { memset(out, 0, g_dbt_size[type]); return; }   // classic: left unwritten
+        nvmtl_db_get_image(type, view, VK_IMAGE_LAYOUT_GENERAL, out);
+        return; }
+    default:
+        memset(out, 0, g_dbt_size[type]);
+    }
+}
+
+/* ---- per-pipeline layouts (plans) ----------------------------------------------------------------------------------- */
+
+typedef struct { uint16_t slot; uint8_t type; uint8_t pad; uint32_t off; } nvmtl_dbent;
+typedef struct nvmtl_dbplan {
+    struct nvmtl_dbplan *next;
+    uint64_t key[9];                       /* binding mask (4), texel mask (4), storage-texture count */
+    VkDescriptorSetLayout layout;
+    uint32_t size, n, table;               /* table: the address table's entry index + 1 (0 = none) */
+    nvmtl_dbent e[];
+} nvmtl_dbplan;
+static nvmtl_dbplan *g_dbplans; static unsigned g_dbplan_n;   /* g_desc_lock */
+/* The stage layout for: the bindings in mask (NULL = all) below NVMTL_STEX_BASE, storage textures 0..stex_hi-1, and the
+   texel-buffer bits tb (NULL = none). empty: no bindings (compute's unused set 1). NULL on failure (logged). */
+static const nvmtl_dbplan *nvmtl_db_plan(const uint64_t *mask, uint32_t stex_hi, const uint64_t *tb, int empty)
+{
+    if (stex_hi > NVMTL_NSTEX) stex_hi = NVMTL_NSTEX;
+    if (!g_mutable) tb = NULL;
+    uint64_t key[9] = { 0 };
+    if (!empty) {
+        for (int k = 0; k < 4; k++) key[k] = mask ? mask[k] : ~0ull;
+        for (uint32_t i = NVMTL_STEX_BASE; i < 256; i++) key[i >> 6] &= ~(1ull << (i & 63));   // storage textures: stex_hi
+        for (int k = 0; k < 4; k++) key[4 + k] = tb ? tb[k] : 0;
+        key[8] = stex_hi;
+    }
+    pthread_mutex_lock(&g_desc_lock);
+    for (nvmtl_dbplan *p = g_dbplans; p; p = p->next)
+        if (!memcmp(p->key, key, sizeof key)) { pthread_mutex_unlock(&g_desc_lock); return p; }
+    VkDescriptorSetLayoutBinding b[NVMTL_NBIND]; uint8_t ty[NVMTL_NBIND]; uint16_t sl[NVMTL_NBIND]; uint32_t n = 0;
+    for (uint32_t i = 0; !empty && i < NVMTL_STEX_BASE; i++) {
+        if (!((key[i >> 6] >> (i & 63)) & 1)) continue;
+        int t;
+        if (i == NVMTL_ADDRESS_BINDING) t = nvmtl_table_ubo() ? NVMTL_DBT_UBO : NVMTL_DBT_SSBO;
+        else if (i < NVMTL_NBUF) t = NVMTL_DBT_SSBO;
+        else if (i < NVMTL_NBUF + NVMTL_NTEX) { const uint32_t k = i - NVMTL_NBUF; t = ((key[4 + (k >> 6)] >> (k & 63)) & 1) ? NVMTL_DBT_TEXBUF : NVMTL_DBT_TEX; }
+        else t = NVMTL_DBT_SAMP;
+        b[n] = (VkDescriptorSetLayoutBinding){ NVMTL_BINDING_NUMBER(i), g_dbt_vk[t], 1, VK_SHADER_STAGE_ALL, NULL };
+        ty[n] = (uint8_t)t; sl[n] = (uint16_t)i; n++;
+    }
+    for (uint32_t j = 0; !empty && j < stex_hi; j++) {
+        const uint32_t i = NVMTL_STEX_BASE + j;
+        const int t = ((key[6 + (j >> 6)] >> (j & 63)) & 1) ? NVMTL_DBT_STEXBUF : NVMTL_DBT_STEX;
+        b[n] = (VkDescriptorSetLayoutBinding){ NVMTL_BINDING_NUMBER(i), g_dbt_vk[t], 1, VK_SHADER_STAGE_ALL, NULL };
+        ty[n] = (uint8_t)t; sl[n] = (uint16_t)i; n++;
+    }
+    VkDescriptorSetLayoutCreateInfo lci = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, NULL,
+                                            VK_DESCRIPTOR_SET_LAYOUT_CREATE_DESCRIPTOR_BUFFER_BIT_EXT, n, n ? b : NULL };
+    nvmtl_dbplan *p = (nvmtl_dbplan *)calloc(1, sizeof *p + n * sizeof p->e[0]);
+    if (!p || pvkCreateDescriptorSetLayout(g_dev, &lci, NULL, &p->layout) != VK_SUCCESS) {
+        pthread_mutex_unlock(&g_desc_lock); free(p);
+        nvlog("vk: descriptor buffer: stage layout of %u bindings NOT made", n); return NULL;
+    }
+    memcpy(p->key, key, sizeof key); p->n = n;
+    VkDeviceSize size = 0; pvkGetDescriptorSetLayoutSizeEXT(g_dev, p->layout, &size);
+    p->size = (uint32_t)size;
+    for (uint32_t k = 0; k < n; k++) {
+        VkDeviceSize off = 0; pvkGetDescriptorSetLayoutBindingOffsetEXT(g_dev, p->layout, b[k].binding, &off);
+        p->e[k] = (nvmtl_dbent){ sl[k], ty[k], 0, (uint32_t)off };
+        if (sl[k] == NVMTL_ADDRESS_BINDING) p->table = k + 1;
+    }
+    p->next = g_dbplans; g_dbplans = p; g_dbplan_n++;
+    const unsigned np = g_dbplan_n;
+    pthread_mutex_unlock(&g_desc_lock);
+    if (np <= 4 || !(np & (np - 1))) nvlog("vk: descriptor buffer: %u stage layouts (this one %u bindings, %u bytes)", np, n, p->size);
+    return p;
+}
+/* The fetch layout's binding offsets (set 3, input attachments 192..199) */
+static uint32_t g_db_fetch_off[NVMTL_NCOL], g_db_fetch_size; static int g_db_fetch_ready;
+static void nvmtl_db_fetch_offsets_locked(void)
+{
+    if (g_db_fetch_ready || !g_fetchLayout) return;
+    VkDeviceSize s = 0; pvkGetDescriptorSetLayoutSizeEXT(g_dev, g_fetchLayout, &s); g_db_fetch_size = (uint32_t)s;
+    for (uint32_t i = 0; i < NVMTL_NCOL; i++) { VkDeviceSize o = 0; pvkGetDescriptorSetLayoutBindingOffsetEXT(g_dev, g_fetchLayout, NVMTL_FETCH_BINDING + i, &o); g_db_fetch_off[i] = (uint32_t)o; }
+    g_db_fetch_ready = 1;
+}
+
+/* ---- the bindless heap as a descriptor buffer ----------------------------------------------------------------------- */
+
+static nvmtl_dbmem g_dbheap; static uint32_t g_dbheap_img_off, g_dbheap_samp_off;
+/* ensure_descriptors_locked, buffer model: binding 0 holds NVMTL_BINDLESS_SLOTS sampled images, binding 1 (unless
+   NVMTL_NO_ARGBUF_SAMPLERS=1) NVMTL_BINDLESS_SAMPLER_SLOTS samplers; every slot the dummy (or null) until a texture or
+   sampler is placed, as in the classic heap. No update-after-bind: writing descriptor memory is the plugin's own, and the
+   slot quarantine (nvmtl_vk_bindless_put) keeps a slot in flight from being rewritten, as before. */
+static int nvmtl_db_heap_create_locked(void)
+{
+    const char *nas = getenv("NVMTL_NO_ARGBUF_SAMPLERS"); const uint32_t hnb = (nas && nas[0] == '1') ? 1u : 2u;
+    VkDescriptorSetLayoutBinding hb[2] = { { 0, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, NVMTL_BINDLESS_SLOTS, VK_SHADER_STAGE_ALL, NULL },
+                                           { 1, VK_DESCRIPTOR_TYPE_SAMPLER, NVMTL_BINDLESS_SAMPLER_SLOTS, VK_SHADER_STAGE_ALL, NULL } };
+    VkDescriptorSetLayoutCreateInfo hli = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, NULL,
+                                            VK_DESCRIPTOR_SET_LAYOUT_CREATE_DESCRIPTOR_BUFFER_BIT_EXT, hnb, hb };
+    VkDescriptorSetLayout hl = VK_NULL_HANDLE;
+    if (pvkCreateDescriptorSetLayout(g_dev, &hli, NULL, &hl) != VK_SUCCESS) { nvlog("vk: BINDLESS heap layout (descriptor buffer) refused - no heap"); return -1; }
+    VkDeviceSize size = 0, o0 = 0, o1 = 0;
+    pvkGetDescriptorSetLayoutSizeEXT(g_dev, hl, &size);
+    pvkGetDescriptorSetLayoutBindingOffsetEXT(g_dev, hl, 0, &o0);
+    if (hnb == 2) pvkGetDescriptorSetLayoutBindingOffsetEXT(g_dev, hl, 1, &o1);
+    if (nvmtl_db_mem_create((size_t)size, &g_dbheap)) { pvkDestroyDescriptorSetLayout(g_dev, hl, NULL); return -1; }
+    g_dbheap_img_off = (uint32_t)o0; g_dbheap_samp_off = (uint32_t)o1;
+    uint8_t d[NVMTL_DB_MAXDESC];
+    nvmtl_db_get_image(NVMTL_DBT_TEX, g_null_desc ? NULL : g_dummyImg.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, d);
+    const uint32_t is = g_dbt_size[NVMTL_DBT_TEX], ss = g_dbt_size[NVMTL_DBT_SAMP];
+    for (uint32_t k = 0; k < NVMTL_BINDLESS_SLOTS; k++) memcpy(g_dbheap.map + g_dbheap_img_off + (size_t)k * is, d, is);
+    if (hnb == 2) {
+        nvmtl_db_get_sampler((const void *)g_dummySampler, d);
+        for (uint32_t k = 0; k < NVMTL_BINDLESS_SAMPLER_SLOTS; k++) memcpy(g_dbheap.map + g_dbheap_samp_off + (size_t)k * ss, d, ss);
+        g_heap_sampler_binding = 1;
+    }
+    g_heapLayout = hl; g_heap_ready = 1;
+    nvlog("vk: BINDLESS heap ready (descriptor buffer, %llu bytes) - set 2, %d sampled images%s", (unsigned long long)size,
+          NVMTL_BINDLESS_SLOTS, hnb == 2 ? " + samplers" : "");
+    return 0;
+}
+static void nvmtl_db_heap_write_image(uint32_t slot, const void *view)
+{
+    const uint32_t is = g_dbt_size[NVMTL_DBT_TEX];
+    nvmtl_db_get_image(NVMTL_DBT_TEX, view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, g_dbheap.map + g_dbheap_img_off + (size_t)slot * is);
+}
+static void nvmtl_db_heap_write_sampler(uint32_t slot, const void *s)
+{
+    nvmtl_db_get_sampler(s, g_dbheap.map + g_dbheap_samp_off + (size_t)slot * g_dbt_size[NVMTL_DBT_SAMP]);
+}
+
+/* ---- the per-command-buffer ring ------------------------------------------------------------------------------------ */
+
+#define NVMTL_DB_PAGE (256u << 10)
+#define NVMTL_DB_MRU 4
+typedef struct nvmtl_dbpage { nvmtl_dbmem m; struct nvmtl_dbpage *next; } nvmtl_dbpage;
+static nvmtl_dbpage *g_dbkeep[NVMTL_KEEP]; static unsigned g_dbkeep_n;   /* g_keep_lock */
+static nvmtl_dbpage *nvmtl_db_page_pop(void)
+{
+    nvmtl_dbpage *p = NULL;
+    if (!nvmtl_keep_on()) return NULL;
+    pthread_mutex_lock(&g_keep_lock); if (g_dbkeep_n) p = g_dbkeep[--g_dbkeep_n]; pthread_mutex_unlock(&g_keep_lock);
+    return p;
+}
+static int nvmtl_db_page_push(nvmtl_dbpage *p)
+{
+    int kept = 0;
+    if (!nvmtl_keep_on() || p->m.size != NVMTL_DB_PAGE) return 0;
+    pthread_mutex_lock(&g_keep_lock); if (g_dbkeep_n < NVMTL_KEEP) { p->next = NULL; g_dbkeep[g_dbkeep_n++] = p; kept = 1; } pthread_mutex_unlock(&g_keep_lock);
+    return kept;
+}
+
+typedef struct {
+    nvmtl_dbpage *pages;               /* pages[0]: the one being filled; the rest are retired with the command buffer */
+    uint32_t used, gen;                /* bytes used in pages[0]; gen: bumped per page (offsets name the bound page) */
+    uint32_t bound_gen;                /* gen of the page vkCmdBindDescriptorBuffersEXT bound (0 = none yet) */
+    const nvmtl_dbplan *plan[2]; uint32_t off[2], ogen[2], oepoch[2], oneed[2];   /* the last region per stage (oneed: its table's entries, stage 1d) */
+    VkPipelineLayout lay[2]; uint32_t lgen[2], nset[2], soff[2][4], sidx[2][4];   /* last offsets set, per bind point */
+    uint32_t fz_off, fz_gen;           /* the fetch-off region (every input attachment the dummy) */
+    uint32_t n_reg, n_reuse, n_gen;    /* census (NVMTL_DBUF_CENSUS=1), added to the process totals at retire */
+    /* the stage's recent regions, reusable while none of its bindings changed (epoch) and the page is the same: a
+       pipeline switch back and forth (A, B, A ...) finds its region again instead of writing a new one */
+    struct { const nvmtl_dbplan *plan; uint32_t off, gen, epoch, need; } mru[2][NVMTL_DB_MRU];
+    uint32_t epoch[2], mru_next[2];
+    uint64_t valid[2][NVMTL_CHG_WORDS];
+    uint8_t ty[2][NVMTL_NBIND];
+    uint8_t d[2][NVMTL_NBIND][NVMTL_DB_MAXDESC];   /* each slot's descriptor, made when the slot changes */
+} nvmtl_dbstate;
+
+static nvmtl_dbstate *nvmtl_db_state(nvk_cmdbuf *c)
+{
+    if (c->db) return (nvmtl_dbstate *)c->db;
+    nvmtl_dbstate *s = (nvmtl_dbstate *)malloc(sizeof *s);
+    if (!s) return NULL;
+    // only the bookkeeping is cleared: d[] is written before it is read (valid bits)
+    memset(s, 0, offsetof(nvmtl_dbstate, d));
+    c->db = s;
+    return s;
+}
+static void nvmtl_db_retire(nvk_cmdbuf *c, int keep)
+{
+    nvmtl_dbstate *s = (nvmtl_dbstate *)c->db;
+    if (!s) return;
+    atomic_fetch_add(&g_db_regions, s->n_reg); atomic_fetch_add(&g_db_reuse, s->n_reuse); atomic_fetch_add(&g_db_gen, s->n_gen);
+    nvmtl_db_census();
+    for (nvmtl_dbpage *p = s->pages; p; ) {
+        nvmtl_dbpage *next = p->next;
+        // keep < 0: the witness never landed - the page is leaked, never reused (as the address pages)
+        if (keep >= 0 && !(keep > 0 && nvmtl_db_page_push(p))) { nvmtl_db_mem_destroy(&p->m); free(p); }
+        p = next;
+    }
+    free(s); c->db = NULL;
+}
+/* Makes sure `need` more bytes fit in the current page (a new page otherwise). Every region one draw or dispatch uses
+   must be in the page bound at index 0, so a bind reserves its worst case first and then allocates without a page change. */
+static int nvmtl_db_reserve(nvmtl_dbstate *s, uint32_t need)
+{
+    const uint32_t a = g_db_align ? g_db_align : 64;
+    const uint32_t at = (s->used + a - 1) / a * a;
+    if (s->pages && (size_t)at + need <= s->pages->m.size) return 0;
+    const size_t want = need <= NVMTL_DB_PAGE ? NVMTL_DB_PAGE : ((size_t)need + 4095) & ~(size_t)4095;
+    nvmtl_dbpage *pg = want == NVMTL_DB_PAGE ? nvmtl_db_page_pop() : NULL;
+    if (!pg) {
+        pg = (nvmtl_dbpage *)calloc(1, sizeof *pg);
+        if (!pg || nvmtl_db_mem_create(want, &pg->m)) { free(pg); return -1; }
+        atomic_fetch_add(want == NVMTL_DB_PAGE ? &g_db_pages : &g_db_bigpages, 1);
+    }
+    pg->next = s->pages; s->pages = pg; s->used = 0; s->gen++;
+    return 0;
+}
+/* size bytes of the current page, inside what nvmtl_db_reserve made room for */
+static uint8_t *nvmtl_db_alloc(nvmtl_dbstate *s, uint32_t size, uint32_t *off)
+{
+    const uint32_t a = g_db_align ? g_db_align : 64;
+    const uint32_t at = (s->used + a - 1) / a * a;
+    if (!s->pages || (size_t)at + size > s->pages->m.size) return NULL;
+    s->used = at + size; *off = at;
+    return s->pages->m.map + at;
+}
+/* binds the current page (index 0) and the heap (index 1) when the page changed */
+static void nvmtl_db_bind_buffers(nvk_cmdbuf *c, nvmtl_dbstate *s)
+{
+    if (s->bound_gen == s->gen) return;
+    const VkBufferUsageFlags u = VK_BUFFER_USAGE_RESOURCE_DESCRIPTOR_BUFFER_BIT_EXT | VK_BUFFER_USAGE_SAMPLER_DESCRIPTOR_BUFFER_BIT_EXT;
+    VkDescriptorBufferBindingInfoEXT bi[2] = {
+        { VK_STRUCTURE_TYPE_DESCRIPTOR_BUFFER_BINDING_INFO_EXT, NULL, s->pages->m.addr, u },
+        { VK_STRUCTURE_TYPE_DESCRIPTOR_BUFFER_BINDING_INFO_EXT, NULL, g_dbheap.addr, u } };
+    pvkCmdBindDescriptorBuffersEXT((VkCommandBuffer)c->cb, g_dbheap.buf ? 2 : 1, bi);
+    s->bound_gen = s->gen;
+    s->lay[0] = s->lay[1] = VK_NULL_HANDLE;   // offsets are set again for the new page
+}
+
+/* The descriptor of the table nvmtl_address_snapshot just placed (slot `ai` of the newest page): made once per page and
+   table, then copied (the classic model's dynamic offset did the same job). */
+static const uint8_t *nvmtl_db_table_desc(nvk_cmdbuf *c, int type, const VkDescriptorBufferInfo *ai)
+{
+    nvmtl_address_page *page = (nvmtl_address_page *)c->address_pages;
+    const uint32_t k = (uint32_t)(ai->offset / NVMTL_TABLE_BYTES);
+    if (!page->udesc && !(page->udesc = (uint8_t *)malloc((size_t)NVMTL_TABLES_PER_PAGE * NVMTL_DB_MAXDESC))) return NULL;
+    uint8_t *d = page->udesc + (size_t)k * NVMTL_DB_MAXDESC;
+    if (!((page->uvalid[k >> 6] >> (k & 63)) & 1)) {
+        nvmtl_db_get_buffer(type, page->addr + ai->offset, ai->range, d);
+        page->uvalid[k >> 6] |= 1ull << (k & 63);
+    }
+    return d;
+}
+/* The region for stage `which` under plan pl, in the current page: an earlier one when none of the stage's bindings
+   changed since (and the page is the same), else a new one. -1 on failure. */
+static int nvmtl_db_stage(nvk_cmdbuf *c, nvmtl_dbstate *s, uint32_t which, const nvmtl_dbplan *pl, uint32_t need)
+{
+    nvmtl_bindtable *t = (nvmtl_bindtable *)c->table;
+    if (t && t->dirty[which]) {   // a slot that changed has its descriptor made again when a plan next reads it
+        for (int k = 0; k < NVMTL_CHG_WORDS; k++) { s->valid[which][k] &= ~t->chg[which][k]; t->chg[which][k] = 0; }
+        t->dirty[which] = 0; s->epoch[which]++;
+    }
+    // a region is reused only when its table holds the entries this stage reads (stage 1d: tables hold only those)
+    if (s->plan[which] == pl && s->ogen[which] == s->gen && s->oepoch[which] == s->epoch[which] && nvmtl_tabneed_covers(s->oneed[which], need)) { s->n_reuse++; return 0; }
+    for (uint32_t m = 0; m < NVMTL_DB_MRU; m++)
+        if (s->mru[which][m].plan == pl && s->mru[which][m].gen == s->gen && s->mru[which][m].epoch == s->epoch[which]
+            && nvmtl_tabneed_covers(s->mru[which][m].need, need)) {
+            s->plan[which] = pl; s->off[which] = s->mru[which][m].off; s->ogen[which] = s->gen; s->oepoch[which] = s->epoch[which]; s->oneed[which] = s->mru[which][m].need;
+            s->n_reuse++; return 0;
+        }
+    uint32_t off = 0;
+    uint8_t *dst = nvmtl_db_alloc(s, pl->size, &off);
+    if (!dst) return -1;
+    for (uint32_t k = 0; k < pl->n; k++) {
+        const nvmtl_dbent *e = &pl->e[k];
+        const uint32_t i = e->slot, sz = g_dbt_size[e->type];
+        if (i == NVMTL_ADDRESS_BINDING) {   // a new table for a new region: it holds the stage's buffer addresses and texture sizes
+            VkDescriptorBufferInfo ai;
+            c->tab_need[which] = need;
+            if (nvmtl_address_snapshot(c, which, &ai)) return -1;
+            const uint8_t *td = nvmtl_db_table_desc(c, e->type, &ai);
+            if (!td) return -1;
+            memcpy(dst + e->off, td, sz);
+            continue;
+        }
+        uint8_t *sh = s->d[which][i];
+        if (!((s->valid[which][i >> 6] >> (i & 63)) & 1) || s->ty[which][i] != e->type) {
+            nvmtl_db_gen(t ? &t->s[which][i] : NULL, which, i, e->type, sh);
+            s->valid[which][i >> 6] |= 1ull << (i & 63); s->ty[which][i] = e->type;
+            s->n_gen++;
+        }
+        memcpy(dst + e->off, sh, sz);
+    }
+    s->plan[which] = pl; s->off[which] = off; s->ogen[which] = s->gen; s->oepoch[which] = s->epoch[which]; s->oneed[which] = need;
+    const uint32_t m = s->mru_next[which]++ % NVMTL_DB_MRU;
+    s->mru[which][m].plan = pl; s->mru[which][m].off = off; s->mru[which][m].gen = s->gen; s->mru[which][m].epoch = s->epoch[which]; s->mru[which][m].need = need;
+    s->n_reg++;
+    return 0;
+}
+/* the offsets for the n sets of layout `lay` at bind point bp (0 graphics, 1 compute); skipped when already set */
+static void nvmtl_db_set_offsets(nvk_cmdbuf *c, nvmtl_dbstate *s, int bp, VkPipelineLayout lay, uint32_t n,
+                                 const uint32_t *idx, const uint32_t *off)
+{
+    int same = s->lay[bp] == lay && s->lgen[bp] == s->gen && s->nset[bp] == n;
+    for (uint32_t k = 0; same && k < n; k++) same = s->sidx[bp][k] == idx[k] && s->soff[bp][k] == off[k];
+    if (same) return;
+    VkDeviceSize o[4];
+    for (uint32_t k = 0; k < n; k++) o[k] = off[k];
+    pvkCmdSetDescriptorBufferOffsetsEXT((VkCommandBuffer)c->cb, bp ? VK_PIPELINE_BIND_POINT_COMPUTE : VK_PIPELINE_BIND_POINT_GRAPHICS,
+                                        lay, 0, n, idx, o);
+    s->lay[bp] = lay; s->lgen[bp] = s->gen; s->nset[bp] = n;
+    for (uint32_t k = 0; k < n; k++) { s->sidx[bp][k] = idx[k]; s->soff[bp][k] = off[k]; }
+}
+static uint32_t nvmtl_db_worst(const nvmtl_dbplan *a, const nvmtl_dbplan *b, uint32_t extra)
+{
+    const uint32_t al = g_db_align ? g_db_align : 64;
+    return a->size + b->size + extra + 3 * al;
+}
+
+/* Graphics: nvmtl_vk_cmd_bind_set in the buffer model. Sets 0 and 1 are the stages, 2 the heap (an empty layout when
+   only set 3 is used and there is no heap), 3 framebuffer fetch. */
+__attribute__((noinline)) static void nvmtl_db_cmd_bind_set(nvk_cmdbuf *c, nvk_pipeline *p)
+{
+    nvmtl_dbstate *s = nvmtl_db_state(c);
+    const nvmtl_dbplan *pl0 = (const nvmtl_dbplan *)p->dbplan[0], *pl1 = (const nvmtl_dbplan *)p->dbplan[1];
+    const int fetch_draw = p->fetch_mask && c->in_rp && !p->skip_draws, fetch = fetch_draw || p->fetch_zero;
+    if (fetch) { pthread_mutex_lock(&g_desc_lock); nvmtl_db_fetch_offsets_locked(); pthread_mutex_unlock(&g_desc_lock); }
+    uint32_t foff = 0;
+    if (!s || !pl0 || !pl1 || (fetch && (!g_db_fetch_ready || !g_dummyImg.view)) ||
+        nvmtl_db_reserve(s, nvmtl_db_worst(pl0, pl1, fetch ? g_db_fetch_size : 0)) ||
+        nvmtl_db_stage(c, s, 0, pl0, p->tabneed[0]) || nvmtl_db_stage(c, s, 1, pl1, p->tabneed[1])) goto fail;
+    if (fetch_draw || (p->fetch_zero && s->fz_gen != s->gen)) {
+        uint8_t *dst = nvmtl_db_alloc(s, g_db_fetch_size, &foff);
+        if (!dst) goto fail;
+        const uint32_t mask = fetch_draw ? p->fetch_mask : (1u << NVMTL_NCOL) - 1;
+        for (uint32_t i = 0; i < NVMTL_NCOL; i++) {
+            if (!(mask & (1u << i))) continue;
+            // as nvmtl_fetch_set / nvmtl_fetch_zero_set: a colour attachment the pass does not have reads the dummy
+            const int have = fetch_draw && c->fetchview[i];
+            nvmtl_db_get_image(NVMTL_DBT_INPUT, have ? c->fetchview[i] : g_dummyImg.view,
+                               have ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, dst + g_db_fetch_off[i]);
+        }
+        if (!fetch_draw) { s->fz_off = foff; s->fz_gen = s->gen; }
+    } else if (p->fetch_zero) foff = s->fz_off;
+    c->nobind = 0;
+    nvmtl_db_bind_buffers(c, s);
+    if (g_sample_locations && c->sample_pattern.count)
+        pvkCmdPushConstants(c->cb, (VkPipelineLayout)p->layout, VK_SHADER_STAGE_FRAGMENT_BIT, NVMTL_SAMPLE_POSITION_OFFSET,
+                           NVMTL_SAMPLE_POSITION_BYTES, c->sample_pattern.position);
+    const uint32_t idx[4] = { 0, 0, g_heap_ready ? 1u : 0u, 0 }, off[4] = { s->off[0], s->off[1], 0, foff };
+    nvmtl_db_set_offsets(c, s, 0, (VkPipelineLayout)p->layout, fetch ? 4u : g_heap_ready ? 3u : 2u, idx, off);
+    c->semu_layout = p->stencil_emu ? p->layout : NULL;
+    c->fetch_draw = 0;
+    if (p->skip_draws) { c->nobind = 1; return; }
+    if (fetch_draw) { nvmtl_fetch_barrier(c); c->fetch_draw = 1; }
+    return;
+fail:
+    { static int said; if (said++ < 4) nvlog("vk: descriptor buffer: no descriptor memory for a draw - it is not recorded"); }
+    // counted: the command buffer then ends with an error instead of running without the draw (fix30)
+    c->skipped++; c->skip_oom++; c->nobind = 1;
+}
+/* Compute: the sets of the nvmtl_vk_cmd_dispatch* calls in the buffer model. 0, or -1 (the dispatch is not recorded) */
+__attribute__((noinline)) static int nvmtl_db_bind_compute(nvk_cmdbuf *c, const nvk_pipeline *p)
+{
+    nvmtl_dbstate *s = nvmtl_db_state(c);
+    const nvmtl_dbplan *pl0 = (const nvmtl_dbplan *)p->dbplan[0], *pl1 = (const nvmtl_dbplan *)p->dbplan[1];
+    if (!s || !pl0 || !pl1 || nvmtl_db_reserve(s, nvmtl_db_worst(pl0, pl1, 0)) ||
+        nvmtl_db_stage(c, s, 0, pl0, p->tabneed[0]) || nvmtl_db_stage(c, s, 1, pl1, p->tabneed[1])) {
+        static int said; if (said++ < 4) nvlog("vk: descriptor buffer: no descriptor memory for a dispatch - it is not recorded");
+        c->skipped++; c->skip_oom++; c->nobind = 1; return -1;
+    }
+    c->nobind = 0;
+    nvmtl_db_bind_buffers(c, s);
+    const uint32_t idx[3] = { 0, 0, g_heap_ready ? 1u : 0u }, off[3] = { s->off[0], s->off[1], 0 };
+    nvmtl_db_set_offsets(c, s, 1, (VkPipelineLayout)p->layout, g_heap_ready ? 3u : 2u, idx, off);
+    return 0;
+}
+/* NVMTL_DBUF_CENSUS=1: the totals, at every 256th retired command buffer that used the model */
+static void nvmtl_db_census(void)
+{
+    static int on = -1; if (on < 0) { const char *e = getenv("NVMTL_DBUF_CENSUS"); on = e && e[0] == '1'; }
+    static _Atomic unsigned long long retired;
+    if (!on || (atomic_fetch_add(&retired, 1) & 255)) return;
+    const unsigned long long n = atomic_load(&g_db_regions);
+    nvlog("vk: descriptor buffer census: %llu regions, %llu reused, %llu descriptors made, %llu pages (+%llu large), %u layouts",
+          n, (unsigned long long)atomic_load(&g_db_reuse), (unsigned long long)atomic_load(&g_db_gen),
+          (unsigned long long)atomic_load(&g_db_pages), (unsigned long long)atomic_load(&g_db_bigpages), g_dbplan_n);
+}
diff --git a/plugin/nvmtl_gputime.h b/plugin/nvmtl_gputime.h
new file mode 100644
index 0000000..ce6a99b
--- /dev/null
+++ b/plugin/nvmtl_gputime.h
@@ -0,0 +1,364 @@
+/* GPUTIME (fix29, gpuperf): where the GPU time of a frame goes, by category, from GPU timestamps.
+ *
+ * Switched on and off at run time by the diag flag file /tmp/nvmtl-gputime (a regular file owned by this process's
+ * user or root, polled every 250 ms; non-release builds only). While it is on, every command buffer begun gets a
+ * timestamp query pool and a timestamp at each boundary of its work: its start, each render pass begin and end, each
+ * change between compute dispatches, transfers (copies, blits, clears, fills) and barrier-only stretches, and its end.
+ * The segments between two timestamps are summed when the command buffer retires (its fence has signalled), and every
+ * 300 frames (or 3 s) the totals are logged as "GPUTIME" lines in the plugin log:
+ *   - frames and fps (frames = presents: -[NSOpenGLContext flushBuffer] or a Metal drawable's present),
+ *   - GPU busy in this process's command buffers (the union of their [start, end] intervals) as a share of the wall,
+ *     and per frame; the idle time between them,
+ *   - per kind: render passes, compute, transfers, barrier-only stretches (a pipeline drain: the flushes and stalls
+ *     between two pieces of work), empty stretches,
+ *   - the render passes grouped by shape (size, colour/depth formats, samples, load mask, first fragment shaders),
+ *     largest first, with count, ms per frame, us each, draws and vertices,
+ *   - transfers by operation mix, and the time by submitter (who submitted the command buffer).
+ * The timestamps are written bottom-of-pipe (a PIPE_CONTROL post-sync write on ANV) and only outside render passes, so a
+ * segment is the time from the end of the previous piece of work to the end of this one. Render passes already begin
+ * and end with ALL_COMMANDS dependencies (a pipeline drain), so the extra timestamps add little; the overhead is logged
+ * as the timestamps per frame. Command buffers begun while the flag is off are not timed.
+ *
+ * Off: each wrapped vkCmd* entry point costs one relaxed atomic load. */
+#if !NVMTL_RELEASE
+#define GPT_TS 768                  /* segments per command buffer; the pool holds GPT_TS + 1 timestamps */
+#define GPT_TAB 1024                /* command buffers being recorded or in flight with a record (power of two) */
+#define GPT_KEYS 128                /* render pass shapes per report */
+#define GPT_IV 16384                /* command buffer intervals per report */
+enum { GPT_NONE, GPT_RP, GPT_CS, GPT_XF };
+enum { GPX_COPYBUF = 1, GPX_BUF2IMG = 2, GPX_IMG2BUF = 4, GPX_FILL = 8, GPX_CLRCOL = 16, GPX_CLRDS = 32, GPX_BLIT = 64, GPX_COPYIMG = 128 };
+static const char *const g_gpx_name[8] = { "copybuf", "buf2img", "img2buf", "fill", "clearcolour", "cleardepth", "blit", "copyimg" };
+typedef struct { uint8_t kind, samples, ncol, npipe; uint16_t ops, ld; uint32_t w, h, cfmt, dfmt, n, nbar, nlay; uint64_t work; uint32_t fs[2]; } gpt_seg;
+typedef struct gpt_cb { struct gpt_cb *next; VkCommandBuffer cb; VkQueryPool pool; unsigned cur, nts, ended; const char *who; gpt_seg seg[GPT_TS]; } gpt_cb;
+
+static _Atomic int g_gpt_live;                 /* records in the table: 0 = every wrapper goes straight through */
+static _Atomic uint64_t g_gpt_frames;
+static _Atomic int g_gpt_reset;                /* switched on again: the totals start a new window */
+static os_unfair_lock g_gpt_tlk = OS_UNFAIR_LOCK_INIT;
+static gpt_cb *g_gpt_tab[GPT_TAB];
+static gpt_cb *g_gpt_free; static unsigned g_gpt_nfree;
+
+void nvmtl_gpt_frame(void) { atomic_fetch_add_explicit(&g_gpt_frames, 1, memory_order_relaxed); }
+static int nvmtl_gpt_armed(void)
+{
+    static int was;
+    const int on = nvmtl_diag_flag("gputime") && g_timestamp_bits && g_lim.timestampPeriod > 0;
+    if (on != was) { was = on; if (on) atomic_store(&g_gpt_reset, 1);
+        nvlog("GPUTIME %s (/tmp/nvmtl-gputime)", on ? "ON: command buffers begun from now on are timed" : "OFF"); }
+    return on;
+}
+static inline unsigned gpt_home(VkCommandBuffer b) { const uintptr_t v = (uintptr_t)b; return (unsigned)((v >> 4) ^ (v >> 14) ^ (v >> 24)) & (GPT_TAB - 1); }
+static gpt_cb *gpt_find(VkCommandBuffer b)
+{
+    if (!atomic_load_explicit(&g_gpt_live, memory_order_relaxed) || !b) return NULL;
+    gpt_cb *g = NULL;
+    os_unfair_lock_lock(&g_gpt_tlk);
+    for (unsigned i = gpt_home(b), k = 0; k < GPT_TAB && g_gpt_tab[i]; i = (i + 1) & (GPT_TAB - 1), k++)
+        if (g_gpt_tab[i]->cb == b) { g = g_gpt_tab[i]; break; }
+    os_unfair_lock_unlock(&g_gpt_tlk);
+    return g;
+}
+static int gpt_insert(gpt_cb *g)
+{
+    os_unfair_lock_lock(&g_gpt_tlk);
+    if (atomic_load(&g_gpt_live) >= GPT_TAB / 2) { os_unfair_lock_unlock(&g_gpt_tlk); return -1; }
+    unsigned i = gpt_home(g->cb); while (g_gpt_tab[i]) i = (i + 1) & (GPT_TAB - 1);
+    g_gpt_tab[i] = g; atomic_fetch_add(&g_gpt_live, 1);
+    os_unfair_lock_unlock(&g_gpt_tlk);
+    return 0;
+}
+static gpt_cb *gpt_remove(VkCommandBuffer b)   /* linear probing with backward-shift deletion */
+{
+    if (!atomic_load(&g_gpt_live) || !b) return NULL;
+    gpt_cb *g = NULL;
+    os_unfair_lock_lock(&g_gpt_tlk);
+    unsigned i = gpt_home(b), k = 0;
+    for (; k < GPT_TAB && g_gpt_tab[i]; i = (i + 1) & (GPT_TAB - 1), k++) if (g_gpt_tab[i]->cb == b) { g = g_gpt_tab[i]; break; }
+    if (g) {
+        unsigned j = i;
+        for (;;) {
+            j = (j + 1) & (GPT_TAB - 1);
+            if (!g_gpt_tab[j]) break;
+            const unsigned h = gpt_home(g_gpt_tab[j]->cb);
+            /* move j back to i unless its home lies cyclically in (i, j] */
+            const int keep = i <= j ? (h > i && h <= j) : (h > i || h <= j);
+            if (!keep) { g_gpt_tab[i] = g_gpt_tab[j]; i = j; }
+        }
+        g_gpt_tab[i] = NULL; atomic_fetch_sub(&g_gpt_live, 1);
+    }
+    os_unfair_lock_unlock(&g_gpt_tlk);
+    return g;
+}
+static void gpt_recycle(gpt_cb *g)
+{
+    if (g->pool && g_host_query_reset) pvkResetQueryPool(g_dev, g->pool, 0, GPT_TS + 1);
+    os_unfair_lock_lock(&g_gpt_tlk);
+    if (g->pool && g_host_query_reset && g_gpt_nfree < 32) { g->next = g_gpt_free; g_gpt_free = g; g_gpt_nfree++; g = NULL; }
+    os_unfair_lock_unlock(&g_gpt_tlk);
+    if (g) { if (g->pool) pvkDestroyQueryPool(g_dev, g->pool, NULL); free(g); }
+}
+/* the original entry points, taken over by nvmtl_gpt_wrap */
+static PFN_vkCmdWriteTimestamp o_gpt_ts;
+static int gpt_ts(gpt_cb *g)   /* close segment cur, open cur + 1 (NONE) */
+{
+    if (g->cur + 1 >= GPT_TS) return 0;
+    o_gpt_ts(g->cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g->pool, g->cur + 1);
+    g->cur++; memset(&g->seg[g->cur], 0, sizeof g->seg[0]);
+    return 1;
+}
+static gpt_seg *gpt_kind(gpt_cb *g, int kind)
+{
+    gpt_seg *s = &g->seg[g->cur];
+    if (s->kind == kind && kind != GPT_RP) return s;
+    if (s->kind == GPT_NONE && !s->n && !s->nbar) { s->kind = (uint8_t)kind; return s; }   /* nothing ran since the last stamp */
+    if (!gpt_ts(g)) return &g->seg[g->cur];   /* full: the rest goes into the last segment */
+    s = &g->seg[g->cur]; s->kind = (uint8_t)kind; return s;
+}
+void nvmtl_gpt_begin(nvk_cmdbuf *c)
+{
+    if (!c || !c->cb || !o_gpt_ts || !nvmtl_gpt_armed()) return;
+    gpt_cb *g = NULL;
+    os_unfair_lock_lock(&g_gpt_tlk);
+    if (g_gpt_free) { g = g_gpt_free; g_gpt_free = g->next; g_gpt_nfree--; }
+    os_unfair_lock_unlock(&g_gpt_tlk);
+    int fresh = 0;
+    if (!g) {
+        g = (gpt_cb *)calloc(1, sizeof *g); if (!g) return;
+        VkQueryPoolCreateInfo qi = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO, NULL, 0, VK_QUERY_TYPE_TIMESTAMP, GPT_TS + 1, 0 };
+        if (pvkCreateQueryPool(g_dev, &qi, NULL, &g->pool) != VK_SUCCESS) { free(g); return; }
+        if (g_host_query_reset) pvkResetQueryPool(g_dev, g->pool, 0, GPT_TS + 1); else fresh = 1;
+    }
+    g->cb = (VkCommandBuffer)c->cb; g->cur = 0; g->nts = 0; g->ended = 0; g->who = NULL; memset(&g->seg[0], 0, sizeof g->seg[0]);
+    if (fresh) pvkCmdResetQueryPool(g->cb, g->pool, 0, GPT_TS + 1);
+    o_gpt_ts(g->cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g->pool, 0);
+    if (gpt_insert(g)) gpt_recycle(g);
+}
+int nvmtl_gpt_on_cb(void *cb) { return gpt_find((VkCommandBuffer)cb) != NULL; }
+/* the render pass just begun: its shape (nvmtl_vk_cmd_begin_pass) */
+void nvmtl_gpt_pass(void *cb, uint32_t w, uint32_t h, uint32_t cfmt, uint32_t ncol, uint32_t dfmt, uint32_t samples, uint32_t load)
+{
+    gpt_cb *g = gpt_find((VkCommandBuffer)cb); if (!g) return;
+    gpt_seg *s = &g->seg[g->cur]; if (s->kind != GPT_RP) return;
+    s->w = w; s->h = h; s->cfmt = cfmt; s->ncol = (uint8_t)ncol; s->dfmt = dfmt; s->samples = (uint8_t)samples; s->ld = (uint16_t)load;
+}
+/* a pipeline bound in the open pass: its fragment shader's hash (the ptpso line names its SPIR-V file) */
+void nvmtl_gpt_fs(void *cb, uint32_t fs)
+{
+    gpt_cb *g = gpt_find((VkCommandBuffer)cb); if (!g) return;
+    gpt_seg *s = &g->seg[g->cur]; if (s->kind != GPT_RP) return;
+    if (s->fs[0] == fs || s->fs[1] == fs) return;
+    if (!s->fs[0]) s->fs[0] = fs; else if (!s->fs[1]) s->fs[1] = fs;
+    if (s->npipe < 255) s->npipe++;
+}
+/* before vkEndCommandBuffer, outside a render pass */
+void nvmtl_gpt_end(void *cb, const char *who)
+{
+    gpt_cb *g = gpt_find((VkCommandBuffer)cb); if (!g || g->ended) return;
+    gpt_seg *s = &g->seg[g->cur];
+    if (g->cur && s->kind == GPT_NONE && !s->n && !s->nbar) g->nts = g->cur + 1;   /* the last stamp ends it */
+    else { o_gpt_ts(g->cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, g->pool, g->cur + 1); g->nts = g->cur + 2; }
+    g->who = who; g->ended = 1;
+}
+
+/* ---- totals ---- */
+typedef struct { uint32_t w, h, cfmt, dfmt, fs0, fs1; uint16_t ld; uint8_t samples, ncol; uint64_t n, ns, mx, draws, work, npipe; } gpt_key;
+static os_unfair_lock g_gpa_lk = OS_UNFAIR_LOCK_INIT;
+static struct {
+    uint64_t t0, f0, ncb, nts, nfull, nnr;
+    uint64_t kind_ns[6], kind_n[6], kind_work[6];   /* NONE-with-barriers (sync), RP, CS, XF, NONE empty, barriers in all */
+    uint64_t lay;                                     /* layout transitions */
+    gpt_key key[GPT_KEYS]; unsigned nkey; uint64_t key_lost_ns;
+    struct { uint16_t ops; uint64_t n, ns, bytes; } xf[24]; unsigned nxf;
+    struct { const char *who; uint64_t n, ns; } who[16]; unsigned nwho;
+    struct { uint64_t a, b; } iv[GPT_IV]; unsigned niv;
+} g_gpa;
+static int gpt_ivcmp(const void *x, const void *y) { const uint64_t a = *(const uint64_t *)x, b = *(const uint64_t *)y; return a < b ? -1 : a > b; }
+static int gpt_keycmp(const void *x, const void *y) { const gpt_key *a = x, *b = y; return a->ns < b->ns ? 1 : a->ns > b->ns ? -1 : 0; }
+static void gpt_report(uint64_t now)
+{
+    const uint64_t frames = atomic_load(&g_gpt_frames) - g_gpa.f0; const double wall = (double)(now - g_gpa.t0);
+    const double per = frames ? (double)frames : 1.0; const char *unit = frames ? "/frame" : " total";
+    /* GPU busy: union of the command buffers' intervals (ticks) */
+    qsort(g_gpa.iv, g_gpa.niv, sizeof g_gpa.iv[0], gpt_ivcmp);
+    const uint64_t mask = g_timestamp_bits >= 64 ? ~0ull : ((1ull << g_timestamp_bits) - 1);
+    double busy = 0, idle = 0; uint64_t end = 0;
+    for (unsigned i = 0; i < g_gpa.niv; i++) {
+        const uint64_t a = g_gpa.iv[i].a, b = g_gpa.iv[i].b;
+        if (!i) { busy += (double)((b - a) & mask); end = b; continue; }
+        if (a >= end) { idle += (double)(a - end); busy += (double)(b - a); end = b; }
+        else if (b > end) { busy += (double)(b - end); end = b; }
+    }
+    const double tp = g_lim.timestampPeriod; busy *= tp; idle *= tp;
+    const double span = g_gpa.niv ? (double)((end - g_gpa.iv[0].a) & mask) * tp : 0;
+    nvlog_keep("GPUTIME %.2f s: %llu frames (%.1f fps), %llu cbs (%.1f%s), GPU busy in this process %.1f%% of wall = %.3f ms%s; idle between its cbs %.3f ms%s (%.1f%% of its span); %.1f timestamps%s%s%s",
+               wall / 1e9, (unsigned long long)frames, frames * 1e9 / wall, (unsigned long long)g_gpa.ncb, g_gpa.ncb / per, unit,
+               100.0 * busy / wall, busy / per / 1e6, unit, idle / per / 1e6, unit, span > 0 ? 100.0 * idle / span : 0.0, g_gpa.nts / per, unit,
+               g_gpa.nfull ? " (some cbs ran out of timestamps)" : "", g_gpa.nnr ? " (some results not ready)" : "");
+    static const char *const kname[5] = { "barrier-only", "render passes", "compute", "transfers", "empty" };
+    char b[1200]; int k = 0;
+    for (int i = 1; i <= 4; i++) {
+        const int j = i == 4 ? 0 : i;
+        k += snprintf(b + k, sizeof b - (size_t)k, " %s %.3f ms (%.1f%s)%s", kname[j], g_gpa.kind_ns[j] / per / 1e6, g_gpa.kind_n[j] / per, unit, i < 4 ? " |" : "");
+    }
+    k += snprintf(b + k, sizeof b - (size_t)k, " | empty %.3f ms | barriers %.1f%s, layout transitions %.1f%s, dispatch groups %.0f%s",
+                  g_gpa.kind_ns[4] / per / 1e6, g_gpa.kind_n[5] / per, unit, g_gpa.lay / per, unit, g_gpa.kind_work[GPT_CS] / per, unit);
+    nvlog_keep("GPUTIME  by kind%s:%s", unit, b);
+    qsort(g_gpa.key, g_gpa.nkey, sizeof g_gpa.key[0], gpt_keycmp);
+    for (unsigned i = 0; i < g_gpa.nkey && i < 14; i++) {
+        const gpt_key *q = &g_gpa.key[i];
+        nvlog_keep("GPUTIME  pass %4ux%-4u c%u fmt %3u d %3u s%u ld 0x%02x fs %08x %08x: %.2f%s, %.3f ms%s (%.1f%%), %.0f us each (max %.0f), %.0f draws %.0f verts each, %.1f pipelines",
+                   q->w, q->h, q->ncol, q->cfmt, q->dfmt, q->samples, q->ld, q->fs0, q->fs1, q->n / per, unit, q->ns / per / 1e6, unit,
+                   busy > 0 ? 100.0 * q->ns / busy : 0.0, q->ns / 1e3 / (double)q->n, q->mx / 1e3, (double)q->draws / q->n, (double)q->work / q->n, (double)q->npipe / q->n);
+    }
+    if (g_gpa.nkey > 14 || g_gpa.key_lost_ns) {
+        uint64_t rest = g_gpa.key_lost_ns, rn = 0; for (unsigned i = 14; i < g_gpa.nkey; i++) { rest += g_gpa.key[i].ns; rn += g_gpa.key[i].n; }
+        nvlog_keep("GPUTIME  pass (other %u shapes): %.2f%s, %.3f ms%s", g_gpa.nkey > 14 ? g_gpa.nkey - 14 : 0, rn / per, unit, rest / per / 1e6, unit);
+    }
+    k = 0;
+    for (unsigned i = 0; i < g_gpa.nxf && k < (int)sizeof b - 160; i++) {
+        char ops[96]; int o = 0; ops[0] = 0;
+        for (int j = 0; j < 8; j++) if (g_gpa.xf[i].ops & (1u << j)) o += snprintf(ops + o, sizeof ops - (size_t)o, "%s%s", o ? "+" : "", g_gpx_name[j]);
+        k += snprintf(b + k, sizeof b - (size_t)k, " [%s %.2f%s %.3f ms %.2f MB each]", ops, g_gpa.xf[i].n / per, unit, g_gpa.xf[i].ns / per / 1e6,
+                      g_gpa.xf[i].n ? g_gpa.xf[i].bytes / 1048576.0 / g_gpa.xf[i].n : 0.0);
+    }
+    if (k) nvlog_keep("GPUTIME  transfers%s:%s", unit, b);
+    k = 0;
+    for (unsigned i = 0; i < g_gpa.nwho && k < (int)sizeof b - 120; i++)
+        k += snprintf(b + k, sizeof b - (size_t)k, " [%s: %.2f cbs %.3f ms]", g_gpa.who[i].who ? g_gpa.who[i].who : "?", g_gpa.who[i].n / per, g_gpa.who[i].ns / per / 1e6);
+    if (k) nvlog_keep("GPUTIME  by submitter%s:%s", unit, b);
+    memset(&g_gpa, 0, sizeof g_gpa);
+    g_gpa.t0 = now; g_gpa.f0 = atomic_load(&g_gpt_frames);
+}
+static void gpt_collect(gpt_cb *g)
+{
+    uint64_t r[GPT_TS + 1];
+    const unsigned n = g->nts;
+    if (n < 2) return;
+    const VkResult q = pvkGetQueryPoolResults(g_dev, g->pool, 0, n, sizeof(uint64_t) * n, r, 8, VK_QUERY_RESULT_64_BIT);
+    const uint64_t mask = g_timestamp_bits >= 64 ? ~0ull : ((1ull << g_timestamp_bits) - 1);
+    const double tp = g_lim.timestampPeriod;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    os_unfair_lock_lock(&g_gpa_lk);
+    if (atomic_exchange(&g_gpt_reset, 0)) memset(&g_gpa, 0, sizeof g_gpa);
+    if (!g_gpa.t0) { g_gpa.t0 = now; g_gpa.f0 = atomic_load(&g_gpt_frames); }
+    if (q != VK_SUCCESS) { g_gpa.nnr++; os_unfair_lock_unlock(&g_gpa_lk); return; }
+    g_gpa.ncb++; g_gpa.nts += n; if (g->cur + 1 >= GPT_TS) g_gpa.nfull++;
+    if (g_gpa.niv < GPT_IV) { g_gpa.iv[g_gpa.niv].a = r[0]; g_gpa.iv[g_gpa.niv].b = r[n - 1]; g_gpa.niv++; }
+    uint64_t cbns = 0;
+    for (unsigned i = 0; i + 1 < n; i++) {
+        const gpt_seg *s = &g->seg[i];
+        const uint64_t ns = (uint64_t)((double)((r[i + 1] - r[i]) & mask) * tp); cbns += ns;
+        const int kind = s->kind == GPT_NONE ? (s->nbar ? 0 : 4) : s->kind;
+        g_gpa.kind_ns[kind] += ns; g_gpa.kind_n[kind]++; g_gpa.kind_work[kind] += s->work;
+        g_gpa.kind_n[5] += s->nbar; g_gpa.lay += s->nlay;
+        if (s->kind == GPT_RP) {
+            unsigned j = 0;
+            for (; j < g_gpa.nkey; j++) { const gpt_key *q2 = &g_gpa.key[j];
+                if (q2->w == s->w && q2->h == s->h && q2->cfmt == s->cfmt && q2->dfmt == s->dfmt && q2->ld == s->ld && q2->samples == s->samples &&
+                    q2->ncol == s->ncol && q2->fs0 == s->fs[0]) break; }
+            if (j == g_gpa.nkey && j < GPT_KEYS) { gpt_key *q2 = &g_gpa.key[g_gpa.nkey++]; memset(q2, 0, sizeof *q2);
+                q2->w = s->w; q2->h = s->h; q2->cfmt = s->cfmt; q2->dfmt = s->dfmt; q2->ld = s->ld; q2->samples = s->samples; q2->ncol = s->ncol;
+                q2->fs0 = s->fs[0]; q2->fs1 = s->fs[1]; }
+            if (j < g_gpa.nkey) { gpt_key *q2 = &g_gpa.key[j]; q2->n++; q2->ns += ns; if (ns > q2->mx) q2->mx = ns; q2->draws += s->n; q2->work += s->work; q2->npipe += s->npipe;
+                if (!q2->fs1 && s->fs[1]) q2->fs1 = s->fs[1]; }
+            else g_gpa.key_lost_ns += ns;
+        } else if (s->kind == GPT_XF) {
+            unsigned j = 0; for (; j < g_gpa.nxf && g_gpa.xf[j].ops != s->ops; j++) {}
+            if (j == g_gpa.nxf && j < 24) { g_gpa.xf[j].ops = s->ops; g_gpa.nxf++; }
+            if (j < g_gpa.nxf) { g_gpa.xf[j].n++; g_gpa.xf[j].ns += ns; g_gpa.xf[j].bytes += s->work; }
+        }
+    }
+    { unsigned j = 0; for (; j < g_gpa.nwho && g_gpa.who[j].who != g->who; j++) {}
+      if (j == g_gpa.nwho && j < 16) { g_gpa.who[j].who = g->who; g_gpa.nwho++; }
+      if (j < g_gpa.nwho) { g_gpa.who[j].n++; g_gpa.who[j].ns += cbns; } }
+    const uint64_t frames = atomic_load(&g_gpt_frames) - g_gpa.f0;
+    if (frames >= 300 || now - g_gpa.t0 >= 3000000000ull) gpt_report(now);
+    os_unfair_lock_unlock(&g_gpa_lk);
+}
+/* from nvmtl_cmd_retire: an ended record whose fence signalled is summed; any record is dropped */
+void nvmtl_gpt_retire(void *cb)
+{
+    gpt_cb *g = gpt_remove((VkCommandBuffer)cb); if (!g) return;
+    if (g->ended) gpt_collect(g);
+    gpt_recycle(g);
+}
+
+/* ---- the wrapped entry points ---- */
+#define GPT_DECL(f) static PFN_##f o_gpt_##f;
+GPT_DECL(vkCmdBeginRenderPass) GPT_DECL(vkCmdEndRenderPass) GPT_DECL(vkCmdDispatch) GPT_DECL(vkCmdDispatchIndirect) GPT_DECL(vkCmdDraw)
+GPT_DECL(vkCmdDrawIndexed) GPT_DECL(vkCmdDrawIndirect) GPT_DECL(vkCmdDrawIndexedIndirect) GPT_DECL(vkCmdPipelineBarrier) GPT_DECL(vkCmdCopyBuffer)
+GPT_DECL(vkCmdCopyBufferToImage) GPT_DECL(vkCmdCopyImageToBuffer) GPT_DECL(vkCmdFillBuffer) GPT_DECL(vkCmdClearColorImage)
+GPT_DECL(vkCmdClearDepthStencilImage) GPT_DECL(vkCmdBlitImage) GPT_DECL(vkCmdCopyImage)
+#undef GPT_DECL
+static void VKAPI_CALL gpt_BeginRenderPass(VkCommandBuffer b, const VkRenderPassBeginInfo *i, VkSubpassContents c)
+{
+    gpt_cb *g = gpt_find(b);
+    if (g) { gpt_seg *s = gpt_kind(g, GPT_RP); if (s->kind == GPT_RP && i) { s->w = i->renderArea.extent.width; s->h = i->renderArea.extent.height; } }
+    o_gpt_vkCmdBeginRenderPass(b, i, c);
+}
+static void VKAPI_CALL gpt_EndRenderPass(VkCommandBuffer b)
+{
+    o_gpt_vkCmdEndRenderPass(b);
+    gpt_cb *g = gpt_find(b); if (g) (void)gpt_ts(g);
+}
+static inline void gpt_add(VkCommandBuffer b, int kind, uint16_t op, uint64_t work)
+{
+    gpt_cb *g = gpt_find(b); if (!g) return;
+    gpt_seg *s = kind == GPT_RP ? &g->seg[g->cur] : gpt_kind(g, kind);
+    s->n++; s->work += work; s->ops |= op;
+}
+static void VKAPI_CALL gpt_Dispatch(VkCommandBuffer b, uint32_t x, uint32_t y, uint32_t z) { gpt_add(b, GPT_CS, 0, (uint64_t)x * y * z); o_gpt_vkCmdDispatch(b, x, y, z); }
+static void VKAPI_CALL gpt_DispatchIndirect(VkCommandBuffer b, VkBuffer f, VkDeviceSize o) { gpt_add(b, GPT_CS, 0, 0); o_gpt_vkCmdDispatchIndirect(b, f, o); }
+static void VKAPI_CALL gpt_Draw(VkCommandBuffer b, uint32_t a, uint32_t c, uint32_t d, uint32_t e) { gpt_add(b, GPT_RP, 0, (uint64_t)a * c); o_gpt_vkCmdDraw(b, a, c, d, e); }
+static void VKAPI_CALL gpt_DrawIndexed(VkCommandBuffer b, uint32_t a, uint32_t c, uint32_t d, int32_t e, uint32_t f) { gpt_add(b, GPT_RP, 0, (uint64_t)a * c); o_gpt_vkCmdDrawIndexed(b, a, c, d, e, f); }
+static void VKAPI_CALL gpt_DrawIndirect(VkCommandBuffer b, VkBuffer f, VkDeviceSize o, uint32_t n, uint32_t s) { gpt_add(b, GPT_RP, 0, 0); o_gpt_vkCmdDrawIndirect(b, f, o, n, s); }
+static void VKAPI_CALL gpt_DrawIndexedIndirect(VkCommandBuffer b, VkBuffer f, VkDeviceSize o, uint32_t n, uint32_t s) { gpt_add(b, GPT_RP, 0, 0); o_gpt_vkCmdDrawIndexedIndirect(b, f, o, n, s); }
+static void VKAPI_CALL gpt_PipelineBarrier(VkCommandBuffer b, VkPipelineStageFlags ss, VkPipelineStageFlags ds, VkDependencyFlags f, uint32_t nm, const VkMemoryBarrier *m,
+                                           uint32_t nb, const VkBufferMemoryBarrier *bb, uint32_t ni, const VkImageMemoryBarrier *im)
+{
+    gpt_cb *g = gpt_find(b);
+    if (g) { gpt_seg *s = &g->seg[g->cur]; s->nbar++; for (uint32_t k = 0; k < ni; k++) if (im[k].oldLayout != im[k].newLayout) s->nlay++; }
+    o_gpt_vkCmdPipelineBarrier(b, ss, ds, f, nm, m, nb, bb, ni, im);
+}
+static uint64_t gpt_bic_bytes(uint32_t n, const VkBufferImageCopy *r) { uint64_t t = 0; for (uint32_t i = 0; i < n; i++) t += (uint64_t)r[i].imageExtent.width * r[i].imageExtent.height * r[i].imageExtent.depth * 4; return t; }
+static void VKAPI_CALL gpt_CopyBuffer(VkCommandBuffer b, VkBuffer s, VkBuffer d, uint32_t n, const VkBufferCopy *r)
+{ uint64_t t = 0; for (uint32_t i = 0; i < n; i++) t += r[i].size; gpt_add(b, GPT_XF, GPX_COPYBUF, t); o_gpt_vkCmdCopyBuffer(b, s, d, n, r); }
+static void VKAPI_CALL gpt_CopyBufferToImage(VkCommandBuffer b, VkBuffer s, VkImage d, VkImageLayout l, uint32_t n, const VkBufferImageCopy *r)
+{ gpt_add(b, GPT_XF, GPX_BUF2IMG, gpt_bic_bytes(n, r)); o_gpt_vkCmdCopyBufferToImage(b, s, d, l, n, r); }
+static void VKAPI_CALL gpt_CopyImageToBuffer(VkCommandBuffer b, VkImage s, VkImageLayout l, VkBuffer d, uint32_t n, const VkBufferImageCopy *r)
+{ gpt_add(b, GPT_XF, GPX_IMG2BUF, gpt_bic_bytes(n, r)); o_gpt_vkCmdCopyImageToBuffer(b, s, l, d, n, r); }
+static void VKAPI_CALL gpt_FillBuffer(VkCommandBuffer b, VkBuffer d, VkDeviceSize o, VkDeviceSize s, uint32_t v)
+{ gpt_add(b, GPT_XF, GPX_FILL, s == VK_WHOLE_SIZE ? 0 : s); o_gpt_vkCmdFillBuffer(b, d, o, s, v); }
+static void VKAPI_CALL gpt_ClearColorImage(VkCommandBuffer b, VkImage i, VkImageLayout l, const VkClearColorValue *c, uint32_t n, const VkImageSubresourceRange *r)
+{ gpt_add(b, GPT_XF, GPX_CLRCOL, 0); o_gpt_vkCmdClearColorImage(b, i, l, c, n, r); }
+static void VKAPI_CALL gpt_ClearDepthStencilImage(VkCommandBuffer b, VkImage i, VkImageLayout l, const VkClearDepthStencilValue *c, uint32_t n, const VkImageSubresourceRange *r)
+{ gpt_add(b, GPT_XF, GPX_CLRDS, 0); o_gpt_vkCmdClearDepthStencilImage(b, i, l, c, n, r); }
+static void VKAPI_CALL gpt_BlitImage(VkCommandBuffer b, VkImage s, VkImageLayout sl, VkImage d, VkImageLayout dl, uint32_t n, const VkImageBlit *r, VkFilter f)
+{ gpt_add(b, GPT_XF, GPX_BLIT, 0); o_gpt_vkCmdBlitImage(b, s, sl, d, dl, n, r, f); }
+static void VKAPI_CALL gpt_CopyImage(VkCommandBuffer b, VkImage s, VkImageLayout sl, VkImage d, VkImageLayout dl, uint32_t n, const VkImageCopy *r)
+{ uint64_t t = 0; for (uint32_t i = 0; i < n; i++) t += (uint64_t)r[i].extent.width * r[i].extent.height * r[i].extent.depth * 4;
+  gpt_add(b, GPT_XF, GPX_COPYIMG, t); o_gpt_vkCmdCopyImage(b, s, sl, d, dl, n, r); }
+/* after vkCreateDevice and the hitch/census wrappers: ours go on top */
+static void nvmtl_gpt_wrap(void)
+{
+    if (!pvkCmdWriteTimestamp || !pvkCreateQueryPool || !pvkGetQueryPoolResults) return;
+    o_gpt_ts = pvkCmdWriteTimestamp;
+#define GPT_W(f, w) do { o_gpt_##f = p##f; p##f = w; } while (0)
+    GPT_W(vkCmdBeginRenderPass, gpt_BeginRenderPass); GPT_W(vkCmdEndRenderPass, gpt_EndRenderPass); GPT_W(vkCmdDispatch, gpt_Dispatch);
+    GPT_W(vkCmdDispatchIndirect, gpt_DispatchIndirect); GPT_W(vkCmdDraw, gpt_Draw); GPT_W(vkCmdDrawIndexed, gpt_DrawIndexed);
+    GPT_W(vkCmdDrawIndirect, gpt_DrawIndirect); GPT_W(vkCmdDrawIndexedIndirect, gpt_DrawIndexedIndirect); GPT_W(vkCmdPipelineBarrier, gpt_PipelineBarrier);
+    GPT_W(vkCmdCopyBuffer, gpt_CopyBuffer); GPT_W(vkCmdCopyBufferToImage, gpt_CopyBufferToImage); GPT_W(vkCmdCopyImageToBuffer, gpt_CopyImageToBuffer);
+    GPT_W(vkCmdFillBuffer, gpt_FillBuffer); GPT_W(vkCmdClearColorImage, gpt_ClearColorImage); GPT_W(vkCmdClearDepthStencilImage, gpt_ClearDepthStencilImage);
+    GPT_W(vkCmdBlitImage, gpt_BlitImage); GPT_W(vkCmdCopyImage, gpt_CopyImage);
+#undef GPT_W
+}
+#else
+void nvmtl_gpt_frame(void) {}
+static inline void nvmtl_gpt_begin(nvk_cmdbuf *c) { (void)c; }
+int nvmtl_gpt_on_cb(void *cb) { (void)cb; return 0; }
+void nvmtl_gpt_pass(void *cb, uint32_t w, uint32_t h, uint32_t cfmt, uint32_t ncol, uint32_t dfmt, uint32_t samples, uint32_t load) { (void)cb, (void)w, (void)h, (void)cfmt, (void)ncol, (void)dfmt, (void)samples, (void)load; }
+void nvmtl_gpt_fs(void *cb, uint32_t fs) { (void)cb, (void)fs; }
+void nvmtl_gpt_end(void *cb, const char *who) { (void)cb, (void)who; }
+void nvmtl_gpt_retire(void *cb) { (void)cb; }
+static inline void nvmtl_gpt_wrap(void) {}
+#endif
diff --git a/plugin/nvmtl_recover.h b/plugin/nvmtl_recover.h
new file mode 100644
index 0000000..aa782d8
--- /dev/null
+++ b/plugin/nvmtl_recover.h
@@ -0,0 +1,183 @@
+/*
+ * GPU reset recovery of the Metal plugin's Vulkan backend (nvmtl_vk.c includes this once, after g_state and g_dev).
+ * Kept apart so tests/recover_unit.c can run the state machine on the host against a mock Mesa entry point.
+ * Needs, from the includer: g_state, g_dev, nvlog, and later definitions of nvmtl_submit_mutex (recursive) and
+ * nvmtl_sub_done.
+ */
+#ifndef NVMTL_RECOVER_H
+#define NVMTL_RECOVER_H
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+static pthread_mutex_t nvmtl_submit_mutex;
+static void nvmtl_sub_done(uint64_t s);
+/* GPU reset recovery (nvmtl_vk_recover, after nvmtl_vk_submit_begin_at): the device generation, +1 each time the banned
+   exec queue was replaced; a submission remembers the generation it went to the GPU in. While a recovery swaps the
+   queue, fence waits hold off (nvmtl_wait_enter): anv asks the kernel about each queue's ban after every wait, and a
+   waiter that asked about the old queue just after it was destroyed would mark the device lost again. */
+static _Atomic unsigned g_loss_gen;
+static _Atomic int g_recovering, g_fence_waiters;
+static void nvmtl_wait_enter(void)
+{
+    for (;;) {
+        while (atomic_load(&g_recovering)) usleep(200);
+        atomic_fetch_add(&g_fence_waiters, 1);
+        if (!atomic_load(&g_recovering)) return;
+        atomic_fetch_sub(&g_fence_waiters, 1);
+    }
+}
+static void nvmtl_wait_leave(void) { atomic_fetch_sub(&g_fence_waiters, 1); }
+
+/* GPU reset recovery (Mesa anv_nvmtl_recover.c): a banned exec queue replaced by a fresh one on the same VM */
+struct nvmtl_anv_recover_info { uint32_t size, was_lost, queues_banned, queues_replaced; int32_t error; uint32_t failed_step; };
+#define NVMTL_ANV_RECOVER_FORCE (1u << 0)
+#define NVMTL_ANV_RECOVER_QUERY (1u << 1)
+static VkResult (*panv_recover)(VkDevice, uint32_t, struct nvmtl_anv_recover_info *);
+
+/* ---- GPU reset recovery ------------------------------------------------------------------------------------------
+   B580.kext follows xe: a hang resets the guilty context, the kernel bans that exec queue and signals every fence it
+   handed out; a GT reset bans the queues whose work had started and replays the rest. The VM, every BO and every GPU
+   address survive, and Linux userspace goes on with a new exec queue on the same VM. anv reports the ban as
+   VK_ERROR_DEVICE_LOST, final for a VkDevice; this plugin used to switch its backend off for the rest of the process
+   (g_state -1), after which -[MTLCommandQueue commandBuffer] returned nil and WindowServer died on CoreDisplay's "Failed
+   to get a MTLCommandBuffer" assert: a GPU hang logged the user out.
+   Now, as on Apple's drivers after a GPU restart: the command buffers that were on the GPU end with an error (the one
+   whose wait saw the loss "Caused GPU Hang Error", the others "Discarded (victim of GPU error/recovery)"), their
+   completion handlers run, and the device keeps working. Mesa's nvmtl_anv_device_recover_v1 replaces the banned exec
+   queue on the same VkDevice (same VM), so every Vulkan handle, GPU address and CPU mapping the plugin and its
+   applications hold stays valid; nothing is re-created or re-imported. A new VkDevice is no option: it would be a new
+   VM (no dma-buf on macOS), and Metal applications keep gpuAddress values and contents pointers into the old one.
+   Bounded: at most NVMTL_RECOVER_MAX recoveries (default 3) in 60 s and 16 per process; past that, or when Mesa has no
+   entry point or the replacement fails three times, the backend goes down as before. NVMTL_GPU_RECOVERY=0: as before.
+   Tests (never in WindowServer): NVMTL_FAKE_DEVICE_LOST=N[:M] reports the N-th successful fence wait (then every M-th)
+   as VK_ERROR_DEVICE_LOST, NVMTL_FAKE_SUBMIT_LOST=N[:M] the N-th vkQueueSubmit (not made); a faked loss replaces the
+   queue for real (NVMTL_ANV_RECOVER_FORCE, after the old queue went idle). */
+static pthread_mutex_t g_recover_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned g_recoveries, g_recover_window_n; static uint64_t g_recover_window_t0;
+static _Atomic unsigned long long g_lost_hang, g_lost_victim;
+static int nvmtl_recover_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("NVMTL_GPU_RECOVERY"); on = !(e && e[0] == '0'); }
+    return on;
+}
+static unsigned nvmtl_recover_max(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NVMTL_RECOVER_MAX"); v = e && *e ? atoi(e) : 3; if (v < 0) v = 0; if (v > 16) v = 16; }
+    return (unsigned)v;
+}
+/* NVMTL_FAKE_DEVICE_LOST / NVMTL_FAKE_SUBMIT_LOST: "N" or "N:M" - fires at the N-th event, then every M-th */
+typedef struct { const char *env; int parsed; unsigned long long first, every; _Atomic unsigned long long n; } nvmtl_fake;
+static nvmtl_fake g_fake_wait = { "NVMTL_FAKE_DEVICE_LOST" }, g_fake_submit = { "NVMTL_FAKE_SUBMIT_LOST" };
+static int nvmtl_fake_fire(nvmtl_fake *k)
+{
+    if (!k->parsed) {
+        const char *e = getenv(k->env); char *end = NULL;
+        const char *me = getprogname();
+        if (me && !strcmp(me, "WindowServer")) e = NULL;   // never in WindowServer
+        if (e && *e) { k->first = strtoull(e, &end, 10); if (end && *end == ':') k->every = strtoull(end + 1, NULL, 10); }
+        if (k->first) nvlog("vk: GPU recovery TEST: %s=%s - a VK_ERROR_DEVICE_LOST is faked at event %llu%s", k->env, e,
+                            k->first, k->every ? " and periodically after it" : "");
+        k->parsed = 1;
+    }
+    if (!k->first) return 0;
+    const unsigned long long i = atomic_fetch_add(&k->n, 1) + 1;
+    return i == k->first || (k->every && i > k->first && (i - k->first) % k->every == 0);
+}
+/* Tests (in-process, staged bundle): fake a loss at the `after`-th next successful fence wait (submit 0) or vkQueueSubmit
+   (submit 1). Looked up with dlsym by tests/mtl_recover.m; does nothing in WindowServer. */
+void nvmtl_vk_fake_lost_arm(int submit, unsigned long long after)
+{
+    const char *me = getprogname();
+    if (me && !strcmp(me, "WindowServer")) return;
+    nvmtl_fake *k = submit ? &g_fake_submit : &g_fake_wait;
+    k->parsed = 1; k->every = 0; atomic_store(&k->n, 0); k->first = after;
+    nvlog("vk: GPU recovery TEST: a VK_ERROR_DEVICE_LOST is faked at the %llu-th next %s", after, submit ? "vkQueueSubmit" : "successful fence wait");
+}
+/* The device was seen lost (or a fence gave up) by a submission of generation `gen`. Returns 2 when this call replaced
+   the queue, 1 when it is usable without that (another thread recovered it, or nothing was lost), 0 when it is not: the
+   backend is then down (g_state -1), as before recovery existed. Takes nvmtl_submit_mutex (recursive: a submitter may
+   hold it) so no submission runs while the queue is swapped, then drains the fence waiters (2 s at most). */
+static int nvmtl_vk_recover(unsigned gen, int injected, const char *where, VkResult why)
+{
+    if (!nvmtl_recover_on() || !panv_recover) {
+        static int said; if (!said++) nvlog("vk: GPU recovery unavailable (%s) - a lost device disables the backend", !panv_recover
+            ? "the Vulkan driver has no nvmtl_anv_device_recover_v1" : "NVMTL_GPU_RECOVERY=0");
+        return 0;
+    }
+    int ok = 0;
+    pthread_mutex_lock(&nvmtl_submit_mutex);
+    pthread_mutex_lock(&g_recover_lock);
+    if (atomic_load(&g_loss_gen) != gen) { ok = g_state == 1; goto out; }   // recovered since that submission
+    if (g_state != 1) goto out;
+    const uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (!g_recover_window_t0 || now - g_recover_window_t0 > 60000000000ull) { g_recover_window_t0 = now; g_recover_window_n = 0; }
+    if (g_recover_window_n >= nvmtl_recover_max() || g_recoveries >= 16) {
+        nvlog("vk: GPU RECOVERY REFUSED in %s: %u recoveries in the last %llu s, %u in all (limit %u per minute, 16 in all) - "
+              "disabling backend (%s -> %d)", getprogname(), g_recover_window_n, (unsigned long long)((now - g_recover_window_t0) / 1000000000ull),
+              g_recoveries, nvmtl_recover_max(), where, why);
+        g_state = -1; goto out;
+    }
+    atomic_store(&g_recovering, 1);
+    const uint64_t d0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    while (atomic_load(&g_fence_waiters) > 0 && clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - d0 < 2000000000ull) usleep(500);
+    const int still = atomic_load(&g_fence_waiters);
+    struct nvmtl_anv_recover_info info; VkResult r = VK_ERROR_UNKNOWN; int attempt = 0;
+    for (; attempt < 3; attempt++) {
+        memset(&info, 0, sizeof info); info.size = sizeof info;
+        r = panv_recover(g_dev, injected ? NVMTL_ANV_RECOVER_FORCE : 0, &info);
+        if (r == VK_SUCCESS) break;
+        usleep(100000);
+    }
+    const uint64_t d1 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    if (r == VK_SUCCESS && (info.queues_replaced || info.was_lost)) {
+        g_recoveries++; g_recover_window_n++;
+        atomic_fetch_add(&g_loss_gen, 1);
+        ok = 2;
+        nvlog("vk: GPU RECOVERY #%u in %s after %s -> %d%s: device was %s, %u exec queue(s) banned, %u queue(s) replaced on the same VM "
+              "in %.1f ms (%d attempt(s), %d fence waiter(s) still in the driver); in-flight command buffers end with an error, new ones run",
+              g_recoveries, getprogname(), where, why, injected ? " (FAKED by NVMTL_FAKE_*)" : "", info.was_lost ? "lost" : "not lost",
+              info.queues_banned, info.queues_replaced, (d1 - d0) / 1e6, attempt + 1, still);
+    } else if (r == VK_SUCCESS) {
+        ok = 1;   // nothing lost and nothing banned (a fence that gave up): the command buffer fails, the device goes on
+        nvlog("vk: GPU recovery check in %s after %s -> %d: device not lost, no queue banned - only that command buffer fails", getprogname(), where, why);
+    } else {
+        g_state = -1;
+        nvlog("vk: GPU RECOVERY FAILED in %s after %s -> %d: nvmtl_anv_device_recover_v1 -> %d (step %u, errno %d, %u banned) %d times - "
+              "disabling backend", getprogname(), where, why, r, info.failed_step, info.error, info.queues_banned, attempt);
+    }
+    atomic_store(&g_recovering, 0);
+out:
+    pthread_mutex_unlock(&g_recover_lock);
+    pthread_mutex_unlock(&nvmtl_submit_mutex);
+    return ok;
+}
+/* What a lost submission reports: -3 its wait saw the loss and recovered the device (Metal: GPU hang error), -4 it was
+   in flight when another submission's loss was recovered (innocent victim), -5 its fence gave up while the device
+   reports neither a loss nor a ban (Metal: GPU timeout error; the job may still run), -2 the backend is down. A lost
+   submission is over for the GPU (banned: dropped by the kernel; faked: waited for), so its number is marked done and
+   the descriptor and buffer reuse watermark moves on; a timed-out one is not. Resources stay quarantined by the caller. */
+static int nvmtl_vk_lost(uint64_t subseq, unsigned gen, int injected, const char *where, VkResult why)
+{
+    const int timed_out = why == VK_TIMEOUT;
+    const int rec = atomic_load(&g_loss_gen) != gen ? (g_state == 1 ? 1 : 0) : nvmtl_vk_recover(gen, injected, where, why);
+    if (!rec) return -2;
+    if (timed_out && rec == 1 && atomic_load(&g_loss_gen) == gen) return -5;
+    nvmtl_sub_done(subseq);
+    if (rec == 2) { atomic_fetch_add(&g_lost_hang, 1); return -3; }
+    const unsigned long long n = atomic_fetch_add(&g_lost_victim, 1) + 1;
+    if (n <= 8 || !(n & (n - 1))) nvlog("vk: a command buffer in flight across a GPU recovery ends with an error (%s -> %d; %llu so far)", where, why, n);
+    return -4;
+}
+int nvmtl_vk_recover_counts(unsigned *recoveries, unsigned *gen, unsigned long long *hang, unsigned long long *victim)
+{
+    if (recoveries) *recoveries = g_recoveries;
+    if (gen) *gen = atomic_load(&g_loss_gen);
+    if (hang) *hang = atomic_load(&g_lost_hang);
+    if (victim) *victim = atomic_load(&g_lost_victim);
+    return g_state == 1 ? 0 : -1;
+}
+#endif
diff --git a/plugin/nvmtl_spec_fc.h b/plugin/nvmtl_spec_fc.h
new file mode 100644
index 0000000..8d14cd9
--- /dev/null
+++ b/plugin/nvmtl_spec_fc.h
@@ -0,0 +1,100 @@
+// Function-constant values into a module whose function constants are specialization constants
+// (nvmtl_translate_fc_spec, translator wrapper spec_fc.rs). The values become the specialization constants' defaults,
+// which is exactly what VkSpecializationInfo would do: the driver folds them before it compiles. The SpecIds are read
+// from the module's decorations:
+//   0x00800000 | (index << 3) | lane    value of function constant `index`, lane `lane`
+//   0x01000000 | index                  1 when function constant `index` has a value (is_function_constant_defined)
+// (other specialization constants, such as a kernel's workgroup size at SpecId 0-3, are not touched)
+// Values are little-endian bytes as Metal holds them (MTLFunctionConstantValues), lane after lane.
+#pragma once
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define NVMTL_SPEC_DEFINED 0x01000000u
+#define NVMTL_SPEC_VALUE 0x00800000u
+
+// Returns a malloc'ed copy of the module with the values applied (*out_words words), or NULL on a malformed module.
+// *applied counts the specialization constants that took a supplied value (definedness included).
+// freeze: the specialization constants become plain constants (OpSpecConstant* -> OpConstant*, SpecId decorations
+// dropped), the module then is exactly a module translated with the values; otherwise they stay specialization
+// constants whose defaults are the values.
+static uint32_t *nvmtl_spec_fc_apply_ex(const uint32_t *w, size_t n, const uint32_t *idx, const uint32_t *sz,
+                                        const uint8_t *const *pay, size_t count, size_t *out_words, unsigned *applied, int freeze);
+static uint32_t *nvmtl_spec_fc_apply(const uint32_t *w, size_t n, const uint32_t *idx, const uint32_t *sz,
+                                     const uint8_t *const *pay, size_t count, size_t *out_words, unsigned *applied)
+{
+    return nvmtl_spec_fc_apply_ex(w, n, idx, sz, pay, count, out_words, applied, 0);
+}
+static uint32_t *nvmtl_spec_fc_apply_ex(const uint32_t *w, size_t n, const uint32_t *idx, const uint32_t *sz,
+                                        const uint8_t *const *pay, size_t count, size_t *out_words, unsigned *applied, int freeze)
+{
+    if (applied) *applied = 0;
+    if (n < 5 || w[0] != 0x07230203u) return NULL;
+    const uint32_t bound = w[3];
+    if (!bound || bound > (1u << 26)) return NULL;
+    uint32_t *spec = calloc(bound, sizeof *spec);      // id -> SpecId + 1 (0: none)
+    uint32_t *tinfo = calloc(bound, sizeof *tinfo);    // type id -> bits | signed << 8 | float << 9 (0: not a scalar)
+    uint32_t *out = malloc(n * sizeof *out);
+    if (!spec || !tinfo || !out) { free(spec); free(tinfo); free(out); return NULL; }
+    memcpy(out, w, n * sizeof *out);
+    for (size_t i = 5; i < n;) {
+        const uint32_t op = w[i] & 0xffffu, wc = w[i] >> 16;
+        if (!wc || i + wc > n) { free(spec); free(tinfo); free(out); return NULL; }
+        if (op == 71 && wc == 4 && w[i + 2] == 1 && w[i + 1] < bound) spec[w[i + 1]] = w[i + 3] + 1;      // OpDecorate SpecId
+        else if (op == 21 && wc == 4 && w[i + 1] < bound) tinfo[w[i + 1]] = (w[i + 2] & 0xff) | (w[i + 3] ? 1u << 8 : 0); // OpTypeInt
+        else if (op == 22 && wc >= 3 && w[i + 1] < bound) tinfo[w[i + 1]] = (w[i + 2] & 0xff) | 1u << 9;          // OpTypeFloat
+        else if (op == 54) break;                                                                               // OpFunction: no more
+        i += wc;
+    }
+    for (size_t i = 5; i < n;) {
+        const uint32_t op = w[i] & 0xffffu, wc = w[i] >> 16;
+        if (op == 54) break;
+        // OpSpecConstantTrue / OpSpecConstantFalse / OpSpecConstant
+        if ((op == 48 || op == 49 || op == 50) && wc >= 3 && w[i + 2] < bound && spec[w[i + 2]]) {
+            const uint32_t sid = spec[w[i + 2]] - 1;
+            if (!(sid & (NVMTL_SPEC_DEFINED | NVMTL_SPEC_VALUE))) { spec[w[i + 2]] = 0; i += wc; continue; }   // not ours
+            const uint32_t index = (sid & NVMTL_SPEC_DEFINED) ? (sid & ~NVMTL_SPEC_DEFINED) : (sid & ~NVMTL_SPEC_VALUE) >> 3, lane = sid & 7;
+            const uint8_t *v = NULL; uint32_t vlen = 0;
+            for (size_t k = 0; k < count; k++) if (idx[k] == index) { v = pay[k]; vlen = sz[k]; break; }
+            if (sid & NVMTL_SPEC_DEFINED) {
+                if (op != 50) { out[i] = (wc << 16) | (v ? 48u : 49u); if (v && applied) (*applied)++; }
+            } else if (v && op != 50) {                                  // a bool-typed constant: one byte per lane
+                if (lane < vlen) { out[i] = (wc << 16) | (v[lane] ? 48u : 49u); if (applied) (*applied)++; }
+            } else if (v && op == 50 && w[i + 1] < bound && tinfo[w[i + 1]]) {
+                const uint32_t ti = tinfo[w[i + 1]], bits = ti & 0xff, bytes = bits / 8;
+                if (bytes && (lane + 1) * bytes <= vlen && ((bits <= 32 && wc == 4) || (bits == 64 && wc == 5))) {
+                    uint64_t x = 0;
+                    memcpy(&x, v + lane * bytes, bytes);
+                    if (bits < 32 && (ti & (1u << 8)) && (x >> (bits - 1)) & 1) x |= ~0ull << bits;   // signed: sign-extend
+                    out[i + 3] = (uint32_t)x;
+                    if (bits == 64) out[i + 4] = (uint32_t)(x >> 32);
+                    if (applied) (*applied)++;
+                }
+            }
+        }
+        i += wc;
+    }
+    if (freeze) {   // after the values are in: plain constants, and the SpecId decorations go
+        // spec[id] is nonzero only for ours now; a composite is frozen when all its constituents are
+        size_t o = 5;
+        for (size_t i = 5; i < n;) {
+            const uint32_t op = out[i] & 0xffffu, wc = out[i] >> 16;
+            if (op == 71 && wc == 4 && out[i + 2] == 1 && out[i + 1] < bound && spec[out[i + 1]]) { i += wc; continue; }   // our SpecId
+            uint32_t nop = op;
+            if ((op == 48 || op == 49 || op == 50) && wc >= 3 && out[i + 2] < bound && spec[out[i + 2]])
+                nop = op == 48 ? 41u : op == 49 ? 42u : 43u;                                       // Spec* -> Constant*
+            else if (op == 51 && wc >= 3 && out[i + 2] < bound) {
+                int all = 1; for (uint32_t k = 3; k < wc; k++) if (out[i + k] >= bound || !spec[out[i + k]]) all = 0;
+                if (all) { nop = 44u; spec[out[i + 2]] = 1; }                                      // OpConstantComposite
+            }
+            memmove(out + o, out + i, wc * sizeof *out);
+            out[o] = (wc << 16) | nop;
+            o += wc; i += wc;
+        }
+        n = o;
+    }
+    free(spec); free(tinfo);
+    *out_words = n;
+    return out;
+}
