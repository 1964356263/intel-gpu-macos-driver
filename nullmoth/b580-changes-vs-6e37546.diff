@@ -0,0 +1,16 @@
+// fc_partial LL STAGE OUT idx=hex...: bake the given constants at AIR level, translate with the others unknown.
+use metal2vulkan::passes::{Stage, TransformOptions};
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let ll = std::fs::read_to_string(&a[1]).unwrap();
+    let st = match a[2].as_str() { "vertex" => Stage::Vertex, "fragment" => Stage::Fragment, _ => Stage::Kernel };
+    let mut vals = Vec::new();
+    for s in &a[4..] {
+        let (i, v) = s.split_once('=').unwrap();
+        vals.push((i.parse::<u32>().unwrap(), (0..v.len() / 2).map(|k| u8::from_str_radix(&v[2 * k..2 * k + 2], 16).unwrap()).collect::<Vec<u8>>()));
+    }
+    let t = std::time::Instant::now();
+    let sp = metal2vulkan::specialize_air_function_constants(&ll, &vals).unwrap();
+    let r = metal2vulkan::meta::with_function_constants_unknown(|| metal2vulkan::translate_native_no_retry_constructed_with_options(&sp, st, TransformOptions::default()));
+    match r { Ok(v) => { std::fs::write(&a[3], &v).unwrap(); println!("OK {} B {:?}", v.len(), t.elapsed()); } Err(e) => println!("ERR {e}") }
+}
diff --git a/translator/translator/examples/fc_two_stage.rs b/translator/translator/examples/fc_two_stage.rs
new file mode 100644
index 0000000..fe5501f
--- /dev/null
+++ b/translator/translator/examples/fc_two_stage.rs
@@ -0,0 +1,38 @@
+// fc_two_stage LL STAGE OUTDIR idx=hex...: time (a) AIR-level bake + full translation and (b) one generic translation
+// followed by SPIR-V-level specialization of the same constants; writes a.spv, generic.spv, b.spv.
+use metal2vulkan::passes::{Stage, TransformOptions};
+use std::time::Instant;
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let ll = std::fs::read_to_string(&a[1]).unwrap();
+    let st = match a[2].as_str() { "vertex" => Stage::Vertex, "fragment" => Stage::Fragment, _ => Stage::Kernel };
+    let out = std::path::PathBuf::from(&a[3]);
+    let mut vals = Vec::new();
+    for s in &a[4..] {
+        let (i, v) = s.split_once('=').unwrap();
+        let b: Vec<u8> = (0..v.len() / 2).map(|k| u8::from_str_radix(&v[2 * k..2 * k + 2], 16).unwrap()).collect();
+        vals.push((i.parse::<u32>().unwrap(), b));
+    }
+    let fcs = metal2vulkan::meta::parse_function_constants(&ll);
+    println!("declared {} first {:?}", fcs.len(), fcs.first().map(|f| (f.index, f.type_name.clone(), f.abi_type_encoding.clone())));
+    let t = Instant::now();
+    let sp = metal2vulkan::specialize_air_function_constants(&ll, &vals).unwrap();
+    let t_spec = t.elapsed();
+    println!("specialized: owned {} len {} -> {}", matches!(sp, std::borrow::Cow::Owned(_)), ll.len(), sp.len());
+    std::fs::write(out.join("specialized.ll"), sp.as_bytes()).unwrap();
+    let ra = metal2vulkan::translate_native_no_retry_constructed_with_options(&sp, st, TransformOptions::default());
+    println!("A bake+translate: spec {:?}, total {:?}, {}", t_spec, t.elapsed(), ra.as_ref().map(|v| v.len().to_string()).unwrap_or_else(|e| e.clone()));
+    if let Ok(v) = &ra { std::fs::write(out.join("a.spv"), v).unwrap(); }
+    let t = Instant::now();
+    let rg = metal2vulkan::translate_native_no_retry_constructed_with_options(&ll, st, TransformOptions::default());
+    println!("B generic translate: {:?}, {}", t.elapsed(), rg.as_ref().map(|v| v.len().to_string()).unwrap_or_else(|e| e.clone()));
+    if let Ok(g) = &rg {
+        std::fs::write(out.join("generic.spv"), g).unwrap();
+        for _ in 0..3 {
+            let t = Instant::now();
+            let rb = metal2vulkan::specialize_function_constant_bytes(g, &vals);
+            println!("B spir-v specialize: {:?}, {}", t.elapsed(), rb.as_ref().map(|v| v.len().to_string()).unwrap_or_else(|e| e.clone()));
+            if let Ok(v) = &rb { std::fs::write(out.join("b.spv"), v).unwrap(); }
+        }
+    }
+}
