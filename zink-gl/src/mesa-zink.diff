+/* Driver scratch dwords in ANV_VID_MEM_AV1_ENCODE_BRC_DATA, past the 64 bytes the kernel writes there */
+#define ANV_AV1_BRC_SCRATCH_LF_LEVELS  2048 /* AVP_INLOOP_FILTER_STATE DW1 as the kernel wrote it, then a mask */
+#define ANV_AV1_BRC_SCRATCH_CDEF_BITS  2056 /* AVP_INLOOP_FILTER_STATE DW5 as the kernel wrote it, then a mask */
+#define ANV_AV1_BRC_SCRATCH_LEB128     2064 /* the tile group obu_size leb128 */
+
+/* Per-frame BRC state the AV1 encode records against. */
+struct anv_av1_brc_frame {
+   bool enabled;
+   /* the kernel back-annotates the loop filter levels (header length then known only on the GPU) */
+   bool lf_update;
+   /* the kernel picks the CDEF parameters, cdef_bits included (header length then known only on the GPU) */
+   bool cdef_update;
+   struct anv_av1_brc_slb_layout layout;
+   struct anv_state slb_in;
+   struct anv_state pak_insert_in;
+   struct anv_state update_dmem;
+   /* media-driver runs two PAK passes with BRC (EncodeAv1VdencFeatureManager::SetPassNum): the second BRC update
+    * sees the first pass's size and may ask for a re-encode (HUC_STATUS bit 31) */
+   bool two_pass;
+   struct anv_state update_dmem_pass1;
+   struct anv_state const_data;
+   struct vk_video_av1_frame_hdr_layout hdr;
+   uint32_t pak_insert_size;
+};
