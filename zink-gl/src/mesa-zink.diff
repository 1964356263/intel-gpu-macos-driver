+/* The initial state of one queue's hardware contexts (its exec queue and, for compute and copy queues, the companion
+ * RCS one). Also used by nvmtl_anv_device_recover_v1 (anv_nvmtl_recover.c) when a banned exec queue is replaced by a
+ * fresh one on the same VM: a new context starts from the kernel's default image and needs this state again.
+ */
+VkResult
+genX(init_queue_state)(struct anv_queue *queue)
+{
+   struct anv_device *device = queue->device;
+   VkResult res;
+
+   switch (queue->family->engine_class) {
+   case INTEL_ENGINE_CLASS_RENDER:
+      res = init_render_queue_state(queue, false /* is_companion_rcs_batch */);
+      break;
+   case INTEL_ENGINE_CLASS_COMPUTE: {
+      res = init_compute_queue_state(queue);
+      if (res != VK_SUCCESS)
+         return res;
+
+      /**
+       * Execute RCS init batch by default on the companion RCS command buffer in
+       * order to support MSAA copy/clear operations on compute queue.
+       */
+      res = init_render_queue_state(queue, true /* is_companion_rcs_batch */);
+      break;
+   }
+   case INTEL_ENGINE_CLASS_VIDEO:
+      res = init_copy_video_queue_state(queue);
+      break;
+   case INTEL_ENGINE_CLASS_COPY:
+      res = init_copy_video_queue_state(queue);
+      if (res != VK_SUCCESS)
+         return res;
+
+      /**
+       * Execute RCS init batch by default on the companion RCS command buffer in
+       * order to support MSAA copy/clear operations on copy queue.
+       */
+      res = init_render_queue_state(queue, true /* is_companion_rcs_batch */);
+      break;
+   default:
+      res = vk_error(device, VK_ERROR_INITIALIZATION_FAILED);
+      break;
+   }
+   return res;
+}
