index 00000000000..5f53da41610
--- /dev/null
+++ b/src/intel/vulkan/anv_nvmtl_recover.c
@@ -0,0 +1,202 @@
+/*
+ * GPU-reset recovery for the nullmoth Metal plugin on B580.kext (macOS, xemac): a fresh exec queue on the same VM.
+ *
+ * On xe a hang is per context: the GuC resets the guilty context (CONTEXT_RESET_NOTIFICATION), the kernel bans that
+ * exec queue and signals every fence it handed out; a GT reset bans the queues whose work had started and replays the
+ * rest. The VM, its BOs and every GPU address stay valid, and Linux userspace goes on with a new exec queue on the same
+ * VM (iris_xe_replace_batch). anv instead reports VK_ERROR_DEVICE_LOST, which is final for a VkDevice. That is right
+ * for a Vulkan application, but the Metal plugin cannot make a new VkDevice behind an MTLDevice: a new device is a new
+ * VM (no dma-buf on macOS), and Metal applications hold GPU addresses (gpuAddress, argument buffers) and CPU pointers
+ * (contents) into the old one. WindowServer must keep its MTLDevice through a GPU restart the way it does on Apple's
+ * drivers (in-flight command buffers end with an error, new work runs).
+ *
+ * nvmtl_anv_device_recover_v1 does what Linux userspace does after a ban: each banned exec queue (and its companion RCS
+ * queue) is replaced by a new one on device->vm_id, the new context gets anv's initial queue state again
+ * (genX(init_queue_state)), the old queue is destroyed, and the queue and device lost flags are cleared. Nothing else of
+ * the device changes: every VkBuffer, VkImage, VkDeviceMemory, pipeline, descriptor set and command pool stays valid.
+ * What the cancelled work was writing is undefined, as after a GPU restart on Apple's drivers.
+ *
+ * The caller must make sure no other thread submits to, or waits on, this device's queues while it runs (the plugin
+ * holds its submit lock and drains its fence waiters). It is looked up with dlsym; a plugin that does not find it keeps
+ * the old behaviour (a lost device stays lost).
+ */
+#include "anv_private.h"
+
+#include "common/xe/intel_queue.h"
+#include "drm-uapi/xe_drm.h"
+
+#include "xe/anv_queue.h"
+
+#define NVMTL_ANV_RECOVER_FORCE (1u << 0)      /* replace every queue, banned or not (tests); waits for each to idle */
+#define NVMTL_ANV_RECOVER_QUERY (1u << 1)      /* only report bans and the lost state, change nothing */
+
+struct nvmtl_anv_recover_info {
+   uint32_t size;              /* in: sizeof(struct nvmtl_anv_recover_info) */
+   uint32_t was_lost;          /* out: the device was marked lost */
+   uint32_t queues_banned;     /* out: exec queues (main or companion) the kernel reports banned */
+   uint32_t queues_replaced;   /* out: anv queues that got new exec queues */
+   int32_t  error;             /* out: errno of the step that failed, 0 */
+   uint32_t failed_step;       /* out: 0 none, 1 ban query, 2 create, 3 init state, 4 not xe */
+};
+
+PUBLIC VkResult nvmtl_anv_device_recover_v1(VkDevice _device, uint32_t flags, struct nvmtl_anv_recover_info *info);
+
+/* 1 banned, 0 not, -errno: the query failed (an id the kernel does not know: treated as gone) */
+static int
+nvmtl_exec_queue_banned(struct anv_device *device, uint32_t exec_queue_id)
+{
+   if (!exec_queue_id)
+      return 0;
+   struct drm_xe_exec_queue_get_property p = {
+      .exec_queue_id = exec_queue_id,
+      .property = DRM_XE_EXEC_QUEUE_GET_PROPERTY_BAN,
+   };
+   if (intel_ioctl(device->fd, DRM_IOCTL_XE_EXEC_QUEUE_GET_PROPERTY, &p))
+      return -errno;
+   return p.value ? 1 : 0;
+}
+
+static void
+nvmtl_exec_queue_destroy(struct anv_device *device, uint32_t exec_queue_id, bool wait_idle)
+{
+   if (!exec_queue_id)
+      return;
+   /* A queue that was not banned (NVMTL_ANV_RECOVER_FORCE) may still run work the caller waits for: destroying it
+    * would kill that work. A banned one has nothing left (the kernel dropped and signalled its jobs). */
+   if (wait_idle)
+      anv_xe_wait_exec_queue_idle(device, exec_queue_id);
+   struct drm_xe_exec_queue_destroy d = { .exec_queue_id = exec_queue_id };
+   intel_ioctl(device->fd, DRM_IOCTL_XE_EXEC_QUEUE_DESTROY, &d);
+}
+
+/* The initial-state batch of the old context: done (its fence completes with the ban) or abandoned after 2 s. */
+static void
+nvmtl_drop_init_submit(struct anv_device *device, struct anv_async_submit **submit)
+{
+   if (!*submit)
+      return;
+   VkResult r = vk_sync_wait(&device->vk, (*submit)->signal.sync, (*submit)->signal.signal_value,
+                             VK_SYNC_WAIT_COMPLETE, os_time_get_absolute_timeout(2000000000ull));
+   if (r == VK_SUCCESS)
+      anv_async_submit_destroy(*submit);   /* else leaked: its BOs may still be in use */
+   *submit = NULL;
+}
+
+PUBLIC VkResult
+nvmtl_anv_device_recover_v1(VkDevice _device, uint32_t flags, struct nvmtl_anv_recover_info *info)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct nvmtl_anv_recover_info local = { .size = sizeof(local) };
+   if (!info || info->size < sizeof(*info))
+      info = &local;
+   const uint32_t size = info->size;
+   memset(info, 0, sizeof(*info));
+   info->size = size;
+
+   if (device->info->kmd_type != INTEL_KMD_TYPE_XE) {
+      info->failed_step = 4;
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+
+   info->was_lost = vk_device_is_lost_no_report(&device->vk) ? 1 : 0;
+
+   /* Which queues are banned. A failed query (EINVAL: the kernel no longer knows the id) counts as banned: the queue is
+    * unusable either way. */
+   bool replace[ANV_MAX_QUEUE_FAMILIES * 8] = { false };
+   const uint32_t nq = MIN2(device->queue_count, ARRAY_SIZE(replace));
+   for (uint32_t i = 0; i < nq; i++) {
+      struct anv_queue *queue = &device->queues[i];
+      const int b0 = nvmtl_exec_queue_banned(device, queue->exec_queue_id);
+      const int b1 = nvmtl_exec_queue_banned(device, queue->companion_rcs_id);
+      if (b0 != 0) info->queues_banned++;
+      if (b1 != 0) info->queues_banned++;
+      if (b0 < 0 || b1 < 0) info->error = -(b0 < 0 ? b0 : b1);
+      replace[i] = b0 != 0 || b1 != 0 || (flags & NVMTL_ANV_RECOVER_FORCE) ||
+                   /* lost without a ban (an exec ioctl failed): a fresh context, as iris does for any reset */
+                   (info->was_lost && vk_queue_is_lost(&queue->vk));
+   }
+   /* lost, but no queue says why (a device-level loss such as a query timeout): every queue gets a fresh context */
+   if (info->was_lost && !info->queues_banned) {
+      bool any = false;
+      for (uint32_t i = 0; i < nq; i++) any |= replace[i];
+      if (!any)
+         for (uint32_t i = 0; i < nq; i++) replace[i] = true;
+   }
+   if (flags & NVMTL_ANV_RECOVER_QUERY)
+      return VK_SUCCESS;
+
+   bool nothing = true;
+   for (uint32_t i = 0; i < nq; i++) nothing &= !replace[i];
+   if (nothing)
+      return info->was_lost ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+
+   VkResult result = VK_SUCCESS;
+   simple_mtx_lock(&device->mutex);   /* anv_queue_submit's lock: no submission sees half a swap */
+   for (uint32_t i = 0; i < nq && result == VK_SUCCESS; i++) {
+      if (!replace[i])
+         continue;
+      struct anv_queue *queue = &device->queues[i];
+      const bool idle = (flags & NVMTL_ANV_RECOVER_FORCE) && !info->was_lost &&
+                        !nvmtl_exec_queue_banned(device, queue->exec_queue_id);
+
+      /* the new exec queues first, into a copy: anv_xe_create_engine only reads the family and writes the ids */
+      const VkDeviceQueueCreateInfo qci = {
+         .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+         .flags = queue->vk.flags,
+         .queueFamilyIndex = queue->vk.queue_family_index,
+         .queueCount = 1,   /* no VkDeviceQueueGlobalPriorityCreateInfo: MEDIUM, what the plugin creates its queue with */
+      };
+      struct anv_queue fresh = *queue;
+      fresh.exec_queue_id = 0;
+      fresh.companion_rcs_id = 0;
+      fresh.bind_queue_id = 0;
+      result = anv_xe_create_engine(device, &fresh, &qci);
+      if (result != VK_SUCCESS) {
+         info->failed_step = 2;
+         info->error = errno;
+         nvmtl_exec_queue_destroy(device, fresh.exec_queue_id, false);
+         nvmtl_exec_queue_destroy(device, fresh.companion_rcs_id, false);
+         nvmtl_exec_queue_destroy(device, fresh.bind_queue_id, false);
+         break;
+      }
+
+      const uint32_t old_exec = queue->exec_queue_id, old_comp = queue->companion_rcs_id,
+                     old_bind = queue->bind_queue_id;
+      nvmtl_drop_init_submit(device, &queue->init_submit);
+      nvmtl_drop_init_submit(device, &queue->init_companion_submit);
+      if (idle) {   /* FORCE on a live queue: the old one finishes its work before the new one takes over */
+         anv_xe_wait_exec_queue_idle(device, old_exec);
+         if (old_comp)
+            anv_xe_wait_exec_queue_idle(device, old_comp);
+      }
+      p_atomic_set(&queue->exec_queue_id, fresh.exec_queue_id);
+      p_atomic_set(&queue->companion_rcs_id, fresh.companion_rcs_id);
+      p_atomic_set(&queue->bind_queue_id, fresh.bind_queue_id);
+      queue->vk._lost.lost = 0;
+
+      /* the new context starts from the kernel's default image: anv's initial state again, as at vkCreateDevice */
+      result = anv_genX(device->info, init_queue_state)(queue);
+      if (result != VK_SUCCESS) {
+         info->failed_step = 3;
+         info->error = errno;
+      }
+
+      nvmtl_exec_queue_destroy(device, old_exec, false);
+      nvmtl_exec_queue_destroy(device, old_comp, false);
+      nvmtl_exec_queue_destroy(device, old_bind, false);
+      if (result == VK_SUCCESS)
+         info->queues_replaced++;
+   }
+   if (result == VK_SUCCESS) {
+      /* every queue that needed it has a fresh context: the device is usable again */
+      for (uint32_t i = 0; i < nq; i++)
+         device->queues[i].vk._lost.lost = 0;
+      p_atomic_set(&device->vk._lost.lost, 0);
+      device->vk._lost.reported = false;
+   } else {
+      vk_device_set_lost(&device->vk, "nvmtl: exec queue replacement failed (step %u, errno %d)",
+                         info->failed_step, info->error);
+   }
+   simple_mtx_unlock(&device->mutex);
+   return result;
+}
diff --git a/src/intel/vulkan/anv_nvmtl_surface.c b/src/intel/vulkan/anv_nvmtl_surface.c
new file mode 100644
index 00000000000..feb9811627e
--- /dev/null
+++ b/src/intel/vulkan/anv_nvmtl_surface.c
@@ -0,0 +1,464 @@
+/*
+ * Implicit IOSurface synchronization for the nullmoth Metal plugin on B580.kext (macOS, xemac).
+ *
+ * B580.kext keeps, per IOSurface ID, the fences of the jobs that last wrote and read the surface (uapi/b580_drm.h, the
+ * dma-resv model). These entry points let the plugin, which only sees Vulkan objects, attach a submission's fence to a
+ * surface and import a surface's fences into a timeline semaphore it then waits on in vkQueueSubmit, so a consumer in
+ * another process (WindowServer compositing a game's frame) waits on the GPU instead of the producer waiting on the CPU.
+ * They are looked up with dlsym; a plugin that does not find them, or a kernel without B580_CAP_SURFACE_FENCES, keeps
+ * the CPU-side ordering.
+ */
+#include "anv_private.h"
+
+#include "vk_drm_syncobj.h"
+#include "vk_fence.h"
+#include "vk_semaphore.h"
+
+#include "drm-uapi/drm.h"
+#include "../../../../b580/uapi/b580_drm.h"
+
+#ifndef DRM_IOCTL_B580_SURFACE_VRAM   /* B580.kext gpuperf phase 1 (b580-surfvram uapi/b580_drm.h); older headers lack it */
+#define B580_CAP_SURFACE_VRAM 0xb5800002ull
+#define B580_SURFACE_VRAM_CREATE (1u << 0)
+#define B580_SURFACE_DIRTY_TRYLOCK (1u << 0)
+struct drm_b580_surface_vram {
+   __u32 surface_id;
+   __u32 plane;
+   __u64 size;
+   __u32 flags;
+   __u32 handle;
+   __u64 size_out;
+   __u32 gen;
+   __u32 pad;
+};
+struct drm_b580_surface_dirty {
+   __u32 surface_id;
+   __u32 plane;
+   __u32 flags;
+   __u32 pad;
+};
+#define DRM_B580_SURFACE_VRAM 0x53
+#define DRM_B580_SURFACE_DIRTY 0x54
+#define DRM_IOCTL_B580_SURFACE_VRAM DRM_IOWR(DRM_COMMAND_BASE + DRM_B580_SURFACE_VRAM, struct drm_b580_surface_vram)
+#define DRM_IOCTL_B580_SURFACE_DIRTY DRM_IOW(DRM_COMMAND_BASE + DRM_B580_SURFACE_DIRTY, struct drm_b580_surface_dirty)
+#endif
+
+#ifndef DRM_IOCTL_B580_SURFACE_VRAM2
+/* B580.kext (tile4) uAPI, uapi/b580_drm.h: a VRAM backing that carries the layout its creator renders with (a DRM format
+ * modifier and its pitch, like a Linux framebuffer), so importers (the window server's Metal plugin) build the same image
+ * and the kernel's CPU-lock page-off detiles it (XY_BLOCK_COPY_BLT Tile4 -> linear pages). GET_CAP
+ * B580_CAP_SURFACE_VRAM_LAYOUT = 1 once WindowServer imports with SURFACE_VRAM2. modifier: DRM_FORMAT_MOD_LINEAR or
+ * I915_FORMAT_MOD_4_TILED (uncompressed: the backing stays noComp); CREATE records it, an import gets it back. */
+#define B580_CAP_SURFACE_VRAM_LAYOUT 0xb5800003ull
+struct drm_b580_surface_vram2 {
+   __u32 surface_id;
+   __u32 plane;
+   __u64 size;
+   __u32 flags;
+   __u32 handle;      /* out */
+   __u64 size_out;    /* out */
+   __u32 gen;         /* out */
+   __u32 pad;
+   __u64 modifier;    /* in (CREATE) / out */
+   __u32 pitch;       /* in (CREATE) / out: bytes per row of the backing's layout */
+   __u32 cpp;         /* in (CREATE) / out */
+   __u32 width;       /* in (CREATE) / out */
+   __u32 height;      /* in (CREATE) / out */
+   __u32 linear_pitch;/* in (CREATE) / out: the IOSurface's bytesPerRow */
+   __u32 pad2;
+};
+#define DRM_B580_SURFACE_VRAM2 0x55
+#define DRM_IOCTL_B580_SURFACE_VRAM2 DRM_IOWR(DRM_COMMAND_BASE + DRM_B580_SURFACE_VRAM2, struct drm_b580_surface_vram2)
+#endif
+#ifndef DRM_FORMAT_MOD_LINEAR
+#define DRM_FORMAT_MOD_LINEAR 0ull
+#endif
+
+/* VRAM-shared IOSurfaces (gpuperf phase 2). The plugin stages a request, then calls vkAllocateMemory with a
+ * VkImportMemoryFdInfoKHR (OPAQUE_FD, any placeholder fd it owns, consumed on success) in the same thread: that import
+ * becomes the surface's VRAM backing (DRM_IOCTL_B580_SURFACE_VRAM), the way NVK's nvmtl_nvk_stage_import works. */
+struct nvmtl_anv_surface_vram_req {
+   uint32_t version;     /* 1, or 2: the caller reads tiled backings (the fields below) */
+   uint32_t surface_id, plane, flags;   /* flags: B580_SURFACE_VRAM_CREATE */
+   uint64_t size;        /* bytes the caller needs */
+   uint64_t size_out;    /* out: the backing's bytes */
+   uint32_t gen;         /* out: its generation */
+   int32_t err;          /* out: errno of the kernel call (0: imported) */
+   /* version 2, out: the layout the backing's creator renders with (SURFACE_VRAM2; modifier 0: linear at the IOSurface's
+    * own row pitch, also with a kernel that has no SURFACE_VRAM2). A version 1 caller only ever gets linear backings. */
+   uint64_t modifier;
+   uint32_t pitch, cpp, width, height, linear_pitch, pad;
+};
+PUBLIC VkResult nvmtl_anv_surface_vram_cap_v1(VkDevice _device, uint32_t *level);
+PUBLIC VkResult nvmtl_anv_surface_vram_stage_v1(VkDevice _device, struct nvmtl_anv_surface_vram_req *req);
+PUBLIC VkResult nvmtl_anv_surface_dirty_v1(VkDevice _device, uint32_t surface_id, uint32_t plane, uint32_t flags);
+
+PUBLIC VkResult nvmtl_anv_surface_cap_v1(VkDevice _device, uint32_t *supported);
+PUBLIC VkResult nvmtl_anv_surface_attach_v1(VkDevice _device, VkFence fence, VkSemaphore sem, uint64_t value,
+                                            uint32_t surface_id, uint32_t flags);
+PUBLIC VkResult nvmtl_anv_surface_import_v1(VkDevice _device, VkSemaphore sem, uint32_t surface_id, uint32_t flags,
+                                            uint64_t *wait_value, uint32_t *count);
+PUBLIC VkResult nvmtl_anv_surface_wait_v1(VkDevice _device, uint32_t surface_id, uint32_t flags, int64_t timeout_abs_ns);
+
+/* intel_ioctl restarts on EAGAIN, which ATTACH returns for a point that has no fence yet: retry on EINTR only */
+static int
+nvmtl_ioctl(int fd, unsigned long request, void *arg)
+{
+   int ret;
+   do {
+#ifdef HAVE_XEMAC
+      ret = xemac_ioctl(fd, request, arg);
+#else
+      ret = ioctl(fd, request, arg);
+#endif
+   } while (ret == -1 && errno == EINTR);
+   return ret;
+}
+
+static struct vk_drm_syncobj *
+nvmtl_syncobj_of(VkFence _fence, VkSemaphore _sem)
+{
+   struct vk_sync *sync = NULL;
+   if (_fence) {
+      VK_FROM_HANDLE(vk_fence, fence, _fence);
+      sync = vk_fence_get_active_sync(fence);
+   } else if (_sem) {
+      VK_FROM_HANDLE(vk_semaphore, sem, _sem);
+      sync = vk_semaphore_get_active_sync(sem);
+   }
+   return sync ? vk_sync_as_drm_syncobj(sync) : NULL;
+}
+
+static VkResult
+nvmtl_errno_result(int err)
+{
+   switch (err) {
+   case 0: return VK_SUCCESS;
+   case EAGAIN: return VK_NOT_READY;
+   case ETIME: case ETIMEDOUT: return VK_TIMEOUT;
+   case ENOSPC: case ENOMEM: return VK_ERROR_OUT_OF_HOST_MEMORY;
+   case ENOENT: case EINVAL: return VK_ERROR_UNKNOWN;
+   default: return VK_ERROR_FEATURE_NOT_PRESENT;
+   }
+}
+
+/* *supported = 1 when the kernel has the surface-fence ioctls (B580_CAP_SURFACE_FENCES). */
+PUBLIC VkResult
+nvmtl_anv_surface_cap_v1(VkDevice _device, uint32_t *supported)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct drm_get_cap cap = { .capability = B580_CAP_SURFACE_FENCES };
+   *supported = 0;
+   if (intel_ioctl(device->fd, DRM_IOCTL_GET_CAP, &cap))
+      return VK_SUCCESS;
+   *supported = cap.value == 1;
+   return VK_SUCCESS;
+}
+
+/* Attach the fence of `fence` (a binary syncobj), or of timeline semaphore `sem` at `value`, to surface `surface_id`
+ * as a B580_SURFACE_FENCE_WRITE or _READ user. VK_NOT_READY: not submitted yet (EAGAIN). */
+PUBLIC VkResult
+nvmtl_anv_surface_attach_v1(VkDevice _device, VkFence fence, VkSemaphore sem, uint64_t value, uint32_t surface_id,
+                            uint32_t flags)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct vk_drm_syncobj *s = nvmtl_syncobj_of(fence, sem);
+   if (!s)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   struct drm_b580_surface_fence_attach a = {
+      .surface_id = surface_id, .syncobj = s->syncobj, .point = fence ? 0 : value, .flags = flags,
+   };
+   return nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_ATTACH, &a) ? nvmtl_errno_result(errno) : VK_SUCCESS;
+}
+
+/* Add the fences of surface `surface_id` that a B580_SURFACE_FENCE_READER or _WRITER must wait for as new points of
+ * timeline semaphore `sem` (one used for nothing else). *wait_value: the point to wait on, 0 when there is nothing. */
+PUBLIC VkResult
+nvmtl_anv_surface_import_v1(VkDevice _device, VkSemaphore sem, uint32_t surface_id, uint32_t flags,
+                            uint64_t *wait_value, uint32_t *count)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   *wait_value = 0;
+   if (count)
+      *count = 0;
+   struct vk_drm_syncobj *s = nvmtl_syncobj_of(VK_NULL_HANDLE, sem);
+   if (!s || !(s->base.flags & VK_SYNC_IS_TIMELINE))
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   struct drm_b580_surface_fence_import m = { .surface_id = surface_id, .syncobj = s->syncobj, .flags = flags };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_IMPORT, &m))
+      return nvmtl_errno_result(errno);
+   *wait_value = m.count_out ? m.point_out : 0;
+   if (count)
+      *count = m.count_out;
+   return VK_SUCCESS;
+}
+
+/* Wait on the CPU until the fences of surface `surface_id` that `flags` names have signaled, or until
+ * `timeout_abs_ns` (CLOCK_UPTIME_RAW; 0 polls). VK_TIMEOUT when it ran out. */
+PUBLIC VkResult
+nvmtl_anv_surface_wait_v1(VkDevice _device, uint32_t surface_id, uint32_t flags, int64_t timeout_abs_ns)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct drm_b580_surface_fence_wait w = { .surface_id = surface_id, .flags = flags, .timeout_ns = timeout_abs_ns };
+   return nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_WAIT, &w) ? nvmtl_errno_result(errno) : VK_SUCCESS;
+}
+
+/* *level = debug.b580.surfvram as the kernel reports it (B580_CAP_SURFACE_VRAM): 0 off or absent, 1 apps, 2 apps and
+ * WindowServer. */
+PUBLIC VkResult
+nvmtl_anv_surface_vram_cap_v1(VkDevice _device, uint32_t *level)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct drm_get_cap cap = { .capability = B580_CAP_SURFACE_VRAM };
+   *level = 0;
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_GET_CAP, &cap) == 0)
+      *level = (uint32_t)cap.value;
+   return VK_SUCCESS;
+}
+
+static __thread struct nvmtl_anv_surface_vram_req *nvmtl_staged_vram;
+
+/* Stage (req) or clear (NULL) the request the next fd import on this thread turns into. */
+PUBLIC VkResult
+nvmtl_anv_surface_vram_stage_v1(VkDevice _device, struct nvmtl_anv_surface_vram_req *req)
+{
+   (void)_device;
+   if (req && req->version != 1 && req->version != 2)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+   nvmtl_staged_vram = req;
+   return VK_SUCCESS;
+}
+
+bool
+anv_nvmtl_surface_vram_staged(struct anv_device *device, uint64_t need, enum anv_bo_alloc_flags alloc_flags,
+                              uint64_t client_address, struct anv_bo **bo, VkResult *result)
+{
+   struct nvmtl_anv_surface_vram_req *req = nvmtl_staged_vram;
+   if (!req)
+      return false;
+   nvmtl_staged_vram = NULL;   /* one import per stage */
+   struct drm_b580_surface_vram v = {
+      .surface_id = req->surface_id, .plane = req->plane,
+      .size = req->size > need ? req->size : need, .flags = req->flags & B580_SURFACE_VRAM_CREATE,
+   };
+   if (req->version >= 2) {
+      /* SURFACE_VRAM2: a creator records linear (the plugin renders linear); an importer learns the layout. A kernel
+       * without it (ENOTTY) has linear backings only. */
+      struct drm_b580_surface_vram2 v2 = {
+         .surface_id = v.surface_id, .plane = v.plane, .size = v.size, .flags = v.flags,
+         .modifier = DRM_FORMAT_MOD_LINEAR,
+      };
+      req->modifier = DRM_FORMAT_MOD_LINEAR;
+      req->pitch = req->cpp = req->width = req->height = req->linear_pitch = 0;
+      if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_VRAM2, &v2) == 0) {
+         req->modifier = v2.modifier; req->pitch = v2.pitch; req->cpp = v2.cpp; req->width = v2.width;
+         req->height = v2.height; req->linear_pitch = v2.linear_pitch;
+         v.handle = v2.handle; v.size_out = v2.size_out; v.gen = v2.gen;
+         goto imported;
+      }
+      if (errno != ENOTTY) {
+         req->err = errno;
+         *result = vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE, "surface %u VRAM: errno %d", req->surface_id, req->err);
+         return true;
+      }
+   }
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_VRAM, &v)) {
+      req->err = errno;
+      *result = vk_errorf(device, VK_ERROR_INVALID_EXTERNAL_HANDLE, "surface %u VRAM: errno %d", req->surface_id, req->err);
+      return true;
+   }
+imported:
+   req->err = 0;
+   req->size_out = v.size_out;
+   req->gen = v.gen;
+   if (v.size_out < need) {
+      struct anv_bo tmp = { .gem_handle = v.handle };
+      device->kmd_backend->gem_close(device, &tmp);
+      req->err = ENOSPC;
+      *result = vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+      return true;
+   }
+   *result = anv_device_import_bo_handle(device, v.handle, v.size_out, alloc_flags | ANV_BO_ALLOC_EXTERNAL,
+                                         client_address, bo);
+   if (*result != VK_SUCCESS)
+      req->err = EIO;
+   return true;
+}
+
+/* The GPU copy of surface `surface_id` is newer than its pages (a job that wrote it was submitted and its fence
+ * attached): a CPU lock pages it off first. flags: B580_SURFACE_DIRTY_TRYLOCK. */
+PUBLIC VkResult
+nvmtl_anv_surface_dirty_v1(VkDevice _device, uint32_t surface_id, uint32_t plane, uint32_t flags)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   struct drm_b580_surface_dirty d = { .surface_id = surface_id, .plane = plane, .flags = flags };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_DIRTY, &d))
+      return errno == EBUSY ? VK_NOT_READY : nvmtl_errno_result(errno);
+   return VK_SUCCESS;
+}
+
+#if defined(VK_USE_PLATFORM_METAL_EXT) && defined(HAVE_XEMAC)
+/*
+ * VK_EXT_metal_surface swapchains (wsi_device::iosurface, wsi_common_metal.c): the images are IOSurfaces whose VRAM
+ * backing (DRM_B580_SURFACE_VRAM, the one the window server's Metal plugin imports) is the VkImage's memory, and the
+ * present's fence is attached to the IOSurface (DRM_B580_SURFACE_FENCE_ATTACH) so the window server's GPU waits for
+ * the frame: present at submission, implicit sync, no copy.
+ */
+#include <IOSurface/IOSurface.h>
+#include <mach/mach_time.h>
+#include "util/os_time.h"
+
+/* debug.b580.surfvram >= 1 (apps may have VRAM-shared IOSurfaces) and the surface fences exist */
+bool
+anv_wsi_iosurface_supports_gpu_memory(VkDevice _device)
+{
+   uint32_t fences = 0, level = 0;
+   nvmtl_anv_surface_cap_v1(_device, &fences);
+   nvmtl_anv_surface_vram_cap_v1(_device, &level);
+   return fences && level >= 1;
+}
+
+
+
+/* I915_FORMAT_MOD_4_TILED when the kernel keeps backings' layouts and pages tiled ones off, for formats the swapchain
+ * uses; DRM_FORMAT_MOD_LINEAR otherwise. */
+uint64_t
+anv_wsi_iosurface_gpu_memory_modifier(VkDevice _device, VkFormat format)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   if (format != VK_FORMAT_B8G8R8A8_UNORM && format != VK_FORMAT_B8G8R8A8_SRGB)
+      return DRM_FORMAT_MOD_LINEAR;
+   struct drm_get_cap cap = { .capability = B580_CAP_SURFACE_VRAM_LAYOUT };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_GET_CAP, &cap) || cap.value != 1)
+      return DRM_FORMAT_MOD_LINEAR;
+   return I915_FORMAT_MOD_4_TILED;
+}
+
+VkResult
+anv_wsi_iosurface_import(struct anv_device *device, uint32_t iosurface_id, uint64_t size, uint64_t modifier,
+                         uint32_t pitch, uint32_t cpp, uint32_t width, uint32_t height, uint32_t linear_pitch,
+                         enum anv_bo_alloc_flags alloc_flags, uint64_t client_address, struct anv_bo **bo)
+{
+   struct drm_b580_surface_vram v = {
+      .surface_id = iosurface_id, .plane = 0, .size = size, .flags = B580_SURFACE_VRAM_CREATE,
+   };
+   if (modifier != DRM_FORMAT_MOD_LINEAR) {
+      /* the layout goes with the backing (SURFACE_VRAM2); a backing someone else made with another layout is refused */
+      struct drm_b580_surface_vram2 v2 = {
+         .surface_id = iosurface_id, .plane = 0, .size = size, .flags = B580_SURFACE_VRAM_CREATE,
+         .modifier = modifier, .pitch = pitch, .cpp = cpp, .width = width, .height = height, .linear_pitch = linear_pitch,
+      };
+      if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_VRAM2, &v2))
+         return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: no tiled VRAM backing (errno %d)",
+                          iosurface_id, errno);
+      if (v2.modifier != modifier || v2.pitch != pitch) {
+         struct anv_bo tmp = { .gem_handle = v2.handle };
+         device->kmd_backend->gem_close(device, &tmp);
+         return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: its backing has another layout",
+                          iosurface_id);
+      }
+      v.handle = v2.handle;
+      v.size_out = v2.size_out;
+      v.gen = v2.gen;
+   } else if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_VRAM, &v)) {
+      return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: no VRAM backing (errno %d)",
+                       iosurface_id, errno);
+   }
+   if (v.size_out < size) {
+      struct anv_bo tmp = { .gem_handle = v.handle };
+      device->kmd_backend->gem_close(device, &tmp);
+      return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: VRAM backing of %llu bytes < %llu",
+                       iosurface_id, (unsigned long long)v.size_out, (unsigned long long)size);
+   }
+   return anv_device_import_bo_handle(device, v.handle, v.size_out, alloc_flags, client_address, bo);
+}
+
+/* The Metal plugin's VRAM tag (NVMTLDevice.m nvmtl_vram_tag): the IOSurface value "NVMTLVramAt:p<plane>" says which
+ * IOSurface seed the shared VRAM backing is current at. A reader (the window server) whose seed matches uses the VRAM as
+ * it is; otherwise it pages the surface off and uploads it again. gen counts the writes. */
+struct anv_nvmtl_vram_tag { uint32_t magic, seed, gen; };
+#define ANV_NVMTL_VRAM_MAGIC 0x564d5634u
+
+static void
+anv_nvmtl_vram_tag_bump(IOSurfaceRef surface)
+{
+   struct anv_nvmtl_vram_tag t = { 0, 0, 0 };
+   CFTypeRef v = IOSurfaceCopyValue(surface, CFSTR("NVMTLVramAt:p0"));
+   if (v && CFGetTypeID(v) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)v) == (CFIndex)sizeof(t))
+      memcpy(&t, CFDataGetBytePtr((CFDataRef)v), sizeof(t));
+   if (v)
+      CFRelease(v);
+   t.gen = t.magic == ANV_NVMTL_VRAM_MAGIC ? t.gen + 1 : 1;
+   t.magic = ANV_NVMTL_VRAM_MAGIC;
+   t.seed = IOSurfaceGetSeed(surface);
+   CFDataRef d = CFDataCreate(NULL, (const UInt8 *)&t, sizeof(t));
+   IOSurfaceSetValue(surface, CFSTR("NVMTLVramAt:p0"), d);
+   CFRelease(d);
+}
+
+VkResult
+anv_wsi_iosurface_signal_write(VkDevice _device, VkFence _fence, void *iosurface, bool gpu_memory)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   VK_FROM_HANDLE(vk_fence, fence, _fence);
+   IOSurfaceRef surface = iosurface;
+   const uint32_t sid = IOSurfaceGetID(surface);
+
+   struct vk_sync *sync = vk_fence_get_active_sync(fence);
+   struct vk_drm_syncobj *syncobj = sync ? vk_sync_as_drm_syncobj(sync) : NULL;
+   if (!syncobj)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* 1. The frame's fence becomes the IOSurface's write fence: readers on the GPU (the window server's composite) wait
+    *    for it in the kernel's job queue. */
+   struct drm_b580_surface_fence_attach a = {
+      .surface_id = sid, .syncobj = syncobj->syncobj, .point = 0, .flags = B580_SURFACE_FENCE_WRITE,
+   };
+   int err = nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_ATTACH, &a) ? errno : 0;
+   if (err == EAGAIN) {
+      /* not in the kernel yet (a deferred submission): wait until it is */
+      VkResult result = vk_sync_wait(&device->vk, sync, 0, VK_SYNC_WAIT_PENDING, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return result;
+      err = nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_ATTACH, &a) ? errno : 0;
+   }
+   if (err)
+      return vk_errorf(device, VK_ERROR_UNKNOWN, "IOSurface %u: write fence not attached (errno %d)", sid, err);
+
+   if (gpu_memory) {
+      /* 2. The VRAM copy is newer than the pages: a CPU lock (a screenshot) pages it off after the fence. This moves
+       *    the IOSurface's seed. */
+      struct drm_b580_surface_dirty d = { .surface_id = sid, .plane = 0, .flags = 0 };
+      if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_DIRTY, &d))
+         mesa_logw_once("anv: IOSurface %u: SURFACE_DIRTY failed (errno %d): CPU readers may see an older frame",
+                        sid, errno);
+      /* 3. Readers use the VRAM as it is at this seed (no page-off and upload). */
+      anv_nvmtl_vram_tag_bump(surface);
+   } else {
+      /* The GPU writes the pages: move the seed so that readers upload them again (they wait for the write fence). */
+      IOSurfaceLock(surface, 0, NULL);
+      IOSurfaceUnlock(surface, 0, NULL);
+   }
+   return VK_SUCCESS;
+}
+
+VkResult
+anv_wsi_iosurface_wait_idle(VkDevice _device, void *iosurface, uint64_t abs_timeout)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   int64_t timeout_ns = 0;   /* CLOCK_UPTIME_RAW, absolute; 0 polls */
+   if (abs_timeout == UINT64_MAX) {
+      timeout_ns = INT64_MAX;
+   } else if (abs_timeout) {
+      const int64_t left = (int64_t)abs_timeout - (int64_t)os_time_get_nano();
+      timeout_ns = (int64_t)clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + MAX2(left, 0);
+   }
+   struct drm_b580_surface_fence_wait w = {
+      .surface_id = IOSurfaceGetID((IOSurfaceRef)iosurface), .flags = B580_SURFACE_FENCE_WRITER,
+      .timeout_ns = timeout_ns ? timeout_ns : 0,
+   };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_WAIT, &w))
+      return (errno == ETIME || errno == ETIMEDOUT) ? VK_TIMEOUT : VK_SUCCESS;
+   return VK_SUCCESS;
+}
+#endif
