+/* Points cmd->batch at the SLBB input at @offset so the regular command emission lands there, like
+ * anv_video_begin_sub_batch(). */
+static void
+anv_av1_brc_slb_begin(struct anv_cmd_buffer *cmd, struct anv_batch *parent,
+                      struct anv_state state, uint32_t offset)
+{
+   *parent = cmd->batch;
+   anv_batch_set_storage(&cmd->batch,
+                         anv_address_add(anv_cmd_buffer_temporary_state_address(cmd, state), offset),
+                         (uint8_t *)state.map + offset, state.alloc_size - offset);
+   cmd->batch.extend_cb = NULL;
+   cmd->batch.user_data = NULL;
+}
+
+/* Ends the group with MI_BATCH_BUFFER_END, returns to the main batch and jumps into the HuC output copy of
+ * the group at @exec_addr. */
+static void
+anv_av1_brc_slb_end(struct anv_cmd_buffer *cmd, struct anv_batch *parent,
+                    uint32_t expected_size, struct anv_address exec_addr)
+{
+   anv_batch_emit(&cmd->batch, GENX(MI_BATCH_BUFFER_END), bbe) { }
+
+   ASSERTED uint32_t size = cmd->batch.next - cmd->batch.start;
+   VkResult status = cmd->batch.status;
+
+   assert(status != VK_SUCCESS || size == expected_size);
+
+   cmd->batch = *parent;
+   if (status != VK_SUCCESS) {
+      anv_batch_set_error(&cmd->batch, status);
+      return;
+   }
+
+   anv_batch_emit(&cmd->batch, GENX(MI_BATCH_BUFFER_START), bbs) {
+      bbs.SecondLevelBatchBuffer = Secondlevelbatch;
+      bbs.AddressSpaceIndicator = ASI_PPGTT;
+      bbs.BatchBufferStartAddress = exec_addr;
+   }
+}
+
+static struct anv_address
+anv_av1_brc_slb_out_addr(struct anv_video_session *vid, uint32_t offset)
+{
+   return anv_address_add(anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_SLB_OUT), offset);
+}
+
+static struct anv_address
+anv_av1_brc_scratch_addr(struct anv_video_session *vid, uint32_t offset)
+{
+   return anv_address_add(anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_DATA), offset);
+}
+
+/* After the update kernel ran: keep the luma loop filter levels it put in the output AVP_INLOOP_FILTER_STATE
+ * (DW1 bits 5:0 and 11:6, media-driver readBRCMetaDataFromSLBB) with a 0xfff compare mask behind them. */
+static void
+anv_av1_brc_capture_lf_levels(struct anv_cmd_buffer *cmd, const struct anv_av1_brc_frame *brc)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+   struct anv_address dst = anv_av1_brc_scratch_addr(vid, ANV_AV1_BRC_SCRATCH_LF_LEVELS);
+   struct mi_builder b;
+
+   mi_builder_init(&b, cmd->device->info, &cmd->batch);
+   mi_builder_set_mocs(&b, anv_mocs_for_address(cmd->device, &dst));
+   mi_store(&b, mi_mem32(dst), mi_mem32(anv_av1_brc_slb_out_addr(vid, brc->layout.inloop_filter_offset + 4)));
+   mi_store(&b, mi_mem32(anv_address_add(dst, 4)), mi_imm(0xfff));
+}
+
+/* After the update kernel ran: keep the CDEF word it put in the output AVP_INLOOP_FILTER_STATE (DW5: strengths
+ * 0-3, cdef_bits 29:28, damping 31:30; media-driver readBRCMetaDataFromSLBB) with a cdef_bits compare mask behind. */
+static void
+anv_av1_brc_capture_cdef_bits(struct anv_cmd_buffer *cmd, const struct anv_av1_brc_frame *brc)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+   struct anv_address dst = anv_av1_brc_scratch_addr(vid, ANV_AV1_BRC_SCRATCH_CDEF_BITS);
+   struct mi_builder b;
+
+   mi_builder_init(&b, cmd->device->info, &cmd->batch);
+   mi_builder_set_mocs(&b, anv_mocs_for_address(cmd->device, &dst));
+   mi_store(&b, mi_mem32(dst), mi_mem32(anv_av1_brc_slb_out_addr(vid, brc->layout.inloop_filter_offset + 20)));
+   mi_store(&b, mi_mem32(anv_address_add(dst, 4)), mi_imm(0x30000000));
+}
+
+/* A second level batch command that ends the batch unless the kernel chose @cdef_bits (cdef_params() is
+ * 4 + 12 << cdef_bits bits long, 5.9.19). */
+static void
+anv_av1_brc_emit_cdef_variant_check(struct anv_cmd_buffer *cmd, uint32_t cdef_bits)
+{
+   anv_batch_emit(&cmd->batch, GENX(MI_CONDITIONAL_BATCH_BUFFER_END), cbbe) {
+      cbbe.CompareOperation = MADEqualIDD;
+      cbbe.EndCurrentBatchBufferLevel = true;
+      cbbe.CompareSemaphore = 1;
+      cbbe.CompareMaskMode = CompareMaskModeEnabled;
+      cbbe.CompareDataDword = cdef_bits << 28;
+      cbbe.CompareAddress = anv_av1_brc_scratch_addr(cmd->video.vid, ANV_AV1_BRC_SCRATCH_CDEF_BITS);
+   }
+}
+
+/* First command of a second level batch that only applies when the kernel's luma loop filter levels are both
+ * zero (@with_chroma_levels false) or not (true): loop_filter_level[2..3] are coded only in the latter case. */
+static void
+anv_av1_brc_emit_lf_variant_check(struct anv_cmd_buffer *cmd, bool with_chroma_levels)
+{
+   anv_batch_emit(&cmd->batch, GENX(MI_CONDITIONAL_BATCH_BUFFER_END), cbbe) {
+      /* the batch ends unless (levels & mask) <op> 0 holds */
+      cbbe.CompareOperation = with_chroma_levels ? MADGreaterThanIDD : MADEqualIDD;
+      cbbe.EndCurrentBatchBufferLevel = true;
+      cbbe.CompareSemaphore = 1;
+      cbbe.CompareMaskMode = CompareMaskModeEnabled;
+      cbbe.CompareDataDword = 0;
+      cbbe.CompareAddress = anv_av1_brc_scratch_addr(cmd->video.vid, ANV_AV1_BRC_SCRATCH_LF_LEVELS);
+   }
+}
