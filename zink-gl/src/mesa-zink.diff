+
+/*
+ * macOS has neither memfd nor SHM_ANON, and a sandboxed process may create
+ * neither files in /tmp nor POSIX shm objects outside its application group.
+ * The per-user temporary directory, confstr(_CS_DARWIN_USER_TEMP_DIR), is the
+ * platform's counterpart of XDG_RUNTIME_DIR: owned by the user, mode 0700,
+ * emptied at boot, and inside an App Sandbox redirected to a directory of the
+ * app's own, so it is where a sandboxed process (QuickTime Player,
+ * VTDecoderXPCService, ...) may create a temporary file.
+ * Returns a pointer to the path buffer, which the caller must free(), or NULL.
+ */
+static char*
+get_darwin_user_temp_dir(void)
+{
+   size_t n = confstr(_CS_DARWIN_USER_TEMP_DIR, NULL, 0);
+   char *buf = n ? malloc(n) : NULL;
+
+   if (!buf)
+      return NULL;
+   if (confstr(_CS_DARWIN_USER_TEMP_DIR, buf, n) == 0 || buf[0] == '\0') {
+      free(buf);
+      return NULL;
+   }
+
+   /* it comes with a trailing slash */
+   n = strlen(buf);
+   while (n > 1 && buf[n - 1] == '/')
+      buf[--n] = '\0';
+   return buf;
+}
+#endif
+
 #if !(defined(__FreeBSD__) || DETECT_OS_ANDROID)
+/*
+ * Creates, opens and unlinks a uniquely named file in the directory path.
+ */
+static int
+create_tmpfile_in_dir(const char *path, const char *debug_name)
+{
+   char *name;
+   int fd, k;
+
+   if (debug_name)
+      k = asprintf(&name, "%s/mesa-shared-%s-XXXXXX", path, debug_name);
+   else
+      k = asprintf(&name, "%s/mesa-shared-XXXXXX", path);
+   if (k < 0 || !name)
+      return -1;
+
+   fd = create_tmpfile_cloexec(name);
+
+   free(name);
+   return fd;
+}
+
