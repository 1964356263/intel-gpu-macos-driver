diff --git a/src/intel/vulkan/anv_nvmtl_surface.c b/src/intel/vulkan/anv_nvmtl_surface.c
index 2376674d643..5acaa43e54d 100644
--- a/src/intel/vulkan/anv_nvmtl_surface.c
+++ b/src/intel/vulkan/anv_nvmtl_surface.c
@@ -239,3 +239,133 @@ nvmtl_anv_surface_dirty_v1(VkDevice _device, uint32_t surface_id, uint32_t plane
       return errno == EBUSY ? VK_NOT_READY : nvmtl_errno_result(errno);
    return VK_SUCCESS;
 }
+
+#if defined(VK_USE_PLATFORM_METAL_EXT) && defined(HAVE_XEMAC)
+/*
+ * VK_EXT_metal_surface swapchains (wsi_device::iosurface, wsi_common_metal.c): the images are IOSurfaces whose VRAM
+ * backing (DRM_B580_SURFACE_VRAM, the one the window server's Metal plugin imports) is the VkImage's memory, and the
+ * present's fence is attached to the IOSurface (DRM_B580_SURFACE_FENCE_ATTACH) so the window server's GPU waits for
+ * the frame: present at submission, implicit sync, no copy.
+ */
+#include <IOSurface/IOSurface.h>
+#include <mach/mach_time.h>
+#include "util/os_time.h"
+
+/* debug.b580.surfvram >= 1 (apps may have VRAM-shared IOSurfaces) and the surface fences exist */
+bool
+anv_wsi_iosurface_supports_gpu_memory(VkDevice _device)
+{
+   uint32_t fences = 0, level = 0;
+   nvmtl_anv_surface_cap_v1(_device, &fences);
+   nvmtl_anv_surface_vram_cap_v1(_device, &level);
+   return fences && level >= 1;
+}
+
+VkResult
+anv_wsi_iosurface_import(struct anv_device *device, uint32_t iosurface_id, uint64_t size,
+                         enum anv_bo_alloc_flags alloc_flags, uint64_t client_address, struct anv_bo **bo)
+{
+   struct drm_b580_surface_vram v = {
+      .surface_id = iosurface_id, .plane = 0, .size = size, .flags = B580_SURFACE_VRAM_CREATE,
+   };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_VRAM, &v))
+      return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: no VRAM backing (errno %d)",
+                       iosurface_id, errno);
+   if (v.size_out < size) {
+      struct anv_bo tmp = { .gem_handle = v.handle };
+      device->kmd_backend->gem_close(device, &tmp);
+      return vk_errorf(device, VK_ERROR_OUT_OF_DEVICE_MEMORY, "IOSurface %u: VRAM backing of %llu bytes < %llu",
+                       iosurface_id, (unsigned long long)v.size_out, (unsigned long long)size);
+   }
+   return anv_device_import_bo_handle(device, v.handle, v.size_out, alloc_flags, client_address, bo);
+}
+
+/* The Metal plugin's VRAM tag (NVMTLDevice.m nvmtl_vram_tag): the IOSurface value "NVMTLVramAt:p<plane>" says which
+ * IOSurface seed the shared VRAM backing is current at. A reader (the window server) whose seed matches uses the VRAM as
+ * it is; otherwise it pages the surface off and uploads it again. gen counts the writes. */
+struct anv_nvmtl_vram_tag { uint32_t magic, seed, gen; };
+#define ANV_NVMTL_VRAM_MAGIC 0x564d5634u
+
+static void
+anv_nvmtl_vram_tag_bump(IOSurfaceRef surface)
+{
+   struct anv_nvmtl_vram_tag t = { 0, 0, 0 };
+   CFTypeRef v = IOSurfaceCopyValue(surface, CFSTR("NVMTLVramAt:p0"));
+   if (v && CFGetTypeID(v) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)v) == (CFIndex)sizeof(t))
+      memcpy(&t, CFDataGetBytePtr((CFDataRef)v), sizeof(t));
+   if (v)
+      CFRelease(v);
+   t.gen = t.magic == ANV_NVMTL_VRAM_MAGIC ? t.gen + 1 : 1;
+   t.magic = ANV_NVMTL_VRAM_MAGIC;
+   t.seed = IOSurfaceGetSeed(surface);
+   CFDataRef d = CFDataCreate(NULL, (const UInt8 *)&t, sizeof(t));
+   IOSurfaceSetValue(surface, CFSTR("NVMTLVramAt:p0"), d);
+   CFRelease(d);
+}
+
+VkResult
+anv_wsi_iosurface_signal_write(VkDevice _device, VkFence _fence, void *iosurface, bool gpu_memory)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   VK_FROM_HANDLE(vk_fence, fence, _fence);
+   IOSurfaceRef surface = iosurface;
+   const uint32_t sid = IOSurfaceGetID(surface);
+
+   struct vk_sync *sync = vk_fence_get_active_sync(fence);
+   struct vk_drm_syncobj *syncobj = sync ? vk_sync_as_drm_syncobj(sync) : NULL;
+   if (!syncobj)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   /* 1. The frame's fence becomes the IOSurface's write fence: readers on the GPU (the window server's composite) wait
+    *    for it in the kernel's job queue. */
+   struct drm_b580_surface_fence_attach a = {
+      .surface_id = sid, .syncobj = syncobj->syncobj, .point = 0, .flags = B580_SURFACE_FENCE_WRITE,
+   };
+   int err = nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_ATTACH, &a) ? errno : 0;
+   if (err == EAGAIN) {
+      /* not in the kernel yet (a deferred submission): wait until it is */
+      VkResult result = vk_sync_wait(&device->vk, sync, 0, VK_SYNC_WAIT_PENDING, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return result;
+      err = nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_ATTACH, &a) ? errno : 0;
+   }
+   if (err)
+      return vk_errorf(device, VK_ERROR_UNKNOWN, "IOSurface %u: write fence not attached (errno %d)", sid, err);
+
+   if (gpu_memory) {
+      /* 2. The VRAM copy is newer than the pages: a CPU lock (a screenshot) pages it off after the fence. This moves
+       *    the IOSurface's seed. */
+      struct drm_b580_surface_dirty d = { .surface_id = sid, .plane = 0, .flags = 0 };
+      if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_DIRTY, &d))
+         mesa_logw_once("anv: IOSurface %u: SURFACE_DIRTY failed (errno %d): CPU readers may see an older frame",
+                        sid, errno);
+      /* 3. Readers use the VRAM as it is at this seed (no page-off and upload). */
+      anv_nvmtl_vram_tag_bump(surface);
+   } else {
+      /* The GPU writes the pages: move the seed so that readers upload them again (they wait for the write fence). */
+      IOSurfaceLock(surface, 0, NULL);
+      IOSurfaceUnlock(surface, 0, NULL);
+   }
+   return VK_SUCCESS;
+}
+
+VkResult
+anv_wsi_iosurface_wait_idle(VkDevice _device, void *iosurface, uint64_t abs_timeout)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   int64_t timeout_ns = 0;   /* CLOCK_UPTIME_RAW, absolute; 0 polls */
+   if (abs_timeout == UINT64_MAX) {
+      timeout_ns = INT64_MAX;
+   } else if (abs_timeout) {
+      const int64_t left = (int64_t)abs_timeout - (int64_t)os_time_get_nano();
+      timeout_ns = (int64_t)clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + MAX2(left, 0);
+   }
+   struct drm_b580_surface_fence_wait w = {
+      .surface_id = IOSurfaceGetID((IOSurfaceRef)iosurface), .flags = B580_SURFACE_FENCE_WRITER,
+      .timeout_ns = timeout_ns ? timeout_ns : 0,
+   };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_B580_SURFACE_FENCE_WAIT, &w))
+      return (errno == ETIME || errno == ETIMEDOUT) ? VK_TIMEOUT : VK_SUCCESS;
+   return VK_SUCCESS;
+}
+#endif
