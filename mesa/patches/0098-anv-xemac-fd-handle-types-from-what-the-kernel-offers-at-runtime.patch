---
diff --git a/src/intel/vulkan/anv_allocator.c b/src/intel/vulkan/anv_allocator.c
index b12f848..f61c5f8 100644
--- a/src/intel/vulkan/anv_allocator.c
+++ b/src/intel/vulkan/anv_allocator.c
@@ -2128,7 +2128,14 @@ anv_device_import_bo(struct anv_device *device,
          .alloc_flags = alloc_flags,
       };
 
+#ifdef HAVE_XEMAC
+      /* An object fd is an open of B580.kext's clone device, whose
+       * lseek(SEEK_END) is 0: the kernel tells the BO's size.
+       */
+      off_t size = xemac_obj_size(device->fd, fd);
+#else
       off_t size = lseek(fd, 0, SEEK_END);
+#endif
       if (size == (off_t)-1) {
          device->kmd_backend->gem_close(device, &new_bo);
          simple_mtx_unlock(&cache->mutex);
diff --git a/src/intel/vulkan/anv_physical_device.c b/src/intel/vulkan/anv_physical_device.c
index 6657fd7..1fe77f0 100644
--- a/src/intel/vulkan/anv_physical_device.c
+++ b/src/intel/vulkan/anv_physical_device.c
@@ -354,13 +354,24 @@ get_device_descriptor_limits(const struct anv_physical_device *device,
 }
 
 
-/* With xemac there are no dma-buf, sync_file or syncobj fds (yet), and no
- * DRM node to report.
+/* With xemac (macOS, B580.kext) the fd handle types exist only when the
+ * kernel offers object fds (xemac_fd_sharing(): B580_CAP_FD_OBJECTS and
+ * DRM_CAP_PRIME), asked at runtime so that an older kernel keeps today's
+ * behaviour: DRM syncobj fds and sync files for the semaphore and fence fd
+ * extensions, PRIME fds for VK_KHR_external_memory_fd. A dma-buf with an
+ * explicit layout (VK_EXT_external_memory_dma_buf) and a DRM node to report
+ * (VK_EXT_physical_device_drm) are not there yet.
  */
 #ifdef HAVE_XEMAC
-#define ANV_FD_SHARING false
+#define ANV_FD_SYNC(pdev) (((pdev)->xemac_fd_sharing & XEMAC_FD_SYNC) != 0)
+#define ANV_FD_MEMORY(pdev) (((pdev)->xemac_fd_sharing & XEMAC_FD_PRIME) != 0)
+#define ANV_FD_DMA_BUF false
+#define ANV_FD_DRM_NODE false
 #else
-#define ANV_FD_SHARING true
+#define ANV_FD_SYNC(pdev) true
+#define ANV_FD_MEMORY(pdev) true
+#define ANV_FD_DMA_BUF true
+#define ANV_FD_DRM_NODE true
 #endif
 
 static void
@@ -413,11 +424,11 @@ get_device_extensions(const struct anv_physical_device *device,
       .KHR_dynamic_rendering_local_read      = true,
       .KHR_extended_flags                    = true,
       .KHR_external_fence                    = true,
-      .KHR_external_fence_fd                 = ANV_FD_SHARING,
+      .KHR_external_fence_fd                 = ANV_FD_SYNC(device),
       .KHR_external_memory                   = true,
-      .KHR_external_memory_fd                = ANV_FD_SHARING,
+      .KHR_external_memory_fd                = ANV_FD_MEMORY(device),
       .KHR_external_semaphore                = true,
-      .KHR_external_semaphore_fd             = ANV_FD_SHARING,
+      .KHR_external_semaphore_fd             = ANV_FD_SYNC(device),
       .KHR_format_feature_flags2             = true,
       .KHR_fragment_shader_barycentric       = device->info.ver >= 20,
       .KHR_fragment_shading_rate             = device->info.ver >= 11,
@@ -577,7 +588,7 @@ get_device_extensions(const struct anv_physical_device *device,
       .EXT_extended_dynamic_state2           = true,
       .EXT_extended_dynamic_state3           = true,
       .EXT_external_memory_acquire_unmodified = true,
-      .EXT_external_memory_dma_buf           = ANV_FD_SHARING,
+      .EXT_external_memory_dma_buf           = ANV_FD_DMA_BUF,
       .EXT_external_memory_host              = device->info.has_userptr_uapi,
       .EXT_fragment_shader_interlock         = true,
       .EXT_global_priority                   = device->max_context_priority >=
@@ -613,7 +624,7 @@ get_device_extensions(const struct anv_physical_device *device,
       .EXT_nested_command_buffer             = true,
       .EXT_non_seamless_cube_map             = true,
       .EXT_pci_bus_info                      = true,
-      .EXT_physical_device_drm               = ANV_FD_SHARING,
+      .EXT_physical_device_drm               = ANV_FD_DRM_NODE,
       .EXT_pipeline_creation_cache_control   = true,
       .EXT_pipeline_creation_feedback        = true,
       .EXT_pipeline_library_group_handles    = rt_enabled,
@@ -3172,6 +3183,10 @@ anv_physical_device_try_create(struct vk_instance *vk_instance,
    if (result != VK_SUCCESS)
       goto fail_drirc;
 
+#ifdef HAVE_XEMAC
+   device->xemac_fd_sharing = xemac_fd_sharing(fd);
+#endif
+
    if (is_virtio) {
       struct util_sync_provider *sync = intel_virtio_sync_provider(fd);
       device->sync_syncobj_type = vk_drm_syncobj_get_type_from_provider(sync);
diff --git a/src/intel/vulkan/anv_private.h b/src/intel/vulkan/anv_private.h
index c702ee8..9bbee90 100644
--- a/src/intel/vulkan/anv_private.h
+++ b/src/intel/vulkan/anv_private.h
@@ -1529,6 +1529,10 @@ struct anv_physical_device {
      * on Gfx12+.
      */
     bool                                        has_reg_timestamp;
+#ifdef HAVE_XEMAC
+    /** XEMAC_FD_* bits: the object fds B580.kext offers (xemac_fd_sharing) */
+    unsigned                                    xemac_fd_sharing;
+#endif
 
     /** True if we can create protected contexts. */
     bool                                        has_protected_contexts;
