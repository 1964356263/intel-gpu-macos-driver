anv: HEVC encode PAK RDOQ on Xe2, as media-driver

media-driver enables PAK rate-distortion optimised quantisation for HEVC VDEnc on Xe2_HPM at every target usage
but 7 (EncodeHevcVdencConstSettingsXe2_Hpm rdoqEnable { 1, 1, 1, 1, 1, 1, 1, 0 }; HevcEncodeCqp: HCP_PIPE_MODE_SELECT
RDOQ enable, HCP_PIC_STATE RDOQ enable with the intra TU threshold 0xffff at TU 1/2/4/6) and loads the RDOQ lambdas
with HEVC_VP9_RDOQ_STATE after the picture level commands (HevcBasicFeature: rdoqLamdas8bits / rdoqLamdas10bits by
slice type; Xe2 command 154 dwords). ANV never enabled it.
1080p60 VBR 3/6/12 Mbit/s, TU 4, same speed (595 fps): BD-rate against x265 medium, Netflix Aerial +21.1% -> +15.6%
(PSNR-Y), +14.8% -> -1.9% (VMAF); DrivingPOV +60.2% -> +57.0%, +6.5% -> -4.3%.

--- a/src/intel/vulkan/genX_cmd_video_enc.c
+++ b/src/intel/vulkan/genX_cmd_video_enc.c
@@ -2155,6 +2155,47 @@
                             ANV_H265_ENCODE_QUALITY_LEVELS - 1)];
 }
 
+#if GFX_VER >= 20
+/* PAK RDOQ: media-driver's Xe2_HPM HEVC VDEnc settings enable it for every target usage but 7
+ * (EncodeHevcVdencConstSettingsXe2_Hpm rdoqEnable { 1, 1, 1, 1, 1, 1, 1, 0 }). */
+static bool
+anv_h265_rdoq_enabled(const struct anv_cmd_buffer *cmd)
+{
+   return anv_h265_target_usage(cmd) != 7;
+}
+
+/* HEVC_VP9_RDOQ_STATE (Xe2: 154 dwords): the RDOQ lambdas for the picture's slice type and bit depth, two 16-bit
+ * values per dword (media-driver HevcBasicFeature MHW_SETPAR HEVC_VP9_RDOQ_STATE, mhw_vdbox_hcp_impl.h) */
+static void
+anv_h265_emit_rdoq_state(struct anv_cmd_buffer *cmd, const VkVideoEncodeInfoKHR *enc_info,
+                         const StdVideoH265SequenceParameterSet *sps)
+{
+   const struct VkVideoEncodeH265PictureInfoKHR *frame_info =
+      vk_find_struct_const(enc_info->pNext, VIDEO_ENCODE_H265_PICTURE_INFO_KHR);
+   const unsigned st = frame_info->pStdPictureInfo->pic_type == STD_VIDEO_H265_PICTURE_TYPE_I ||
+                       frame_info->pStdPictureInfo->pic_type == STD_VIDEO_H265_PICTURE_TYPE_IDR ? 0 : 1;
+   const bool ten = sps->bit_depth_luma_minus8 == 2;
+   uint32_t *dw = anv_batch_emit_dwords(&cmd->batch, 154);
+   if (!dw)
+      return;
+   memset(dw, 0, 154 * 4);
+   dw[0] = 0x73880098;   /* HEVC_VP9_RDOQ_STATE, DWord length 152 */
+   for (unsigned blk = 0; blk < 4; blk++) {   /* intra luma, intra chroma, inter luma, inter chroma */
+      for (unsigned i = 0; i < 32; i++) {
+         uint32_t a = 0, b = 0;
+         if (ten) {
+            a = anv_hevc_rdoq_lambda_10bit[st][blk >> 1][blk & 1][2 * i];
+            b = anv_hevc_rdoq_lambda_10bit[st][blk >> 1][blk & 1][2 * i + 1];
+         } else if (2 * i + 1 < 52) {
+            a = anv_hevc_rdoq_lambda_8bit[st][blk >> 1][blk & 1][2 * i];
+            b = anv_hevc_rdoq_lambda_8bit[st][blk >> 1][blk & 1][2 * i + 1];
+         }
+         dw[2 + blk * 32 + i] = a | b << 16;
+      }
+   }
+}
+#endif
+
 static const StdVideoH265VideoParameterSet *
 anv_h265_vps(struct anv_cmd_buffer *cmd, const VkVideoEncodeInfoKHR *enc_info)
 {
