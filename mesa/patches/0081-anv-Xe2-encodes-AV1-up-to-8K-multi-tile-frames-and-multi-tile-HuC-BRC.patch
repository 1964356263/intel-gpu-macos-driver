+/* The 4-byte (non-minimal) leb128 of @bytes, the tile group obu_size placeholder's encoding */
+static struct mi_value
+anv_av1_leb128_4(struct mi_builder *b, struct mi_value bytes)
+{
+   struct mi_value leb0 =
+      mi_ior(b, mi_iand(b, mi_value_ref(b, bytes), mi_imm(0x7f)), mi_imm(0x80));
+   struct mi_value leb1 =
+      mi_ishl_imm(b, mi_ior(b, mi_iand(b, mi_ushr32_imm(b, mi_value_ref(b, bytes), 7), mi_imm(0x7f)),
+                            mi_imm(0x80)), 8);
+   struct mi_value leb2 =
+      mi_ishl_imm(b, mi_ior(b, mi_iand(b, mi_ushr32_imm(b, mi_value_ref(b, bytes), 14), mi_imm(0x7f)),
+                            mi_imm(0x80)), 16);
+   struct mi_value leb3 = mi_ishl_imm(b, mi_ushr32_imm(b, bytes, 21), 24);
+   return mi_ior(b, mi_ior(b, leb0, leb1), mi_ior(b, leb2, leb3));
+}
