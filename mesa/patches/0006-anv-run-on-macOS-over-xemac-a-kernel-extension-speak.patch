   dep_libdrm = null_dep
 endif
+# macOS: the xe uAPI of a kernel extension, reached through xemac (xemac.h,
+# xemac.c and a libdrm stand-in in <xemac>/libdrm) instead of a DRM node.
+with_xemac = host_machine.system() == 'darwin' and get_option('xemac') != ''
+if with_xemac
+  _xemac_dir = get_option('xemac')
+  files_xemac = files(_xemac_dir / 'xemac.c', _xemac_dir / 'xemac_drm.c')
+  dep_libdrm = declare_dependency(
+    include_directories : include_directories(_xemac_dir, _xemac_dir / 'libdrm'),
+  )
+  pre_args += '-DHAVE_XEMAC'
+endif
 if dep_libdrm.found()
   pre_args += '-DHAVE_LIBDRM'
   if with_dri_platform == 'drm' and with_dri
