index 00000000000..3c0e7659587
--- /dev/null
+++ b/src/intel/blorp/stub/blorp_shaders.h
@@ -0,0 +1,39 @@
+/* Copyright © 2026 Intel Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Stand-in for the blorp_shaders.h that vtn_bindgen2 generates from
+ * blorp_shaders.cl, used with -Dintel-internal-shaders=stub (no mesa-clc).
+ * blorp_check_in_bounds() is small enough to build by hand; the indirect
+ * copy shaders abort.
+ */
+
+#pragma once
+
+#include <stdlib.h>
+#include "compiler/nir/nir_builder.h"
+#include "util/log.h"
+
+static inline nir_def *
+blorp_check_in_bounds(nir_builder *b, nir_def *bounds_rect, nir_def *pos)
+{
+   nir_def *x = nir_channel(b, pos, 0), *y = nir_channel(b, pos, 1);
+
+   return nir_iand(b,
+                   nir_iand(b, nir_uge(b, x, nir_channel(b, bounds_rect, 0)),
+                               nir_ult(b, x, nir_channel(b, bounds_rect, 1))),
+                   nir_iand(b, nir_uge(b, y, nir_channel(b, bounds_rect, 2)),
+                               nir_ult(b, y, nir_channel(b, bounds_rect, 3))));
+}
+
+static inline void
+blorp_shaders_missing(const char *name)
+{
+   mesa_loge("blorp was built without internal shaders (%s)", name);
+   abort();
+}
+
+#define blorp_copy_memory_indirect_shader(b, ...) \
+   blorp_shaders_missing("blorp_copy_memory_indirect_shader")
+#define blorp_copy_memory_to_image_indirect_shader(b, ...) \
+   blorp_shaders_missing("blorp_copy_memory_to_image_indirect_shader")
