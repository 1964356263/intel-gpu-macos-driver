+
+/* The ray tracing state of the queue's context, emitted by the first
+ * submission with a command buffer that uses the ray tracing hardware
+ * (anv_cmd_buffer_use_rt_hw()) rather than with the initial state at
+ * vkCreateDevice: a device that enables the ray tracing extensions without
+ * using them keeps the context state and the BOs of a device without them.
+ * The batch holds the same 3DSTATE_BTD the initial state would and runs on
+ * the queue's context before that submission's command buffers.
+ *
+ * Called with the device mutex held (anv_queue_submit).
+ */
+VkResult
+genX(queue_init_rt_state)(struct anv_queue *queue)
+{
+#if GFX_VERx10 >= 125
+   struct anv_device *device = queue->device;
+   struct anv_bo *btd_fifo_bo = p_atomic_read(&device->btd_fifo_bo);
+   assert(btd_fifo_bo != NULL);
+
+   const enum intel_engine_class engine_class = queue->family->engine_class;
+   if (engine_class != INTEL_ENGINE_CLASS_RENDER &&
+       engine_class != INTEL_ENGINE_CLASS_COMPUTE) {
+      queue->rt_state_initialized = true;
+      return VK_SUCCESS;
+   }
+
+   struct anv_async_submit *submit;
+   VkResult result = anv_async_submit_create(queue,
+                                             &device->batch_bo_pool,
+                                             false, true, &submit);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct anv_batch *batch = &submit->batch;
+
+   /* 3DSTATE_BTD is non-pipelined state and the context has run work
+    * already: stall first. No PIPELINE_SELECT, the command is valid in both
+    * pipelines (the initial state emits it in 3D mode, the ray tracing
+    * pipeline flush in GPGPU mode) and the command buffers that follow
+    * select their own.
+    */
+   genx_batch_emit_pipe_control(batch, device->info,
+                                engine_class == INTEL_ENGINE_CLASS_RENDER ?
+                                _3D : GPGPU,
+                                ANV_PIPE_CS_STALL_BIT);
+
+   emit_btd_state(batch, device, btd_fifo_bo);
+
+   anv_batch_emit(batch, GENX(MI_BATCH_BUFFER_END), bbe);
+
+   result = batch->status;
+   if (result != VK_SUCCESS) {
+      anv_async_submit_destroy(submit);
+      return result;
+   }
+
+   result = device->kmd_backend->queue_exec_async(submit, 0, NULL, 0, NULL);
+   if (result != VK_SUCCESS) {
+      anv_async_submit_destroy(submit);
+      return result;
+   }
+
+   /* A previous one (this queue was replaced after it) is done or dropped */
+   assert(queue->rt_init_submit == NULL);
+   queue->rt_init_submit = submit;
+   queue->rt_state_initialized = true;
+   return VK_SUCCESS;
+#else
+   UNREACHABLE("No ray tracing hardware");
+#endif
 }
 
