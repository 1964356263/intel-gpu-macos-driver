+/* The command buffer uses the ray tracing hardware (ray queries or a ray
+ * tracing pipeline): set up the device's BTD FIFO if this is the first use,
+ * and have the submission emit the queue's BTD state
+ * (genX(queue_init_rt_state)) before the command buffer runs. Returns false
+ * (with the batch in error) if the FIFO cannot be allocated.
+ */
+bool
+anv_cmd_buffer_use_rt_hw(struct anv_cmd_buffer *cmd_buffer)
+{
+   struct anv_device *device = cmd_buffer->device;
+
+   assert(anv_device_has_rt_hw(device));
+
+   /* The docs say to always allocate 128KB per DSS */
+   VkResult result =
+      anv_device_get_rt_bo(device, &device->btd_fifo_bo, "rt-btd-fifo",
+                           128 * 1024 *
+                           intel_device_info_dual_subslice_id_bound(device->info));
+   if (result != VK_SUCCESS) {
+      anv_batch_set_error(&cmd_buffer->batch, result);
+      return false;
+   }
+
+   cmd_buffer->state.uses_rt_hw = true;
+   return true;
+}
