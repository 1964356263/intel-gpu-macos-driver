+/* A ray tracing BO of the device (the ray query BOs, the BTD FIFO):
+ * allocated the first time a command buffer needs it, as the ray query
+ * shadow BOs and the RT scratch BOs are. Command buffers may race here; the
+ * first one to publish its BO wins and the others drop theirs.
+ */
+VkResult
+anv_device_get_rt_bo(struct anv_device *device, struct anv_bo **bo_slot,
+                     const char *name, uint64_t size)
+{
+   if (p_atomic_read(bo_slot) != NULL)
+      return VK_SUCCESS;
+
+   struct anv_bo *new_bo;
+   VkResult result = anv_device_alloc_bo(device, name, size,
+                                         ANV_BO_ALLOC_INTERNAL,
+                                         0 /* explicit_address */,
+                                         &new_bo);
+   ANV_DMR_BO_ALLOC(&device->vk.base, new_bo, result);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (p_atomic_cmpxchg(bo_slot, NULL, new_bo) != NULL) {
+      ANV_DMR_BO_FREE(&device->vk.base, new_bo);
+      anv_device_release_bo(device, new_bo);
+   }
+   return VK_SUCCESS;
+}
