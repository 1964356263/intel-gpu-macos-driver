index 00000000000..d75073decc1
--- /dev/null
+++ b/src/vulkan/util/vk_entrypoints_null_macho.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Resolve the optional (weak) entrypoints of a Mach-O Vulkan driver to NULL at link time.
+
+vk_entrypoints_gen.py --weak declares every entrypoint a driver may implement as a weak symbol, so that the
+entrypoint tables hold NULL for the ones it does not (ELF weak undefined symbols resolve to 0; MSVC points them at
+vk_entrypoint_stub through /alternatename instead). ld64 has no weak undefined symbols outside of dylib imports: it only accepts them with
+-undefined dynamic_lookup, which turns each one into a flat-namespace lookup that dyld searches every loaded image
+for when the driver is loaded (about 11000 for anv, ~0.3 s per dlopen).
+
+This script takes a link of the driver made with -undefined dynamic_lookup, lists the symbols left to dynamic lookup,
+and writes an assembly file that defines each weak one as an absolute 0 with hidden (private extern) visibility.
+Linking the driver again with that file resolves every reference at link time to NULL, exactly what ELF does, with
+no lookups left and no -undefined dynamic_lookup. A non-weak symbol left to dynamic lookup is a real missing
+dependency and fails the build.
+"""
+
+import argparse
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--nm', required=True, help='nm program')
+    parser.add_argument('--lib', required=True, help='driver linked with -undefined dynamic_lookup')
+    parser.add_argument('--out', required=True, help='assembly file to write')
+    args = parser.parse_args()
+
+    out = subprocess.run([args.nm, '-m', '-u', args.lib], check=True,
+                         capture_output=True, text=True).stdout
+
+    weak, missing = [], []
+    for line in out.splitlines():
+        if '(dynamically looked up)' not in line:
+            continue
+        fields = line.split()
+        sym = fields[fields.index('(dynamically') - 1]
+        (weak if 'weak' in fields else missing).append(sym)
+
+    if missing:
+        sys.exit('undefined symbols that are not optional entrypoints:\n  ' + '\n  '.join(missing))
+
+    with open(args.out, 'w') as f:
+        f.write('/* Generated by vk_entrypoints_null_macho.py from %s, do not edit. */\n' % args.lib.split('/')[-1])
+        f.write('/* Optional entrypoints this driver does not implement: NULL, resolved at link time. */\n')
+        for sym in sorted(set(weak)):
+            f.write('\t.globl %s\n\t.private_extern %s\n%s = 0\n' % (sym, sym, sym))
+
+
+if __name__ == '__main__':
+    main()
