anv: AV1 encode: two-reference P pictures are P, with their own reference names (Xe2 VDEnc)

FFmpeg's P pictures with two references are UNIDIRECTIONAL_COMPOUND with LAST + GOLDEN. ANV typed every
unidirectional compound picture as GPB and gave the VDEnc the GPB default reference ids (L0 LAST, LAST2; L1 BWDREF,
ALTREF2) while binding the LAST and GOLDEN pictures: the VDEnc searched the GOLDEN picture for blocks it labelled
LAST2, which the frame header (and so the PAK) maps to the LAST picture. media-driver (Av1ReferenceFrames) makes such
a low delay picture a P picture (m_PFrame: only forward group names, VAAPI ref_frame_ctrl_l0 LAST + GOLDEN) whose
reference ids are the names; GPB stays for pictures that also use the backward group (BWDREF, ALTREF2, ALTREF).
1080p60 VBR 3/6/12 Mbit/s, GOP 120, Netflix Aerial: BD-rate against SVT-AV1 preset 8 +304% -> +162% (PSNR-Y),
+220% -> +90% (VMAF); bitrate 3.51/6.73/12.67 -> 3.27/6.33/12.43 Mbit/s.

--- a/src/intel/vulkan/genX_cmd_video_enc.c
+++ b/src/intel/vulkan/genX_cmd_video_enc.c
@@ -4225,6 +4225,10 @@
    int8_t poc_l1[4] = { -1, -2, -3, -4 };
    uint8_t frame_idx_l0[3] = { 0, 0, 0 };
    uint8_t frame_idx_l1 = 0;
+   /* the reference name (LAST_FRAME = 1 ... ALTREF_FRAME = 7) of each L0 entry, for the VDEnc reference ids */
+   uint8_t l0_name[3] = { 1, 1, 1 };
+   /* a backward-group name (BWDREF, ALTREF2, ALTREF) in use: a unidirectional compound picture is then GPB */
+   bool uses_group2 = false;
 
    if (is_intra) {
       poc_l0[0] = poc_l0[1] = poc_l0[2] = 0;
@@ -4241,6 +4245,8 @@
          if (slot < 0 || (seen_slots & (1u << slot)))
             continue;
          seen_slots |= 1u << slot;
+         if (i >= STD_VIDEO_AV1_REFERENCE_NAME_BWDREF_FRAME - STD_VIDEO_AV1_REFERENCE_NAME_LAST_FRAME)
+            uses_group2 = true;
 
          int32_t diff = (int32_t)pic_info->ref_order_hint[pic_info->ref_frame_idx[i]] -
                         (int32_t)pic_info->order_hint;
@@ -4261,6 +4267,7 @@
             frame_idx_l0[num_ref_l0] = slot;
             l0_iv[num_ref_l0] = ref_name_iv[i];
             l0_layer[num_ref_l0] = ref_name_layer[i];
+            l0_name[num_ref_l0] = i + 1;
             num_ref_l0++;
          }
       }
@@ -5582,7 +5589,9 @@
          else if (frame_info->predictionMode <= VK_VIDEO_ENCODE_AV1_PREDICTION_MODE_SINGLE_REFERENCE_KHR)
             picture_type = 1;
          else if (frame_info->predictionMode == VK_VIDEO_ENCODE_AV1_PREDICTION_MODE_UNIDIRECTIONAL_COMPOUND_KHR)
-            picture_type = 3;
+            /* media-driver Av1ReferenceFrames: low delay pictures are P when only forward-group names are referenced
+             * (m_PFrame, LAST + GOLDEN from VAAPI's ref_frame_ctrl_l0), GPB when the backward group is used too */
+            picture_type = uses_group2 ? 3 : 1;
          else
             picture_type = 2;
 
@@ -5802,8 +5811,10 @@
          uint8_t rid[2][4] = { { LAST, LAST, LAST, LAST }, { LAST, LAST, LAST, LAST } };
          uint32_t nl0 = MIN2(num_ref_l0, 3);
          if (picture_type == 1) {
-            static const uint8_t p[3] = { LAST, GOLDEN, ALT };
-            for (uint32_t i = 0; i < nl0; i++) rid[0][i] = p[i];
+            /* the names the L0 pictures are referenced by (media-driver P default LAST, GOLDEN, ALTREF, which is
+             * what a LAST + GOLDEN compound picture gives); labelling them otherwise makes the VDEnc search one
+             * picture for blocks the PAK then predicts from another */
+            for (uint32_t i = 0; i < nl0; i++) rid[0][i] = l0_name[i];
          } else if (picture_type == 3) {
             static const uint8_t l0[3] = { LAST, LAST2, LAST3 }, l1[3] = { BWD, ALT2, ALT };
             if (nl0 == 1) { rid[0][0] = BWD; rid[1][0] = ALT; }
