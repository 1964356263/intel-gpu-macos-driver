+#define DRM_B580_SURFACE_VRAM2 0x55
+#define DRM_IOCTL_B580_SURFACE_VRAM2 DRM_IOWR(DRM_COMMAND_BASE + DRM_B580_SURFACE_VRAM2, struct drm_b580_surface_vram2)
+#endif
+#ifndef DRM_FORMAT_MOD_LINEAR
+#define DRM_FORMAT_MOD_LINEAR 0ull
+#endif
