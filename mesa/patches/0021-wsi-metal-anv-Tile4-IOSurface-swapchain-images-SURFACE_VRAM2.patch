+#ifndef DRM_IOCTL_B580_SURFACE_VRAM2
+/* B580.kext (tile4) uAPI, uapi/b580_drm.h: a VRAM backing that carries the layout its creator renders with (a DRM format
+ * modifier and its pitch, like a Linux framebuffer), so importers (the window server's Metal plugin) build the same image
+ * and the kernel's CPU-lock page-off detiles it (XY_BLOCK_COPY_BLT Tile4 -> linear pages). GET_CAP
+ * B580_CAP_SURFACE_VRAM_LAYOUT = 1 once WindowServer imports with SURFACE_VRAM2. modifier: DRM_FORMAT_MOD_LINEAR or
+ * I915_FORMAT_MOD_4_TILED (uncompressed: the backing stays noComp); CREATE records it, an import gets it back. */
+#define B580_CAP_SURFACE_VRAM_LAYOUT 0xb5800003ull
+struct drm_b580_surface_vram2 {
+   __u32 surface_id;
+   __u32 plane;
+   __u64 size;
+   __u32 flags;
+   __u32 handle;      /* out */
+   __u64 size_out;    /* out */
