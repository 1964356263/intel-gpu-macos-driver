+   __u32 pad;
+   __u64 modifier;    /* in (CREATE) / out */
+   __u32 pitch;       /* in (CREATE) / out: bytes per row of the backing's layout */
+   __u32 cpp;         /* in (CREATE) / out */
+   __u32 width;       /* in (CREATE) / out */
+   __u32 height;      /* in (CREATE) / out */
+   __u32 linear_pitch;/* in (CREATE) / out: the IOSurface's bytesPerRow */
+   __u32 pad2;
