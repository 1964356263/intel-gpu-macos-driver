+/* I915_FORMAT_MOD_4_TILED when the kernel keeps backings' layouts and pages tiled ones off, for formats the swapchain
+ * uses; DRM_FORMAT_MOD_LINEAR otherwise. */
+uint64_t
+anv_wsi_iosurface_gpu_memory_modifier(VkDevice _device, VkFormat format)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   if (format != VK_FORMAT_B8G8R8A8_UNORM && format != VK_FORMAT_B8G8R8A8_SRGB)
+      return DRM_FORMAT_MOD_LINEAR;
+   struct drm_get_cap cap = { .capability = B580_CAP_SURFACE_VRAM_LAYOUT };
+   if (nvmtl_ioctl(device->fd, DRM_IOCTL_GET_CAP, &cap) || cap.value != 1)
+      return DRM_FORMAT_MOD_LINEAR;
+   return I915_FORMAT_MOD_4_TILED;
+}
