--- a/src/intel/vulkan/genX_huc_brc_av1.h
+++ b/src/intel/vulkan/genX_huc_brc_av1.h
@@ -249,6 +249,7 @@
 
 /* Driver scratch dwords in ANV_VID_MEM_AV1_ENCODE_BRC_DATA, past the 64 bytes the kernel writes there */
 #define ANV_AV1_BRC_SCRATCH_LF_LEVELS  2048 /* AVP_INLOOP_FILTER_STATE DW1 as the kernel wrote it, then a mask */
+#define ANV_AV1_BRC_SCRATCH_CDEF_BITS  2056 /* AVP_INLOOP_FILTER_STATE DW5 as the kernel wrote it, then a mask */
 #define ANV_AV1_BRC_SCRATCH_LEB128     2064 /* the tile group obu_size leb128 */
 
 /* Per-frame BRC state the AV1 encode records against. */
@@ -256,6 +257,8 @@
    bool enabled;
    /* the kernel back-annotates the loop filter levels (header length then known only on the GPU) */
    bool lf_update;
+   /* the kernel picks the CDEF parameters, cdef_bits included (header length then known only on the GPU) */
+   bool cdef_update;
    struct anv_av1_brc_slb_layout layout;
    struct anv_state slb_in;
    struct anv_state pak_insert_in;
@@ -330,6 +333,36 @@
    mi_builder_set_mocs(&b, anv_mocs_for_address(cmd->device, &dst));
    mi_store(&b, mi_mem32(dst), mi_mem32(anv_av1_brc_slb_out_addr(vid, brc->layout.inloop_filter_offset + 4)));
    mi_store(&b, mi_mem32(anv_address_add(dst, 4)), mi_imm(0xfff));
+}
+
+/* After the update kernel ran: keep the CDEF word it put in the output AVP_INLOOP_FILTER_STATE (DW5: strengths
+ * 0-3, cdef_bits 29:28, damping 31:30; media-driver readBRCMetaDataFromSLBB) with a cdef_bits compare mask behind. */
+static void
+anv_av1_brc_capture_cdef_bits(struct anv_cmd_buffer *cmd, const struct anv_av1_brc_frame *brc)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+   struct anv_address dst = anv_av1_brc_scratch_addr(vid, ANV_AV1_BRC_SCRATCH_CDEF_BITS);
+   struct mi_builder b;
+
+   mi_builder_init(&b, cmd->device->info, &cmd->batch);
+   mi_builder_set_mocs(&b, anv_mocs_for_address(cmd->device, &dst));
+   mi_store(&b, mi_mem32(dst), mi_mem32(anv_av1_brc_slb_out_addr(vid, brc->layout.inloop_filter_offset + 20)));
+   mi_store(&b, mi_mem32(anv_address_add(dst, 4)), mi_imm(0x30000000));
+}
+
+/* A second level batch command that ends the batch unless the kernel chose @cdef_bits (cdef_params() is
+ * 4 + 12 << cdef_bits bits long, 5.9.19). */
+static void
+anv_av1_brc_emit_cdef_variant_check(struct anv_cmd_buffer *cmd, uint32_t cdef_bits)
+{
+   anv_batch_emit(&cmd->batch, GENX(MI_CONDITIONAL_BATCH_BUFFER_END), cbbe) {
+      cbbe.CompareOperation = MADEqualIDD;
+      cbbe.EndCurrentBatchBufferLevel = true;
+      cbbe.CompareSemaphore = 1;
+      cbbe.CompareMaskMode = CompareMaskModeEnabled;
+      cbbe.CompareDataDword = cdef_bits << 28;
+      cbbe.CompareAddress = anv_av1_brc_scratch_addr(cmd->video.vid, ANV_AV1_BRC_SCRATCH_CDEF_BITS);
+   }
 }
 
