+   struct anv_vid_mem *es = &vid->vid_mem[ANV_VID_MEM_VP9_EXEC_STATE];
+   void *map;
+   VkResult result = anv_device_map_bo(cmd->device, es->mem->bo, es->offset, es->size, NULL, &map);
+   if (result != VK_SUCCESS) {
