+      { ANV_VP9_EXEC_STATE_MV_OTHER_OFFSET, ANV_VID_MEM_VP9_MV_PREV },
+      { ANV_VP9_EXEC_STATE_MV_PREV_OFFSET, ANV_VID_MEM_VP9_MV_ZERO },
+      { ANV_VP9_EXEC_STATE_MV_ZERO_OFFSET, ANV_VID_MEM_VP9_MV_ZERO },
+   };
+   for (uint32_t i = 0; i < ARRAY_SIZE(mv); i++) {
