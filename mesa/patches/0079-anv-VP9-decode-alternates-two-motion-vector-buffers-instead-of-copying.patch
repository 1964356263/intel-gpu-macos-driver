-      ANV_VID_MEM_VP9_MV_ZERO : ANV_VID_MEM_VP9_MV_CUR;
+   struct anv_address cur = anv_vp9_exec_state_address(vid, ANV_VP9_EXEC_STATE_MV_CUR_OFFSET);
+   struct anv_address other = anv_vp9_exec_state_address(vid, ANV_VP9_EXEC_STATE_MV_OTHER_OFFSET);
+   struct anv_address prev = anv_vp9_exec_state_address(vid, ANV_VP9_EXEC_STATE_MV_PREV_OFFSET);
+   struct anv_address zero = anv_vp9_exec_state_address(vid, ANV_VP9_EXEC_STATE_MV_ZERO_OFFSET);
 
-   struct anv_address prev_addr =
-      ANV_VID_MEM_ADDR(vid, ANV_VID_MEM_VP9_MV_PREV);
-
-   struct anv_address src_addr = {
-      vid->vid_mem[src_id].mem->bo,
-      vid->vid_mem[src_id].offset
-   };
-
    anv_batch_emit(&cmd_buffer->batch, GENX(MI_FLUSH_DW), flush) {
       flush.VideoPipelineCacheInvalidate = 1;
    }
 
-   anv_huc_emit_copy(cmd_buffer, prev_addr, src_addr,
-                     vid->vid_mem[ANV_VID_MEM_VP9_MV_PREV].size);
+   if (key_frame_or_intra_only) {
+      /* PREV = ZERO */
+      anv_vp9_emit_copy_qword(cmd_buffer, prev, zero);
+   } else {
+      /* PREV = CUR (just written), CUR = OTHER, OTHER = PREV */
+      anv_vp9_emit_copy_qword(cmd_buffer, prev, cur);
+      anv_vp9_emit_copy_qword(cmd_buffer, cur, other);
+      anv_vp9_emit_copy_qword(cmd_buffer, other, prev);
+   }
 }
 
