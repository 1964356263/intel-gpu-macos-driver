+static struct anv_address anv_vp9_exec_state_address(struct anv_video_session *vid, uint32_t offset);
 
+/* Copy a 64-bit value between two places in memory at execution time. */
+static void
+anv_vp9_emit_copy_qword(struct anv_cmd_buffer *cmd_buffer,
+                        struct anv_address dst, struct anv_address src)
+{
+   for (uint32_t i = 0; i < 2; i++) {
+      anv_batch_emit(&cmd_buffer->batch, GENX(MI_COPY_MEM_MEM), cp) {
+         cp.DestinationMemoryAddress = anv_address_add(dst, 4 * i);
+         cp.SourceMemoryAddress = anv_address_add(src, 4 * i);
+      }
+   }
+   anv_batch_emit(&cmd_buffer->batch, GENX(MI_FLUSH_DW), flush);
+}
+
+/* The motion vectors the next frame may read (use_prev_frame_mvs) are those of the frame decoded last, or none
+ * after a key or intra-only frame. media-driver alternates between two MV temporal buffers (decode_vp9_basic_feature
+ * m_curMvTempBufIdx / m_colMvTempBufIdx) instead of copying one into the other; the copy was the bulk of a frame's
+ * decode time (a HuC stream copy of 1.2 MB per 4K frame: 248 -> 582 fps without it). The buffer addresses live in
+ * the execution state and advance on the GPU, after the frame, so they follow execution order as LastFrameType does.
+ */
 static void
 anv_vp9_emit_mv_prev_update(struct anv_cmd_buffer *cmd_buffer,
                             struct anv_video_session *vid,
                             bool key_frame_or_intra_only)
 {
