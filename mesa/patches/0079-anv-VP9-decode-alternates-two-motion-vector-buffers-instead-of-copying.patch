+/* GPU addresses of the VP9 motion vector temporal buffers, kept in the execution state so that the ping-pong
+ * between ANV_VID_MEM_VP9_MV_CUR and ANV_VID_MEM_VP9_MV_PREV follows execution order: the buffer the next inter
+ * frame writes (CUR), the other one (OTHER), the collocated buffer it reads (PREV: the MVs of the frame decoded
+ * last, or ANV_VID_MEM_VP9_MV_ZERO after a key or intra-only frame) and the zero buffer itself (ZERO). */
+#define ANV_VP9_EXEC_STATE_MV_CUR_OFFSET 8
+#define ANV_VP9_EXEC_STATE_MV_OTHER_OFFSET 16
+#define ANV_VP9_EXEC_STATE_MV_PREV_OFFSET 24
+#define ANV_VP9_EXEC_STATE_MV_ZERO_OFFSET 32
 
 #define ANV_AV1_ROWSTORE_CACHE_LINE 64
 #define ANV_AV1_ROWSTORE_BTDL_OFFSET (0    * ANV_AV1_ROWSTORE_CACHE_LINE)
