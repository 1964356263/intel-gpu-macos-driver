diff --git a/src/intel/vulkan/anv_video.c b/src/intel/vulkan/anv_video.c
index 01cf1239b58..2c08c1490f6 100644
--- a/src/intel/vulkan/anv_video.c
+++ b/src/intel/vulkan/anv_video.c
@@ -303,7 +303,7 @@ video_profile_supported(struct anv_physical_device *pdevice,
       const struct VkVideoEncodeAV1ProfileInfoKHR *av1_enc_profile =
          vk_find_struct_const(profile->pNext, VIDEO_ENCODE_AV1_PROFILE_INFO_KHR);
 
-      if (pdevice->info.verx10 != 125)
+      if (pdevice->info.verx10 != 125 && pdevice->info.verx10 != 200)
          return VK_ERROR_VIDEO_PROFILE_CODEC_NOT_SUPPORTED_KHR;
 
       if (av1_enc_profile->stdProfile != STD_VIDEO_AV1_PROFILE_MAIN)
@@ -1264,6 +1264,33 @@ get_av1_video_session_mem_reqs(struct anv_device *dev,
       case ANV_VID_MEM_AV1_ENCODE_TILE_BITSTREAM_ACCUM:
          buffer_size = 1;
          break;
+      /* Sizes in 64-byte units, from media-driver Av1VdencPktXe_Lpm_Plus_Base::AllocateResources and
+       * Av1VdencPkt::AllocateResources for the largest frame (4096x4096, 64x64 superblocks, 10-bit). */
+      case ANV_VID_MEM_AV1_ENCODE_VDENC_INTRA_ROW_STORE:
+         /* m_resMfdIntraRowStoreScratchBuffer: width in SB * 4 * 64 cache lines (10-bit) */
+         if (dev->info->ver < 20 || !(vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR))
+            continue;
+         buffer_size = DIV_ROUND_UP(4096, 64) * 4 * 64;
+         break;
+      case ANV_VID_MEM_AV1_ENCODE_VDENC_TILE_ROW_STORE:
+         /* m_vdencTileRowStoreBuffer: ceil(width / 32) * 2 cache lines */
+         if (dev->info->ver < 20 || !(vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR))
+            continue;
+         buffer_size = DIV_ROUND_UP(4096, 32) * 2;
+         break;
+      case ANV_VID_MEM_AV1_ENCODE_VDENC_CU_COUNT_STREAMOUT:
+         /* m_resCumulativeCuCountStreamoutBuffer: width in SB * height in SB * 4 bytes */
+         if (dev->info->ver < 20 || !(vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR))
+            continue;
+         buffer_size = DIV_ROUND_UP(DIV_ROUND_UP(4096, 64) * DIV_ROUND_UP(4096, 64) * 4, 64);
+         break;
+      case ANV_VID_MEM_AV1_ENCODE_VDENC_STATS:
+         /* VDEnc statistics streamout: the tile-slice state offsets each tile by 19 cache lines; up to 128 tiles
+          * (media-driver binds its tile statistics buffer here whether or not frame statistics are streamed) */
+         if (dev->info->ver < 20 || !(vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR))
+            continue;
+         buffer_size = 19 * 128;
+         break;
       default:
          assert(0);
          break;
