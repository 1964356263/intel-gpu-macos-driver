+/* AV1 has far more internal buffers than the other codecs (39-41 for decode on Xe2, 57 for Xe2 encode with HuC BRC),
+ * more than applications expect a session to have: the Vulkan Video samples (and the CTS encoder built on them) read
+ * the requirements into a fixed array of 40. The AV1 buffers are therefore handed out in a few memory bindings, each
+ * holding a group of them back to back at their own alignment. Only where a buffer lives changes: every buffer keeps
+ * its size, its alignment and its memory types, and the command emission still finds it in vid->vid_mem[type].
+ */
+static uint32_t
+av1_video_mem_group(uint32_t type)
+{
+   if (type < ANV_VID_MEM_AV1_CDF_DEFAULTS_0)
+      return 0;   /* AVP line, tile line and tile column buffers */
+   if (type <= ANV_VID_MEM_AV1_CDF_DEFAULTS_3)
+      return 1;   /* the default CDF tables, written by the CPU */
+   if (type <= ANV_VID_MEM_AV1_ENCODE_TILE_BITSTREAM_ACCUM)
+      return 2;   /* DBD, tile size and tile bitstream streamout */
+   if (type <= ANV_VID_MEM_AV1_ENCODE_PAK_TILE_STATS)
+      return 3;   /* Xe2 VDEnc row stores and VDEnc / PAK statistics */
+   return 4;      /* HuC BRC: the AV1 CDF, data and SLB buffers and the shared BRC buffers */
+}
+
+struct anv_video_mem_slot {
+   uint32_t type;          /* ANV_VID_MEM_*, index in vid_mem[] */
+   uint32_t binding;       /* index in anv_video_mem_layout::bindings[] */
+   VkDeviceSize offset;    /* from the start of the binding */
+   VkDeviceSize size;
+};
+
+struct anv_video_mem_layout {
+   uint32_t slot_count;
+   uint32_t binding_count;
+   struct anv_video_mem_slot slots[ANV_VID_MEM_BRC_MAX];
+   uint32_t group[ANV_VID_MEM_BRC_MAX];
+   VkVideoSessionMemoryRequirementsKHR bindings[ANV_VID_MEM_BRC_MAX];
+};
+
+/* Where each internal buffer of the session lives: the same answer for vkGetVideoSessionMemoryRequirementsKHR and
+ * vkBindVideoSessionMemoryKHR, as it only depends on the session's creation parameters. Codecs other than AV1 keep
+ * one binding per buffer, with the buffer's type as memoryBindIndex, exactly as before.
+ */
+static void
+get_video_session_mem_layout(struct anv_device *device,
+                             struct anv_video_session *vid,
+                             struct anv_video_mem_layout *layout)
+{
+   VkVideoSessionMemoryRequirementsKHR reqs[ANV_VID_MEM_BRC_MAX];
+   uint32_t count = ARRAY_SIZE(reqs);
+
+   for (uint32_t i = 0; i < count; i++)
+      reqs[i] = (VkVideoSessionMemoryRequirementsKHR) {
+         .sType = VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR,
+      };
+   get_video_session_buffer_reqs(device, vid, reqs, &count);
+   assert(count <= ARRAY_SIZE(reqs));
+
+   const bool grouped = vid->vk.op & (VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR |
+                                      VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR);
+
+   layout->slot_count = count;
+   layout->binding_count = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      const uint32_t type = reqs[i].memoryBindIndex;
+      const VkMemoryRequirements *req = &reqs[i].memoryRequirements;
+      const uint32_t group = grouped ? av1_video_mem_group(type) : type;
+
+      uint32_t b = 0;
+      while (b < layout->binding_count &&
+             !(grouped && layout->group[b] == group &&
+               layout->bindings[b].memoryRequirements.memoryTypeBits == req->memoryTypeBits))
+         b++;
+
+      if (b == layout->binding_count) {
+         layout->binding_count++;
+         layout->group[b] = group;
+         layout->bindings[b] = (VkVideoSessionMemoryRequirementsKHR) {
+            .sType = VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR,
+            .memoryBindIndex = grouped ? b : type,
+            .memoryRequirements = {
+               .size = 0,
+               .alignment = req->alignment,
+               .memoryTypeBits = req->memoryTypeBits,
+            },
+         };
+      }
+
+      VkMemoryRequirements *bind_req = &layout->bindings[b].memoryRequirements;
+      const VkDeviceSize offset = align64(bind_req->size, req->alignment);
+
+      bind_req->alignment = MAX2(bind_req->alignment, req->alignment);
+      bind_req->size = offset + req->size;
+      layout->slots[i] = (struct anv_video_mem_slot) {
+         .type = type,
+         .binding = b,
+         .offset = offset,
+         .size = req->size,
+      };
+   }
+}
+
+VkResult
+anv_GetVideoSessionMemoryRequirementsKHR(VkDevice _device,
+                                         VkVideoSessionKHR videoSession,
+                                         uint32_t *pVideoSessionMemoryRequirementsCount,
+                                         VkVideoSessionMemoryRequirementsKHR *mem_reqs)
+{
+   ANV_FROM_HANDLE(anv_device, device, _device);
+   ANV_FROM_HANDLE(anv_video_session, vid, videoSession);
+   VK_OUTARRAY_MAKE_TYPED(VkVideoSessionMemoryRequirementsKHR,
+                          out,
+                          mem_reqs,
+                          pVideoSessionMemoryRequirementsCount);
+   struct anv_video_mem_layout layout;
+
+   get_video_session_mem_layout(device, vid, &layout);
+
+   for (uint32_t b = 0; b < layout.binding_count; b++) {
+      vk_outarray_append_typed(VkVideoSessionMemoryRequirementsKHR, &out, p) {
+         p->memoryBindIndex = layout.bindings[b].memoryBindIndex;
+         p->memoryRequirements = layout.bindings[b].memoryRequirements;
+      }
+   }
+
+   return vk_outarray_status(&out);
 }
 
