+/* media-driver's HierarchLevelPlus1 of the picture in a dyadic B pyramid (1 = P / low-delay B, 2 = the B between
+ * the anchors, 3 and 4 the levels below), which VA-API gets from the app and Vulkan does not carry: the level of a B
+ * picture follows from the distance between its nearest past and future references, gop_ref_dist at level 2 and
+ * halved at each level below. 0 when it cannot be told (no references). */
+static uint32_t
+anv_h265_hier_level_plus1(const VkVideoEncodeInfoKHR *enc_info,
+                          StdVideoEncodeH265ReferenceListsInfo *ref_lists,
+                          uint32_t gop_ref_dist)
+{
+   const struct VkVideoEncodeH265PictureInfoKHR *frame_info = anv_h265_frame_info(enc_info);
+   const int32_t poc = frame_info->pStdPictureInfo->PicOrderCntVal;
+   int32_t past = INT32_MIN, future = INT32_MAX;
+
+   if (!ref_lists)
+      return 0;
+
+   for (unsigned list = 0; list < 2; list++) {
+      const uint8_t *ref_pic_list = list == 0 ? ref_lists->RefPicList0 : ref_lists->RefPicList1;
+      unsigned ref_cnt = (list == 0 ? ref_lists->num_ref_idx_l0_active_minus1 :
+                                      ref_lists->num_ref_idx_l1_active_minus1) + 1;
+
+      for (unsigned i = 0; i < ref_cnt; i++) {
+         if (ref_pic_list[i] == STD_VIDEO_H265_NO_REFERENCE_PICTURE)
+            continue;
+         const VkVideoReferenceSlotInfoKHR *slot = anv_h265_find_ref_slot(enc_info, ref_pic_list[i]);
+         const VkVideoEncodeH265DpbSlotInfoKHR *dpb =
+            slot ? vk_find_struct_const(slot->pNext, VIDEO_ENCODE_H265_DPB_SLOT_INFO_KHR) : NULL;
+         if (!dpb)
+            continue;
+         const int32_t rpoc = dpb->pStdReferenceInfo->PicOrderCntVal;
+         if (rpoc < poc && rpoc > past)
+            past = rpoc;
+         if (rpoc > poc && rpoc < future)
+            future = rpoc;
+      }
+   }
+
+   if (past == INT32_MIN)
+      return 0;
+   if (future == INT32_MAX)
+      return 1;   /* only past references: P or low-delay B */
+
+   const uint32_t span = (uint32_t)(future - past);
+   uint32_t level = 2;
+   for (uint32_t d = gop_ref_dist; d > span && d > 1 && level < 4; d /= 2)
+      level++;
+   return level;
+}
