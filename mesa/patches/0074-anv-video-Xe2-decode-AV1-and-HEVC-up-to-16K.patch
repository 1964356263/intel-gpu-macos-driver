       ext->maxLevel = STD_VIDEO_AV1_LEVEL_6_0;
 
+      /* media-driver decodes AV1 up to 16Kx16K on Xe2 (capstable_data_av1_decode_xe2_hpm_r0_specific.h:
+       * CODEC_16K_MAX_PIC_WIDTH/HEIGHT). The frame-size dependent AVP buffers follow the session's max coded
+       * extent (get_av1_sb_size), the line buffers the tile width, which AV1 caps at 4096.
+       */
+      if (pdevice->info.verx10 >= 200) {
+         pCapabilities->maxCodedExtent.width = 16384;
+         pCapabilities->maxCodedExtent.height = 16384;
+      }
+
       pCapabilities->maxDpbSlots = ANV_VIDEO_AV1_MAX_DPB_SLOTS;
       pCapabilities->maxActiveReferencePictures = STD_VIDEO_AV1_NUM_REF_FRAMES;
 
@@ -404,6 +413,15 @@ anv_GetPhysicalDeviceVideoCapabilitiesKHR(VkPhysicalDevice physicalDevice,
 
       ext->maxLevelIdc = STD_VIDEO_H265_LEVEL_IDC_6_2;
 
+      /* media-driver decodes HEVC up to 16Kx16K on Xe2 (capstable_data_hevc_decode_xe2_hpm_r0_specific.h:
+       * CODEC_16K_MAX_PIC_WIDTH/HEIGHT); the HCP session buffers are sized from the session's max coded extent.
+       * H.264 stays at 4096 (CODEC_4K_MAX_PIC_WIDTH there too).
+       */
+      if (pdevice->info.verx10 >= 200) {
+         pCapabilities->maxCodedExtent.width = 16384;
+         pCapabilities->maxCodedExtent.height = 16384;
+      }
+
       strcpy(pCapabilities->stdHeaderVersion.extensionName, VK_STD_VULKAN_VIDEO_CODEC_H265_DECODE_EXTENSION_NAME);
       pCapabilities->stdHeaderVersion.specVersion = VK_STD_VULKAN_VIDEO_CODEC_H265_DECODE_SPEC_VERSION;
       break;
@@ -1139,11 +1157,16 @@ static const uint8_t av1_buffer_size_ext[ANV_VID_MEM_AV1_MAX][4] = {
 const uint32_t av1_mi_size_log2         = 2;
 const uint32_t av1_max_mib_size_log2    = 5;
 
+/* The frame in the units the AVP frame-size buffers are counted in, for a frame of w x h: the tile line and tile
