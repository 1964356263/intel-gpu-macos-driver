+/* The host copy of a push set's descriptor data, grown to `size` (keeping
+ * its contents: a push with the same layout keeps the previous descriptors).
+ */
+static bool
+anv_push_descriptor_shadow_grow(struct anv_push_descriptor_set *push_set,
+                                void **shadow, uint32_t *shadow_size,
+                                uint32_t size)
+{
+   if (*shadow_size >= size)
+      return true;
+   void *grown = vk_zalloc(push_set->shadow_alloc, size, 64,
+                           VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (grown == NULL)
+      return false;
+   if (*shadow) {
+      memcpy(grown, *shadow, *shadow_size);
+      vk_free(push_set->shadow_alloc, *shadow);
+   }
+   *shadow = grown;
+   *shadow_size = size;
+   return true;
+}
+
+/* After a push's descriptor writes: stream the host copies into the GPU
+ * memory the set points at (write-only, so write-combined memory is fine).
+ */
+void
+anv_push_descriptor_set_upload(struct anv_push_descriptor_set *push_set)
+{
+   if (!push_set->host_shadow)
+      return;
+   if (push_set->surface_gpu.map && push_set->surface_shadow) {
+      memcpy(push_set->surface_gpu.map, push_set->surface_shadow,
+             MIN2(push_set->surface_gpu.alloc_size,
+                  push_set->surface_shadow_size));
+   }
+   if (push_set->sampler_gpu.map && push_set->sampler_shadow) {
+      memcpy(push_set->sampler_gpu.map, push_set->sampler_shadow,
+             MIN2(push_set->sampler_gpu.alloc_size,
+                  push_set->sampler_shadow_size));
+   }
 }
 
