+uint64_t
+wsi_metal_display_refresh_ns(void)
+{
+   uint64_t ns = 1000000000ull / 60;
+   CVDisplayLinkRef link;
+   if (CVDisplayLinkCreateWithActiveCGDisplays(&link) == kCVReturnSuccess) {
+      CVDisplayLinkSetCurrentCGDisplay(link, CGMainDisplayID());
+      const CVTime t = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link);
+      if (!(t.flags & kCVTimeIsIndefinite) && t.timeValue > 0 && t.timeScale > 0)
+         ns = (uint64_t)((double)t.timeValue * 1e9 / (double)t.timeScale);
+      CVDisplayLinkRelease(link);
+   }
+   return ns;
+}
