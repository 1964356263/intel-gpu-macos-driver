+#if GFX_VERx10 >= 125
       buf.ds_bwd_ref =
             anv_image_ds_4x_address(l1_iv, l1_slot->pPictureResource->baseArrayLayer);
 #endif
    }
 
-#if GFX_VERx10 == 125
+#if GFX_VERx10 >= 125
    if (enc_info->pSetupReferenceSlot)
       buf.col_mv_avc_write =
          anv_image_dmv_top_address(base_ref_iv, base_ref_array_layer);
@@ -1198,6 +1198,40 @@ anv_h264_emit_vdenc_avc_img_state(struct anv_cmd_buffer *cmd,
     * TODO: the rest, intra-refresh / A-stepping / Wa_18011246551 / stream-in
     * are all 0 for now.
     */
+   uint32_t level = vk_video_get_h264_level(sps->level_idc);
+
+#if GFX_VER >= 20
+   /* Xe2: VDENC_AVC_IMG_STATE is 26 dwords and takes the Xe2_HPM settings
+    * (media-driver EncodeAvcVdencConstSettingsXe2_Hpm). Target usage 4, no
+    * slice level rate control, rolling intra refresh or low delay mode, and
+    * Wa_18011246551 is not set on Xe2.
+    */
+   const unsigned type = !is_inter ? 0 : !is_bframe ? 1 : 2;
+   const unsigned tu = 4;
+   const bool ref_pic = enc_info->pSetupReferenceSlot != NULL;
+
+   uint32_t *dw = anv_batch_emitn(batch, GENX(VDENC_AVC_IMG_STATE_length),
+                                  GENX(VDENC_AVC_IMG_STATE));
+   GENX(VDENC_AVC_IMG_STATE_pack)(batch, dw, &img);
+   dw[1] |= h264_vdenc_avc_img_state_xe2_dw1;
+   dw[2] |= h264_vdenc_avc_img_state_xe2_dw2[type][tu][ref_pic][0];
+   dw[4] |= h264_vdenc_avc_img_state_xe2_dw4[type][tu][0][0];
+   dw[5] |= h264_vdenc_avc_img_state_xe2_dw5[type][tu];
+   dw[7] |= h264_vdenc_avc_img_state_xe2_dw7;
+   dw[8] |= level <= 52 ? h264_vdenc_avc_img_state_xe2_dw8[level] : 0x02002000;
+   dw[10] |= h264_vdenc_avc_img_state_xe2_dw10[type];
+   dw[11] |= h264_vdenc_avc_img_state_xe2_dw11[type];
+   dw[12] |= h264_vdenc_avc_img_state_xe2_dw12[type][tu];
+   dw[13] |= h264_vdenc_avc_img_state_xe2_dw13[type][tu][0];
+   dw[14] |= h264_vdenc_avc_img_state_xe2_dw14[type][tu];
+   dw[15] |= h264_vdenc_avc_img_state_xe2_dw15;
+   dw[16] |= h264_vdenc_avc_img_state_xe2_dw16;
+   dw[17] |= h264_vdenc_avc_img_state_xe2_dw17;
+   dw[18] |= h264_vdenc_avc_img_state_xe2_dw18;
+   dw[19] |= h264_vdenc_avc_img_state_xe2_dw19;
+   dw[22] |= h264_vdenc_avc_img_state_xe2_dw22;
+   dw[25] |= h264_vdenc_avc_img_state_xe2_dw25[tu];
+#else
    uint8_t img_type = !is_inter ? 0 : !is_bframe ? 1 :
                       (enc_info->pSetupReferenceSlot ? 3 : 2);
    const uint32_t *cost = h264_vdenc_avc_img_state[4 - 1][img_type][0][0][0][0];
@@ -1207,9 +1241,9 @@ anv_h264_emit_vdenc_avc_img_state(struct anv_cmd_buffer *cmd,
    for (unsigned i = 0; i < 19; i++)
       dw[i + 1] |= cost[i];
 
-   uint32_t level = vk_video_get_h264_level(sps->level_idc);
    dw[8] = (dw[8] & 0xffff) |
            (level <= 52 ? h264_vdenc_avc_img_state_dw8[level] : 0x02000000);
+#endif
 }
 #endif
 
