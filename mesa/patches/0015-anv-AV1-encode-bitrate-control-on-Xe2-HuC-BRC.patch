+   uint32_t obu_size_byte_offset;
+   uint32_t qindex_bit_offset;
+   uint32_t segmentation_bit_offset;
+   uint32_t loop_filter_bit_offset;
+   uint32_t cdef_bit_offset;
+   uint32_t cdef_size_in_bits;
+   uint32_t size_in_bits;
+};
