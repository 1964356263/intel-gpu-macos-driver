+/* Byte layout of the input SLBB (media-driver Av1BrcUpdatePkt::ConstructBatchBufferHuCBRC, one tile, no
+ * segmentation, no palette). */
+struct anv_av1_brc_slb_layout {
+   uint16_t segment_offset;
+   uint16_t inloop_filter_offset;
+   uint16_t cmd1_offset;
+   uint16_t cmd2_offset;
+   uint16_t pic_state_offset;
+   uint16_t size;
+};
+
+static inline struct anv_av1_brc_slb_layout
+anv_av1_brc_slb_layout(void)
+{
+   struct anv_av1_brc_slb_layout l;
+
+   l.segment_offset = 0;
+   l.inloop_filter_offset = l.segment_offset + 4 * GENX(AVP_SEGMENT_STATE_length);
+   l.cmd1_offset = l.inloop_filter_offset + 4 * GENX(AVP_INLOOP_FILTER_STATE_length) + 4;
+   l.cmd2_offset = l.cmd1_offset + 4 * GENX(VDENC_CMD1_length) + 4;
+   l.pic_state_offset = l.cmd2_offset + 4 * GENX(VDENC_CMD2_length) + 4;
+   /* Av1BrcUpdatePkt::AddAvpPicStateBaseOnTile pads the batch to a cache line with MI_NOOPs */
+   l.size = align(l.pic_state_offset + 4 * GENX(AVP_PIC_STATE_length) + 4, 64);
+   return l;
+}
+
+/* Per-frame BRC state the AV1 encode records against. */
+struct anv_av1_brc_frame {
+   bool enabled;
+   struct anv_av1_brc_slb_layout layout;
+   struct anv_state slb_in;
+   struct anv_state pak_insert_in;
+   struct anv_state update_dmem;
+   struct anv_state const_data;
+   struct vk_video_av1_frame_hdr_layout hdr;
+   uint32_t pak_insert_size;
+};
+
+/* Points cmd->batch at the SLBB input at @offset so the regular command emission lands there, like
+ * anv_video_begin_sub_batch(). */
+static void
+anv_av1_brc_slb_begin(struct anv_cmd_buffer *cmd, struct anv_batch *parent,
+                      struct anv_state state, uint32_t offset)
+{
+   *parent = cmd->batch;
+   anv_batch_set_storage(&cmd->batch,
+                         anv_address_add(anv_cmd_buffer_temporary_state_address(cmd, state), offset),
+                         (uint8_t *)state.map + offset, state.alloc_size - offset);
+   cmd->batch.extend_cb = NULL;
+   cmd->batch.user_data = NULL;
+}
+
+/* Ends the group with MI_BATCH_BUFFER_END, returns to the main batch and jumps into the HuC output copy of
+ * the group at @exec_addr. */
+static void
+anv_av1_brc_slb_end(struct anv_cmd_buffer *cmd, struct anv_batch *parent,
+                    uint32_t expected_size, struct anv_address exec_addr)
+{
+   anv_batch_emit(&cmd->batch, GENX(MI_BATCH_BUFFER_END), bbe) { }
+
+   ASSERTED uint32_t size = cmd->batch.next - cmd->batch.start;
+   VkResult status = cmd->batch.status;
+
+   assert(status != VK_SUCCESS || size == expected_size);
+
+   cmd->batch = *parent;
+   if (status != VK_SUCCESS) {
+      anv_batch_set_error(&cmd->batch, status);
+      return;
+   }
+
+   anv_batch_emit(&cmd->batch, GENX(MI_BATCH_BUFFER_START), bbs) {
+      bbs.SecondLevelBatchBuffer = Secondlevelbatch;
+      bbs.AddressSpaceIndicator = ASI_PPGTT;
+      bbs.BatchBufferStartAddress = exec_addr;
+   }
+}
+
+static struct anv_address
+anv_av1_brc_slb_out_addr(struct anv_video_session *vid, uint32_t offset)
+{
+   return anv_address_add(anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_SLB_OUT), offset);
+}
+
+struct anv_av1_brc_rates {
+   uint32_t target_bps;
+   uint32_t max_bps;
+   uint32_t min_bps;
+   uint32_t fps_num;
+   uint32_t fps_den;
+   uint32_t vbv_size;
+   uint32_t vbv_init;
+   double input_bits_per_frame;
+   uint32_t gop_pic_size;
+};
+
+/* Av1Brc::SetSequenceStructs and the rate fields of SetDmemForInit, from the Vulkan rate control state. */
+static struct anv_av1_brc_rates
+anv_av1_brc_rates(const struct anv_video_session *vid)
+{
+   const struct anv_video_rc_state *rc = &vid->rc;
+   struct anv_av1_brc_rates r;
+
+   r.target_bps = MIN2(rc->average_bitrate, UINT32_MAX);
+   r.max_bps = vid->rc_mode == VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR ?
+               r.target_bps : MIN2(MAX2(rc->max_bitrate, rc->average_bitrate), UINT32_MAX);
+   r.min_bps = vid->rc_mode == VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR ? r.target_bps : 0;
+   r.fps_num = rc->frame_rate_num && rc->frame_rate_den ? rc->frame_rate_num : 30;
+   r.fps_den = rc->frame_rate_num && rc->frame_rate_den ? rc->frame_rate_den : 1;
+
+   /* average frame size in bits, from the peak rate (media-driver m_inputbitsperframe) */
+   r.input_bits_per_frame = (double)r.max_bps * r.fps_den / r.fps_num;
+
+   /* the buffer holds at least 4 average frames, the initial fullness at least 2 */
+   r.vbv_size = MAX2(rc->vbv_size_bits, (uint32_t)(r.input_bits_per_frame * 4));
+   r.vbv_init = rc->vbv_initial_fullness_bits ? rc->vbv_initial_fullness_bits : 7 * r.vbv_size / 8;
+   r.vbv_init = MAX2(r.vbv_init, (uint32_t)(r.input_bits_per_frame * 2));
+   r.vbv_init = MIN2(r.vbv_init, r.vbv_size);
+
+   r.gop_pic_size = rc->gop_frame_count ? rc->gop_frame_count :
+                    rc->idr_period ? rc->idr_period : 0;
+   return r;
+}
+
+/* media-driver ComputeVDEncInitQPI */
+static int32_t
+anv_av1_brc_init_qpi(uint32_t width, uint32_t height, uint32_t fps_num, uint32_t fps_den,
+                     uint32_t target_kbps, bool is_10bit, uint16_t n_p)
+{
+   uint32_t frame_size = (width * height * 3) >> 1;
+   if (is_10bit)
+      frame_size = (frame_size * 10) >> 3;
+
+   const float x0 = 0, y0 = 1.19f, x1 = 1.75f, y1 = 1.75f;
+   int32_t qp_p = (int32_t)(1. / 1.2 * pow(10.0, (log10(frame_size * 2. / 3. * ((float)fps_num) /
+                                                       ((float)target_kbps * 1000 * fps_den)) - x0) *
+                                                 (y1 - y0) / (x1 - x0) + y0) + 0.5);
+   qp_p = (int32_t)((float)qp_p * 5.0);
+   qp_p -= 20;
+   qp_p = CLAMP(qp_p, 1, 200);
+
+   int32_t qp_i = qp_p > 4 ? qp_p - 4 : qp_p;
+   int16_t qi_boost = n_p / 30 - 1;
+   qi_boost = CLAMP(qi_boost, 10, 20);
+   qp_i -= qi_boost;
+   return CLAMP(qp_i, 1, 200);
+}
+
+/* Av1Brc::SetDmemForInit */
+static void
+anv_av1_brc_fill_init_dmem(struct anv_video_session *vid, uint32_t width, uint32_t height, bool is_10bit,
+                           struct anv_huc_av1_brc_init_dmem *dmem)
+{
+   const struct anv_av1_brc_rates r = anv_av1_brc_rates(vid);
+
+   memset(dmem, 0, sizeof(*dmem));
+   dmem->BRCFunc = 0;
+   dmem->INIT_ProfileLevelMaxFrame = width * height;
+   dmem->INIT_TargetBitrate = r.target_bps;
+   dmem->INIT_MaxRate = r.max_bps;
+   dmem->INIT_MinRate = r.min_bps;
+   dmem->INIT_FrameRateM = r.fps_num;
+   dmem->INIT_FrameRateD = r.fps_den;
+   dmem->INIT_InitBufFullness = r.vbv_init;
+   dmem->INIT_BufSize = r.vbv_size;
+   dmem->INIT_BRCFlag = vid->rc_mode == VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR ?
+                        ANV_AV1_BRC_FLAG_CBR : ANV_AV1_BRC_FLAG_VBR;
+
+   /* media-driver splits a hierarchical B GOP into P/B/B1/B2 levels from the picture's HierarchLevelPlus1. Vulkan
+    * has no per-picture level (ffmpeg also signals REFERENCE_PATTERN_FLAT), so the GOP is one level of inter frames,
+    * like media-driver's GopRefDist 1 layout. */
+   int32_t intra_period = (int32_t)r.gop_pic_size - 1;
+   dmem->INIT_GopP = intra_period > 0 ? intra_period : 9999;
+   dmem->INIT_GopB = 0;
+
+   dmem->INIT_FrameWidth = width;
+   dmem->INIT_FrameHeight = height;
+   dmem->INIT_MinQP = vid->rc.min_qp ? vid->rc.min_qp : 1;
+   dmem->INIT_MaxQP = vid->rc.max_qp ? vid->rc.max_qp : 255;
+   dmem->INIT_LevelQP = 0;
+   dmem->INIT_GoldenFrameInterval = 14;
+   dmem->INIT_EnableScaling = false;
+   dmem->INIT_OvershootCBR_pct = 0;
+
+   memcpy(dmem->INIT_InstRateThreshI0, anv_av1_brc_instRateThresholdI, sizeof(dmem->INIT_InstRateThreshI0));
+   memcpy(dmem->INIT_InstRateThreshP0, anv_av1_brc_instRateThresholdP, sizeof(dmem->INIT_InstRateThreshP0));
+
+   double input_bits_per_frame = (double)dmem->INIT_MaxRate * dmem->INIT_FrameRateD / dmem->INIT_FrameRateM;
+   double bps_ratio = input_bits_per_frame / ((double)dmem->INIT_BufSize / ANV_AV1_BRC_DEV_STD_FPS);
+   bps_ratio = CLAMP(bps_ratio, ANV_AV1_BRC_BPS_RATIO_LOW, ANV_AV1_BRC_BPS_RATIO_HIGH);
+
+   for (uint32_t i = 0; i < ANV_AV1_BRC_NUM_DEV_THRESHOLDS / 2; i++) {
+      dmem->INIT_DevThreshPB0[i] =
+         (int8_t)(ANV_AV1_BRC_NEG_MULT_PB * pow(anv_av1_brc_devThresholdFpNegPB[i], bps_ratio));
+      dmem->INIT_DevThreshPB0[i + ANV_AV1_BRC_NUM_DEV_THRESHOLDS / 2] =
+         (int8_t)(ANV_AV1_BRC_POS_MULT_PB * pow(anv_av1_brc_devThresholdFpPosPB[i], bps_ratio));
+
+      dmem->INIT_DevThreshI0[i] =
+         (int8_t)(ANV_AV1_BRC_NEG_MULT_PB * pow(anv_av1_brc_devThresholdFpNegI[i], bps_ratio));
+      dmem->INIT_DevThreshI0[i + ANV_AV1_BRC_NUM_DEV_THRESHOLDS / 2] =
+         (int8_t)(ANV_AV1_BRC_POS_MULT_PB * pow(anv_av1_brc_devThresholdFpPosI[i], bps_ratio));
+
+      dmem->INIT_DevThreshVBR0[i] =
+         (int8_t)(ANV_AV1_BRC_NEG_MULT_VBR * pow(anv_av1_brc_devThresholdVbrNeg[i], bps_ratio));
+      dmem->INIT_DevThreshVBR0[i + ANV_AV1_BRC_NUM_DEV_THRESHOLDS / 2] =
+         (int8_t)(ANV_AV1_BRC_POS_MULT_VBR * pow(anv_av1_brc_devThresholdVbrPos[i], bps_ratio));
+   }
+
+   int32_t qp_i = anv_av1_brc_init_qpi(width, height, r.fps_num, r.fps_den,
+                                       DIV_ROUND_UP(r.target_bps, 1000), is_10bit, dmem->INIT_GopP);
+   dmem->INIT_InitQPI = qp_i;
+   dmem->INIT_InitQPP = qp_i + 20;
+
+   dmem->INIT_SegMapGenerating = false;
+   dmem->INIT_Total_Level = 1;
+   dmem->INIT_SLIDINGWINDOW_ENABLE = 0;
+   dmem->INIT_SLIDINGWINDOW_SIZE = 0;
+   dmem->INIT_GopPicSize = r.gop_pic_size;
+}
+
+/* Av1Brc::SetDmemForUpdate, one PAK pass */
+static void
+anv_av1_brc_fill_update_dmem(struct anv_video_session *vid,
+                             const StdVideoEncodeAV1PictureInfo *pic_info,
+                             bool is_intra, bool disable_cdf_update,
+                             uint32_t width, uint32_t height,
+                             const struct anv_av1_brc_frame *brc,
+                             struct anv_huc_av1_brc_update_dmem *dmem)
+{
+   const struct anv_av1_brc_rates r = anv_av1_brc_rates(vid);
+   const uint32_t frame_num = vid->rc.frame_counter;
+
+   memset(dmem, 0, sizeof(*dmem));
+   dmem->UPD_MaxNumPAKs = 1;
+   dmem->UPD_PAKPassNum = 0;
+   dmem->UPD_SegMapGenerating = 0;
+
+   /* m_curTargetFullness: starts at the initial fullness and grows by one frame budget per frame, wrapping
+    * (with the overflow flag) when it passes the buffer size. Derived from the frame count so re-recorded
+    * command buffers program the same value. */
+   uint64_t raw = (uint64_t)r.vbv_init + (uint64_t)(frame_num * r.input_bits_per_frame);
+   uint64_t wraps = raw > r.vbv_size ? (raw - 1) / r.vbv_size : 0;
+   uint64_t prev_raw = frame_num ? (uint64_t)r.vbv_init + (uint64_t)((frame_num - 1) * r.input_bits_per_frame) : 0;
+   uint64_t prev_wraps = frame_num && prev_raw > r.vbv_size ? (prev_raw - 1) / r.vbv_size : 0;
+   dmem->UPD_OverflowFlag = wraps > prev_wraps;
+   dmem->UPD_TARGET_BUF_FULLNESS = (int32_t)(raw - wraps * r.vbv_size);
+
+   dmem->UPD_CDF_BufferSize = ANV_AV1_BRC_CDF_TABLE_SIZE;
+   dmem->UPD_FRAMENUM = frame_num;
+   dmem->UPD_HRD_BUFF_FULLNESS = r.vbv_init;
+   dmem->UPD_HRD_BUFF_FULLNESS_LOWER = 0;
+   dmem->UPD_HRD_BUFF_FULLNESS_UPPER = 0;
+   dmem->UPD_UserMaxFrame = width * height;
+   dmem->UPD_UserMaxFramePB = width * height;
+   dmem->UPD_CurWidth = width;
+   dmem->UPD_CurHeight = height;
+   dmem->UPD_Asyn = 0;
+   /* media-driver turns adaptive rounding on for BRC: the kernel programs the VDENC_CMD2 rounding */
+   dmem->UPD_EnableAdaptiveRounding = 1;
+   dmem->UPD_AdaptiveTUEnabled = 0;
+   dmem->UPD_EnableAdaptiveChromaDeltaQP = 0;
