+/* Av1Brc::SetConstForUpdate */
+static void
+anv_av1_brc_fill_const_data(bool is_intra, struct anv_huc_av1_brc_const_data *c)
+{
+   memset(c, 0, sizeof(*c));
+   memcpy(c->CONST_QPAdjTabI, anv_av1_brc_av1DeltaQpI, sizeof(c->CONST_QPAdjTabI));
+   memcpy(c->CONST_QPAdjTabP, anv_av1_brc_av1DeltaQpP, sizeof(c->CONST_QPAdjTabP));
+   memcpy(c->CONST_QPAdjTabB, anv_av1_brc_av1DeltaQpP, sizeof(c->CONST_QPAdjTabB));
+   memcpy(c->CONST_DistQPAdjTabI, anv_av1_brc_av1DistortionsDeltaQpI, sizeof(c->CONST_DistQPAdjTabI));
+   memcpy(c->CONST_DistQPAdjTabP, anv_av1_brc_av1DistortionsDeltaQpP, sizeof(c->CONST_DistQPAdjTabP));
+   memcpy(c->CONST_DistQPAdjTabB, anv_av1_brc_av1DistortionsDeltaQpP, sizeof(c->CONST_DistQPAdjTabB));
+   memcpy(c->CONST_LoopFilterLevelTabLuma, anv_av1_brc_loopFilterLevelTabLuma,
+          sizeof(c->CONST_LoopFilterLevelTabLuma));
+   memcpy(c->CONST_LoopFilterLevelTabChroma, anv_av1_brc_loopFilterLevelTabChroma,
+          sizeof(c->CONST_LoopFilterLevelTabChroma));
+   memcpy(c->CONST_ModeCosts, is_intra ? anv_av1_brc_hucModeCostsIFrame : anv_av1_brc_hucModeCostsPFrame,
+          sizeof(c->CONST_ModeCosts));
+}
+
+static void
+anv_av1_brc_emit_huc_common(struct anv_cmd_buffer *cmd, uint32_t kernel_descriptor,
+                            struct anv_state dmem_state, uint32_t dmem_size)
+{
+   struct anv_address dmem_addr = anv_cmd_buffer_temporary_state_address(cmd, dmem_state);
+
+   anv_batch_emit(&cmd->batch, GENX(HUC_IMEM_STATE), imem) {
+      imem.HUCFirmwareDescriptor = kernel_descriptor;
+   }
+
+   anv_video_emit_mfx_wait(cmd, NULL);
+   anv_batch_emit(&cmd->batch, GENX(HUC_PIPE_MODE_SELECT), sel);
+   anv_video_emit_mfx_wait(cmd, NULL);
+
+   anv_batch_emit(&cmd->batch, GENX(HUC_DMEM_STATE), dmem) {
+      dmem.HUCDataSourceAddress = dmem_addr;
+      dmem.HUCDataSourceAddressAttributes = (struct GENX(MEMORYADDRESSATTRIBUTES)) {
+         .MOCS = anv_mocs(cmd->device, dmem_addr.bo, 0),
+      };
+      dmem.HUCDataDestinationAddress = (struct anv_address) { NULL, ANV_HUC_DMEM_DEST_OFFSET };
+      dmem.HUCDataLength = align(dmem_size, 64) / 64;
+   }
+}
+
+static void
+anv_av1_brc_emit_huc_regions(struct anv_cmd_buffer *cmd, const struct anv_address regions[16])
+{
+   anv_batch_emit(&cmd->batch, GENX(HUC_VIRTUAL_ADDR_STATE), va) {
+      for (uint32_t i = 0; i < 16; i++) {
+         va.HUCVirtualAddressRegion[i] = (struct GENX(HUC_VIRTUAL_ADDR_REGION)) {
+            .Address = regions[i],
+            .AddressAttributes = {
+               .MOCS = anv_mocs(cmd->device, regions[i].bo, 0),
+            },
+         };
+      }
+   }
+}
+
+/* HUC_START and the media-driver EncodeHucPkt tail: VD_PIPELINE_FLUSH for AV1, then the HUC_STATUS
+ * (bit 31: re-encode requested) into the PAK MMIO semaphore buffer. */
+static void
+anv_av1_brc_emit_huc_tail(struct anv_cmd_buffer *cmd)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+   struct anv_address pak_mmio_addr = anv_brc_mem_addr(vid, ANV_VID_MEM_BRC_PAK_MMIO_SEM);
+
+   anv_batch_emit(&cmd->batch, GENX(HUC_START), start) {
+      start.LastStreamObject = true;
+   }
+
+   anv_batch_emit(&cmd->batch, GENX(VD_PIPELINE_FLUSH), flush) {
+      flush.AVPPipelineDone = true;
+      flush.AVPPipelineCommandFlush = true;
+      flush.VDCommandMessageParserDone = true;
+   }
+
+   anv_video_emit_mi_flush_dw(cmd, true);
+
+   anv_batch_emit(&cmd->batch, GENX(MI_STORE_DATA_IMM), sdi) {
+      sdi.Address = anv_address_add(pak_mmio_addr, 4);
+      sdi.ImmediateData = ANV_HUC_AV1_BRC_REENCODE_MASK;
+   }
+
+   anv_batch_emit(&cmd->batch, GENX(MI_STORE_REGISTER_MEM), srm) {
+      srm.RegisterAddress = ANV_HUC_STATUS_MMIO_OFFSET;
+      srm.AddCSMMIOStartOffset = 1;
+      srm.MemoryAddress = pak_mmio_addr;
+   }
+}
+
+/* Av1BrcInitPkt */
+static void
+anv_av1_brc_emit_huc_init(struct anv_cmd_buffer *cmd, uint32_t width, uint32_t height, bool is_10bit)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+   const uint32_t dmem_size = sizeof(struct anv_huc_av1_brc_init_dmem);
+   struct anv_state dmem = anv_cmd_buffer_alloc_temporary_state(cmd, align(dmem_size, 64), 64);
+
+   if (dmem.map == NULL)
+      return;
+
+   anv_av1_brc_fill_init_dmem(vid, width, height, is_10bit, dmem.map);
+   anv_av1_brc_emit_huc_common(cmd, ANV_HUC_AV1_BRC_INIT_KERNEL_DESCRIPTOR, dmem, dmem_size);
+
+   struct anv_address regions[16] = { 0 };
+   regions[0] = anv_brc_mem_addr(vid, ANV_VID_MEM_BRC_HISTORY);
+   anv_av1_brc_emit_huc_regions(cmd, regions);
+   anv_av1_brc_emit_huc_tail(cmd);
+}
+
+/* Av1BrcUpdatePkt: region layout from MHW_SETPAR_DECL_SRC(HUC_VIRTUAL_ADDR_STATE, Av1BrcUpdatePkt) */
+static void
+anv_av1_brc_emit_huc_update(struct anv_cmd_buffer *cmd, const struct anv_av1_brc_frame *brc)
+{
+   struct anv_video_session *vid = cmd->video.vid;
+
+   anv_av1_brc_emit_huc_common(cmd, ANV_HUC_AV1_BRC_UPDATE_KERNEL_DESCRIPTOR, brc->update_dmem,
+                               sizeof(struct anv_huc_av1_brc_update_dmem));
+
+   struct anv_address regions[16] = { 0 };
+   regions[0] = anv_brc_mem_addr(vid, ANV_VID_MEM_BRC_HISTORY);                   /* history (in/out) */
+   regions[1] = anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_VDENC_STATS);        /* VDEnc stats of the last frame */
+   regions[3] = anv_cmd_buffer_temporary_state_address(cmd, brc->slb_in);         /* input SLBB */
+   regions[4] = anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_DATA);           /* BRC data (out) */
+   regions[5] = anv_cmd_buffer_temporary_state_address(cmd, brc->const_data);     /* constant data */
+   regions[6] = anv_av1_brc_slb_out_addr(vid, 0);                                 /* output SLBB */
+   regions[7] = anv_brc_mem_addr(vid, ANV_VID_MEM_BRC_PAK_INFO);                  /* last frame size */
+   regions[8] = anv_cmd_buffer_temporary_state_address(cmd, brc->pak_insert_in);  /* frame header in */
+   regions[9] = anv_av1_brc_slb_out_addr(vid, ANV_AV1_BRC_PAK_INSERT_OUT_OFFSET); /* frame header out */
+   regions[10] = anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_CDF_DEFAULTS);  /* default CDFs */
+   regions[11] = anv_brc_mem_addr(vid, ANV_VID_MEM_AV1_ENCODE_BRC_CDF_IN_USE);    /* CDF for this frame (out) */
+   anv_av1_brc_emit_huc_regions(cmd, regions);
+   anv_av1_brc_emit_huc_tail(cmd);
+}
