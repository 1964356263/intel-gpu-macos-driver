+/* Layout of a packed AV1 frame header OBU, for encoders whose rate control
+ * firmware patches the header in place (bit positions count from the first bit
+ * of the OBU header). */
+struct vk_video_av1_frame_hdr_layout {
+   /* in: length of the obu_size field in bytes (leb128, 2 when 0) */
+   uint32_t obu_size_bytes;
