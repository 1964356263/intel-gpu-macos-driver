+   memcpy(dmem->UPD_QPThreshold, anv_av1_brc_QPThresholds, sizeof(dmem->UPD_QPThreshold));
+   memcpy(dmem->UPD_gRateRatioThreshold, anv_av1_brc_globalRateRatioThreshold,
+          sizeof(dmem->UPD_gRateRatioThreshold));
+   memcpy(dmem->UPD_gRateRatioThresholdQP, anv_av1_brc_globalRateRatioThresholdQP,
+          sizeof(dmem->UPD_gRateRatioThresholdQP));
+   memcpy(dmem->UPD_startGAdjMult, anv_av1_brc_startGlobalAdjustMult, sizeof(dmem->UPD_startGAdjMult));
+   memcpy(dmem->UPD_startGAdjDiv, anv_av1_brc_startGlobalAdjustDiv, sizeof(dmem->UPD_startGAdjDiv));
+   memcpy(dmem->UPD_DistThreshldI, anv_av1_brc_distortionThresh, sizeof(dmem->UPD_DistThreshldI));
+   memcpy(dmem->UPD_DistThreshldP, anv_av1_brc_distortionThresh, sizeof(dmem->UPD_DistThreshldP));
+   memcpy(dmem->UPD_DistThreshldB, anv_av1_brc_distortionThreshB, sizeof(dmem->UPD_DistThreshldB));
+   memcpy(dmem->UPD_MaxFrameThreshI, anv_av1_brc_maxFrameMultI, sizeof(dmem->UPD_MaxFrameThreshI));
+   memcpy(dmem->UPD_MaxFrameThreshP, anv_av1_brc_maxFrameMultP, sizeof(dmem->UPD_MaxFrameThreshP));
+   memcpy(dmem->UPD_MaxFrameThreshB, anv_av1_brc_maxFrameMultP, sizeof(dmem->UPD_MaxFrameThreshB));
+
+   dmem->UPD_Temporal_Level = 0;
+   dmem->UPD_Lowdelay = r.vbv_init <= r.input_bits_per_frame * 2;
