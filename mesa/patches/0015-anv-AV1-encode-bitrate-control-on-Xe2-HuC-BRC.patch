+ * (packet/encode_av1_brc_{init,update}_packet.*) and the Xe2_HPM VDEnc packet
+ * that executes the HuC-written second level batches.
+ *
+ * Per frame the driver builds the input second level batch (SLBB) the HuC
+ * update kernel patches: Group1 AVP_SEGMENT_STATE + AVP_INLOOP_FILTER_STATE,
+ * Group2 VDENC_CMD1, Group3 VDENC_CMD2, Group4 AVP_PIC_STATE, each ended by
+ * MI_BATCH_BUFFER_END, and an AVP_PAK_INSERT_OBJECT with the frame header OBU
+ * whose base_q_idx the kernel back-annotates. The encode jumps into the
+ * kernel's output copies instead of emitting those commands inline.
+ *
+ * The packed frame header keeps the application's loop filter and CDEF
+ * parameters (Vulkan only lets rate control override the quantizer), so the
+ * kernel's loop filter / CDEF back-annotation is off and the header length is
+ * fixed; the tile group obu_size patch after PAK relies on that.
+ */
+
+#if GFX_VER >= 20
+
+#include "av1_brc_tables.h"
+#include "vk_video.h"
+
+#define ANV_HUC_AV1_BRC_INIT_KERNEL_DESCRIPTOR   18
+#define ANV_HUC_AV1_BRC_UPDATE_KERNEL_DESCRIPTOR 19
+#define ANV_HUC_AV1_BRC_REENCODE_MASK            (1u << 31)
+#define ANV_AV1_BRC_FLAG_CBR                     0x10
+#define ANV_AV1_BRC_FLAG_VBR                     0x20
+#define ANV_AV1_BRC_FRAME_TYPE_P_OR_LB           0
+#define ANV_AV1_BRC_FRAME_TYPE_I                 2
+/* Byte offset of the HuC frame header output in ANV_VID_MEM_AV1_ENCODE_BRC_SLB_OUT */
+#define ANV_AV1_BRC_PAK_INSERT_OUT_OFFSET        4096
+/* Stride of the default CDF tables in ANV_VID_MEM_AV1_ENCODE_BRC_CDF_DEFAULTS: av1_cdf_max_num_bytes (15104,
+ * already cache line aligned), see anv_init_av1_cdf_tables() */
+#define ANV_AV1_BRC_CDF_TABLE_SIZE               15104
+/* The kernel rewrites obu_size with a fixed 4-byte leb128 (media-driver obu_size_bytes_minus1 = 3) */
+#define ANV_AV1_BRC_OBU_SIZE_BYTES               4
+
