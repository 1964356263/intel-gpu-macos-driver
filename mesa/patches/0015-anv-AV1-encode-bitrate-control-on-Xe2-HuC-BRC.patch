    }
+
+   /* The AV1 HuC BRC update kernel picks the default table for the base_q_idx it chooses from all four, laid
+    * out back to back (media-driver m_defaultCdfBuffers), and copies it into ANV_VID_MEM_AV1_ENCODE_BRC_CDF_IN_USE. */
+   /* ANV_AV1_BRC_CDF_TABLE_SIZE in genX_huc_brc_av1.h is this stride */
+   assert(av1_cdf_max_num_bytes == 15104);
+   if ((vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR) &&
+       vid->vid_mem[ANV_VID_MEM_AV1_ENCODE_BRC_CDF_DEFAULTS].mem) {
+      const struct anv_vid_mem *m = &vid->vid_mem[ANV_VID_MEM_AV1_ENCODE_BRC_CDF_DEFAULTS];
+      VkResult result = anv_device_map_bo(cmd->device, m->mem->bo, m->offset, m->size, NULL, &ptr);
+      if (result != VK_SUCCESS) {
+         anv_batch_set_error(&cmd->batch, result);
+         return;
+      }
+      memset(ptr, 0, m->size);
+      for (unsigned i = 0; i < 4; i++)
+         init_all_av1_entry((uint16_t *)((uint8_t *)ptr + i * align(av1_cdf_max_num_bytes, 64)), i);
+      anv_device_unmap_bo(cmd->device, m->mem->bo, ptr, m->size, NULL);
+   }
+
+   /* The table in use starts as a valid default table rather than zeros. */
+   if ((vid->vk.op & VK_VIDEO_CODEC_OPERATION_ENCODE_AV1_BIT_KHR) &&
+       vid->vid_mem[ANV_VID_MEM_AV1_ENCODE_BRC_CDF_IN_USE].mem) {
+      const struct anv_vid_mem *m = &vid->vid_mem[ANV_VID_MEM_AV1_ENCODE_BRC_CDF_IN_USE];
+      VkResult result = anv_device_map_bo(cmd->device, m->mem->bo, m->offset, m->size, NULL, &ptr);
+      if (result != VK_SUCCESS) {
+         anv_batch_set_error(&cmd->batch, result);
+         return;
+      }
+      memset(ptr, 0, m->size);
+      init_all_av1_entry(ptr, 3);
+      anv_device_unmap_bo(cmd->device, m->mem->bo, ptr, m->size, NULL);
+   }
 }
 
