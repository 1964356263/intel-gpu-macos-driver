+    * Its B type is the second level of a hierarchical GOP; flat B frames typed that way get their budget from the
+    * hierarchy model (B2 B2 P at 2 Mbit/s: 3.3 Mbit/s out, as P: 2.1). */
+   dmem->UPD_CurrFrameType = is_intra ? ANV_AV1_BRC_FRAME_TYPE_I : ANV_AV1_BRC_FRAME_TYPE_P_OR_LB;
+
