--- a/src/intel/vulkan/anv_allocator.c
+++ b/src/intel/vulkan/anv_allocator.c
@@ -1843,6 +1843,33 @@ anv_device_map_bo(struct anv_device *device,
       if (placed_addr)
          return map_placed_addr_slab(device, bo, offset, size, placed_addr, map_out);
 
+#ifdef HAVE_XEMAC
+      /* xemac maps a GEM object as one IOKit mapping of the whole object
+       * (IOConnectMapMemory64, page tables set up front), and xe_gem_mmap()
+       * reaches a slab child by mapping its parent up to the child's end. Doing
+       * that for every child map, and tearing it down at every unmap, made each
+       * new batch buffer of each command buffer (slab children of the batch
+       * pool) cost an IOKit map + unmap: a third of Minecraft's render thread.
+       * Map the parent once, the first time any child needs a CPU pointer, and
+       * hand out pointers into it; anv_device_unmap_bo() leaves such pointers
+       * alone and anv_device_release_bo() takes the parent's map down with it.
+       */
+      void *pmap = p_atomic_read(&real->map);
+      if (pmap == NULL) {
+         void *m = device->kmd_backend->gem_mmap(device, real, 0, real->size, NULL);
+         if (unlikely(m == MAP_FAILED))
+            return vk_errorf(device, VK_ERROR_MEMORY_MAP_FAILED, "mmap failed: %m");
+         pmap = p_atomic_cmpxchg(&real->map, NULL, m);
+         if (pmap != NULL)
+            xemac_munmap(m, real->size);   /* another thread mapped it first */
+         else
+            pmap = m;
+      }
+      if (map_out)
+         *map_out = (char *)pmap + (bo->offset - real->offset) + offset;
+      return VK_SUCCESS;
+#endif
+
       offset += (bo->offset - real->offset);
 
       const uint64_t page_size = device->physical->page_size;
@@ -1882,6 +1909,12 @@ anv_device_unmap_bo(struct anv_device *device,
 
    struct anv_bo *real = anv_bo_get_real(bo);
    if (real != bo) {
+#ifdef HAVE_XEMAC
+      /* A pointer into the parent's mapping (anv_device_map_bo): nothing to undo. */
+      char *pmap = p_atomic_read(&real->map);
+      if (!replace && pmap && (char *)map >= pmap && (char *)map < pmap + real->size)
+         return VK_SUCCESS;
+#endif
       const uint64_t page_size = device->physical->page_size;
       uint64_t slab_offset = bo->offset - real->offset;
 
