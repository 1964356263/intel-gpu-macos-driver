<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: MIT
     ssv-watch: after a macOS update, offer to re-apply the IntelXe system-volume component (Safari WebGL).
     Runs as the logged-in user at every GUI login; the root step is ssv-watch-helper.sh through macOS's administrator prompt. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.yusufklncc.intelxe.ssv-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Library/Application Support/IntelXe/ssv-watch/ssv-watch-agent.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
