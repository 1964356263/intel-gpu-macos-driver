+static void hw_base_encode_add_anchor(FFHWBaseEncodeContext *ctx,
+                                      FFHWBaseEncodePicture *pic)
+{
+    int i;
+
+    // Pictures after an intra picture in decoding and output order must
+    // not reference pictures before it (H.265 trailing pictures).
+    if (pic->type == FF_HW_PICTURE_TYPE_IDR ||
+        pic->type == FF_HW_PICTURE_TYPE_I) {
+        for (i = 0; i < ctx->nb_anchors; i++) {
+            --ctx->anchors[i]->ref_count[0];
+            ctx->anchors[i] = NULL;
+        }
+        ctx->nb_anchors = 0;
     }
+
+    if (ctx->nb_anchors == ctx->p_refs) {
+        --ctx->anchors[0]->ref_count[0];
+        for (i = 0; i < ctx->nb_anchors - 1; i++)
+            ctx->anchors[i] = ctx->anchors[i + 1];
+        --ctx->nb_anchors;
+    }
+    ctx->anchors[ctx->nb_anchors++] = pic;
+    ++pic->ref_count[0];
 }
 
