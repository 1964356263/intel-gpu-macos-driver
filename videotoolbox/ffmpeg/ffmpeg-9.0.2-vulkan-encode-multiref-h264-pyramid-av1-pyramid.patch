+
+/* A DPB slot only has to live as long as its picture can still be used as
+ * a reference: a picture that is still kept in memory (because others point
+ * at it for DPB bookkeeping) does not need its slot once no picture that is
+ * still to be encoded references it or keeps it in its DPB, and it is not one
+ * of the pictures the next P-picture will reference.  With a B-pyramid the
+ * encoding window holds more pictures than the implementation has slots. */
+static int slot_reusable(FFHWBaseEncodeContext *base_ctx,
+                         FFHWBaseEncodePicture *old)
+{
+    if (!old->encode_complete)
+        return 0;
+
+    for (int i = 0; i < base_ctx->nb_anchors; i++)
+        if (base_ctx->anchors[i] == old)
+            return 0;
+    for (int i = 0; i < base_ctx->nb_next_prev; i++)
+        if (base_ctx->next_prev[i] == old)
+            return 0;
+
+    for (FFHWBaseEncodePicture *p = base_ctx->pic_start; p; p = p->next) {
+        if (p->encode_complete)
+            continue;
+        for (int l = 0; l < MAX_REFERENCE_LIST_NUM; l++)
+            for (int i = 0; i < p->nb_refs[l]; i++)
+                if (p->refs[l][i] == old)
+                    return 0;
+        for (int i = 0; i < p->nb_dpb_pics; i++)
+            if (p->dpb[i] == old)
+                return 0;
+    }
+
+    return 1;
 }
 
