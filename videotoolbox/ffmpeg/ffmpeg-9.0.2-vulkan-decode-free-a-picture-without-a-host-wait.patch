FFmpeg 9.0.2: vulkan_decode: free a decoded picture without a host wait

Backport of upstream FFmpeg 4e141536 ("vulkan: manage image views with AVRefStruct", Lynne, 2026-07-26:
"The biggest gain is no longer needing to spin on the CPU on a semaphore waiting for the image to become
freeable"), reduced to 9.0.2's structures: the image views ff_vk_decode_prepare_frame() makes are owned by a
refcounted holder (views_buf); ff_vk_decode_frame() makes the execution hold it for the current picture and for
every reference, so ff_vk_decode_free_frame() just drops its reference instead of vkWaitSemaphores() on the
picture's decode. The images themselves were already held by the executions (ff_vk_exec_add_dep_frame), the slice
buffer is the execution's once submitted. Pictures of the SDR (compute) path keep the old wait (views_buf NULL).

--- a/libavcodec/vulkan_decode.c
+++ b/libavcodec/vulkan_decode.c
@@ -178,6 +178,45 @@
     return avf;
 }
 
+typedef struct FFVulkanDecodeViews {
+    VkDevice                     dev;
+    const VkAllocationCallbacks *alloc;
+    PFN_vkDestroyImageView       destroy_image_view;
+    int                          nb_views;
+    VkImageView                  views[2];
+} FFVulkanDecodeViews;
+
+static void free_views(void *opaque, uint8_t *data)
+{
+    FFVulkanDecodeViews *v = (FFVulkanDecodeViews *)data;
+    for (int i = 0; i < v->nb_views; i++)
+        v->destroy_image_view(v->dev, v->views[i], v->alloc);
+    av_free(v);
+}
+
+static AVBufferRef *alloc_views(FFVulkanDecodeShared *ctx)
+{
+    AVBufferRef *buf;
+    FFVulkanDecodeViews *v = av_mallocz(sizeof(*v));
+    if (!v)
+        return NULL;
+
+    v->dev                = ctx->s.hwctx->act_dev;
+    v->alloc              = ctx->s.hwctx->alloc;
+    v->destroy_image_view = ctx->s.vkfn.DestroyImageView;
+
+    buf = av_buffer_create((uint8_t *)v, sizeof(*v), free_views, NULL, 0);
+    if (!buf)
+        av_free(v);
+    return buf;
+}
+
+static void own_view(AVBufferRef *views_buf, VkImageView view)
+{
+    FFVulkanDecodeViews *v = (FFVulkanDecodeViews *)views_buf->data;
+    v->views[v->nb_views++] = view;
+}
+
 static void init_frame(FFVulkanDecodeContext *dec, FFVulkanDecodePicture *vkpic)
 {
     FFVulkanDecodeShared *ctx = dec->shared_ctx;
@@ -210,6 +249,14 @@
